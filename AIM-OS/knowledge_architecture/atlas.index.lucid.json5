              "data_flow": "execution_state → step_context"
            },
            {
              "from": "deppRewriter",
              "to": "aclCompiler",
              "type": "provides_improved_plans",
              "data_flow": "rewritten_plans → compilation"
            }
          ],
          "externalEdges": [
            {
              "fromPort": "hhniIntegration",
              "toSystem": "hhni.hierarchicalHypergraph",
              "type": "retrieves_context",
              "data_flow": "queries → optimized_context"
            },
            {
              "fromPort": "vifIntegration",
