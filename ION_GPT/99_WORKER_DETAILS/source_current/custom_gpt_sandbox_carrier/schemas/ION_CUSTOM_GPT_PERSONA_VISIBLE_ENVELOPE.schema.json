        },
        "verdict": {
          "const": "ION_PERSONA_RESPONSE_ENVELOPE_READY"
        }
      },
      "required": [
        "schema",
        "verdict",
        "persona",
        "route",
        "dynamic_domain_signal",
        "confidence",
        "gesture",
        "inner_monologue",
        "boundaries"
