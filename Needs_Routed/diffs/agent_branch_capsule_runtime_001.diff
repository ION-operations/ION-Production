+import json
+from pathlib import Path
+
+from kernel.ion_agent_branch_capsule import (
+    BLOCKED_VERDICT,
+    BRANCH_REGISTRY_PATH,
+    READY_VERDICT,
+    SETTLEMENT_INBOX,
+    SHARED_CONTEXT_SURFACES,
