        dependencies: [
          "compliance_rules",
          "monitoring_rules",
        ],
        blast_radius: "platform",
        must_never: [
          "Monitor compliance without validation",
          "Skip compliance rules",
          "Ignore monitoring requirements",
          "Bypass compliance validation",
        ],
      },
    ],
    supporting_components: [
      {
        component_id: "policy_definitions",
