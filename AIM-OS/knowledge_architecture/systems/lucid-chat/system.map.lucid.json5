{
  systemId: "lucid-chat.advancedAIChat",
  systemName: "Lucid Chat Advanced AI System",
  version: "v0.9.2",
  status: "production",
  layer: 6,
  description: "Advanced AI chat system integrating consciousness substrate capabilities with multi-path reasoning, autonomous research, multi-agent collaboration, and complete AIM-OS integration",
  purpose: "Enables sophisticated AI chat beyond simple Q&A by orchestrating 8 APOE roles, performing multi-source search, enabling branch reasoning, and coordinating specialized AI agents with full consciousness substrate integration",
  dependencies: ["cmc.contextMemoryCore", "hhni.hierarchicalHypergraph", "vif.verifiableIntelligence", "seg.sharedEvidenceGraph", "apoe.aiPoweredOrchestration"],
  internalNodes: [
    {
      id: "advancedLLMService",
      kind: "core.component",
      responsibility: "Advanced LLM service with thinking modes, prompt building, and output configuration",
      status: "production",
      must_never: [
        "Expose API keys",
        "Allow unauthorized access",
        "Skip input validation",
        "Return unvalidated output",
      ],
      perf_budget_ms: 30000,
      security_level: "critical",
    },
    {
      id: "llmService",
      kind: "core.component",
      responsibility: "Basic LLM service providing multi-provider chat completion",
      status: "production",
      must_never: [
        "Expose API keys",
        "Allow unauthorized access",
        "Skip rate limiting",
      ],
      perf_budget_ms: 5000,
      security_level: "critical",
    },
    {
      id: "workflowExecutor",
      kind: "orchestration.component",
      responsibility: "APOE workflow execution with DAG parallel processing",
      status: "production",
      must_never: [
        "Skip dependency validation",
        "Allow circular dependencies",
        "Exceed budget without warning",
        "Bypass quality gates",
      ],
      perf_budget_ms: 60000,
      security_level: "high",
    },
    {
      id: "roleDispatcher",
      kind: "orchestration.component",
      responsibility: "Dispatches tasks to 8 APOE role executors (Planner, Retriever, Reasoner, Verifier, Builder, Critic, Operator, Witness)",
      status: "production",
      must_never: [
        "Dispatch to wrong role",
        "Skip role validation",
        "Allow unauthorized role execution",
      ],
      perf_budget_ms: 1000,
      security_level: "high",
    },
    {
      id: "dagExecutor",
      kind: "orchestration.component",
      responsibility: "DAG parallel execution using Kahn's algorithm for topological sort",
      status: "production",
      must_never: [
        "Allow cycles in DAG",
        "Execute before dependencies ready",
        "Skip cycle detection",
      ],
      perf_budget_ms: 100,
      security_level: "medium",
    },
    {
      id: "budgetTracker",
      kind: "orchestration.component",
      responsibility: "Tracks and enforces budget limits (tokens, time, cost) using TokenCounter and CostCalculator",
      status: "production",
      must_never: [
        "Allow unlimited budget",
        "Skip budget validation",
        "Exceed budget without warning",
      ],
      perf_budget_ms: 10,
      security_level: "medium",
    },
    {
      id: "qualityGates",
      kind: "orchestration.component",
      responsibility: "Enforces quality gates (κ-gating, VIF validation, SEG consistency)",
      status: "production",
      must_never: [
        "Skip quality validation",
        "Allow low-quality output",
        "Bypass gate thresholds",
      ],
      perf_budget_ms: 50,
      security_level: "critical",
    },
    {
      id: "searchOrchestrator",
      kind: "search.component",
      responsibility: "Orchestrates multi-provider search (DEEPSEARCH, ICIP, Perplexity, Tavily, Web) with parallel execution",
      status: "production",
      must_never: [
        "Expose API keys",
        "Skip result validation",
        "Allow unauthorized search",
      ],
      perf_budget_ms: 5000,
      security_level: "high",
    },
    {
      id: "deepSearchService",
      kind: "search.component",
      responsibility: "DEEPSEARCH sovereign intelligence with trust scoring, entropy calculation, web crawling, and persistent indexing",
      status: "production",
      must_never: [
        "Crawl unauthorized domains",
        "Skip robots.txt",
        "Exceed rate limits",
      ],
      perf_budget_ms: 10000,
      security_level: "high",
    },
    {
      id: "icipSearchService",
      kind: "search.component",
      responsibility: "ICIP 3-tier semantic code search (literal, structural, semantic) with embeddings and FAISS indexing",
      status: "production",
      must_never: [
        "Expose code without authorization",
        "Skip semantic validation",
        "Allow injection attacks",
      ],
      perf_budget_ms: 2000,
      security_level: "high",
    },
    {
      id: "branchReasoningService",
      kind: "reasoning.component",
      responsibility: "Multi-path branch reasoning generating 3 hypotheses, parallel execution, comparative evaluation, and best solution selection",
      status: "production",
      must_never: [
        "Skip hypothesis validation",
        "Allow infinite recursion",
        "Return unvalidated solutions",
      ],
      perf_budget_ms: 30000,
      security_level: "medium",
    },
    {
      id: "ardService",
      kind: "research.component",
      responsibility: "Autonomous Research Dream with multi-source gathering, LLM parsing, finding analysis, improvement generation, and recursive research",
      status: "production",
      must_never: [
        "Skip research validation",
        "Allow infinite recursion",
        "Return unvalidated findings",
      ],
      perf_budget_ms: 120000,
      security_level: "medium",
    },
    {
      id: "multiAgentOrchestrator",
      kind: "agent.component",
      responsibility: "Coordinates 4 specialized agents (Research, Testing, Review, Documentation) with parallel, sequential, pipeline, and voting strategies",
      status: "production",
      must_never: [
        "Allow agent conflicts",
        "Skip agent validation",
        "Expose agent internals",
      ],
      perf_budget_ms: 60000,
      security_level: "high",
    },
    {
      id: "agentRegistry",
      kind: "agent.component",
      responsibility: "Agent registry with capability-based routing and agent lifecycle management",
      status: "production",
      must_never: [
        "Allow duplicate agent IDs",
        "Skip capability validation",
        "Route to wrong agent",
      ],
      perf_budget_ms: 10,
      security_level: "medium",
    },
    {
      id: "chatHistoryService",
      kind: "memory.component",
      responsibility: "Chat history management with CMC/HHNI storage and retrieval",
      status: "production",
      must_never: [
        "Lose chat history",
        "Allow unauthorized access",
        "Skip history validation",
      ],
      perf_budget_ms: 200,
      security_level: "critical",
    },
    {
      id: "contextManager",
