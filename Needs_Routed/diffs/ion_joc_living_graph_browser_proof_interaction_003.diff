+"""ION Living Operational Graph local browser proof handoff.
+
+This module prepares a fixture-bound browser proof plan for the JOC graph route.
+It does not launch a browser, navigate a page, access credentials, use external
+network, mutate the DOM, deploy, or claim screenshot proof.  It emits a manifest
+and handoff object that a local, explicitly approved visual harness can use.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+from .ion_living_graph_view_model import build_living_graph_view_model
+
+FIXTURE_MANIFEST_OUTPUT = Path("ION/05_context/current/living_graph/BROWSER_PROOF_FIXTURE_MANIFEST_CANDIDATE.json")
+HANDOFF_OUTPUT = Path("ION/05_context/current/living_graph/BROWSER_PROOF_HANDOFF_CANDIDATE.json")
+
+
+def utc_now() -> str:
+    return datetime.now(timezone.utc).replace(microsecond=0).isoformat()
+
+
+def _fixture_from_contract_item(item: dict[str, Any], *, order: int) -> dict[str, Any]:
+    selectors = item.get("selectors") if isinstance(item.get("selectors"), list) else []
+    return {
+        "id": str(item.get("id") or f"fixture_{order:02d}"),
+        "label": str(item.get("label") or item.get("id") or f"fixture {order}"),
+        "order": order,
+        "target_route": "#graph",
+        "target_surface": "ION/08_ui/joc_cockpit_shell",
+        "selectors": [str(selector) for selector in selectors],
+        "expected": str(item.get("expected") or "selector contract holds"),
+        "allowed_actions": [
+            "read_dom",
+            "read_accessibility_tree",
+            "capture_screenshot",
+            "keyboard_focus_only",
+            "click_local_ui_controls_only",
+        ],
+        "forbidden_actions": [
+            "external_network_access",
+            "credential_or_session_import",
+            "form_submission",
+            "account_operation",
+            "persistent_dom_mutation",
+            "production_visual_automation",
+        ],
+        "evidence_required": [
+            "screenshot_ref",
+            "dom_snapshot_ref",
+            "console_summary_ref",
+            "local_browser_execution_run_receipt",
+        ],
+        "authority": {
+            "local_dev_only": True,
+            "production_authority": False,
+            "live_execution_authority": False,
+            "external_network_authority": False,
+            "credential_authority": False,
+        },
+    }
+
+
+def build_living_graph_browser_proof_manifest(root: str | Path = ".") -> dict[str, Any]:
+    model = build_living_graph_view_model(root)
+    contract = model.get("browser_proof_contract") if isinstance(model.get("browser_proof_contract"), dict) else {}
+    fixture_items = contract.get("fixtures") if isinstance(contract.get("fixtures"), list) else []
+    fixtures = [
+        _fixture_from_contract_item(item, order=index + 1)
+        for index, item in enumerate(fixture_items)
+        if isinstance(item, dict)
+    ]
+    return {
+        "schema_id": "ion.living_graph.browser_proof_fixture_manifest.v1",
+        "generated_at": utc_now(),
+        "status": "candidate_fixture_manifest_ready" if fixtures and model.get("status") == "ready" else "candidate_fixture_manifest_watch",
+        "target": {
+            "route": "#graph",
+            "local_shell": "ION/08_ui/joc_cockpit_shell",
+            "expected_dev_url": "http://127.0.0.1:8788/#graph",
+            "origin_policy": "local_files_or_loopback_only",
+        },
+        "model_status": model.get("status"),
+        "model_kpis": model.get("kpis"),
+        "fixture_count": len(fixtures),
+        "fixtures": fixtures,
+        "required_environment": {
+            "node_vite_route": "ION/08_ui/joc_cockpit_shell",
+            "external_network": "forbidden",
+            "credentials": "forbidden",
+            "browser_profile": "ephemeral",
+            "artifact_writes": "receipts_and_capture_artifacts_only",
+        },
+        "commands_for_local_approval": {
+            "build_view_model": "PYTHONPATH=ION/04_packages python3 -m kernel.ion_living_graph_view_model --root . --write",
+            "build_static_visual_proof": "PYTHONPATH=ION/04_packages python3 -m kernel.ion_living_graph_visual_proof --root . --write",
+            "start_vite_loopback": "cd ION/08_ui/joc_cockpit_shell && node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 8788",
+            "target_url": "http://127.0.0.1:8788/#graph",
+        },
+        "authority": {
+            "accepted_state": False,
+            "production_authority": False,
+            "browser_execution_authorized": False,
+            "external_network_authorized": False,
+            "credential_access_authorized": False,
+            "settlement_required_for_inheritance": True,
+        },
+        "non_claims": [
+            "fixture_manifest_only",
+            "not_browser_execution",
+            "not_screenshot_proof",
+            "not_live_telemetry",
+            "not_accepted_ion_state",
+        ],
+    }
+
+
+def build_living_graph_browser_proof_handoff(root: str | Path = ".") -> dict[str, Any]:
+    manifest = build_living_graph_browser_proof_manifest(root)
+    fixture_count = int(manifest.get("fixture_count") or 0)
+    return {
+        "schema_id": "ion.living_graph.browser_proof_handoff.v1",
+        "generated_at": utc_now(),
+        "status": "candidate_browser_proof_handoff_ready" if manifest.get("status") == "candidate_fixture_manifest_ready" else "candidate_browser_proof_handoff_watch",
+        "packet": "PCKT-ION-JOC-LIVING-GRAPH-BROWSER-PROOF-003",
+        "manifest_path": str(FIXTURE_MANIFEST_OUTPUT),
+        "visual_proof_path": "ION/05_context/current/ACTIVE_LIVING_GRAPH_VISUAL_PROOF.json",
+        "static_svg_path": "ION/05_context/current/living_graph/ACTIVE_LIVING_GRAPH_STATIC_PROOF.svg",
+        "target_url": manifest.get("target", {}).get("expected_dev_url"),
+        "fixture_count": fixture_count,
+        "acceptance_gates": {
+            "fixture_manifest_ready": manifest.get("status") == "candidate_fixture_manifest_ready",
+            "graph_shell_zones_fixture_present": any(fixture.get("id") == "graph_shell_zones" for fixture in manifest.get("fixtures", [])),
+            "honesty_badge_fixture_present": any(fixture.get("id") == "graph_honesty_badge" for fixture in manifest.get("fixtures", [])),
+            "relationship_inspector_fixture_present": any(fixture.get("id") == "graph_relationship_inspector" for fixture in manifest.get("fixtures", [])),
+            "minimap_fixture_present": any(fixture.get("id") == "graph_minimap" for fixture in manifest.get("fixtures", [])),
+            "local_loopback_only": manifest.get("target", {}).get("origin_policy") == "local_files_or_loopback_only",
+            "no_browser_execution_claim": True,
+        },
+        "next_local_visual_harness_request": {
+            "run_name": "ION JOC Living Graph browser proof 003",
+            "run_mode": "LOOPBACK_CAPTURE",
+            "target_origin_policy": "LOCAL_FILES_OR_LOOPBACK_ONLY",
+            "network_observation": "NO_EXTERNAL_NETWORK_OBSERVED",
+            "credential_observation": "NO_CREDENTIALS_OR_SESSION_IMPORT_OBSERVED",
+            "action_observation": "READ_ONLY_CAPTURE_ACTIONS_ONLY",
+            "mutation_observation": "NO_PERSISTENT_MUTATION_OBSERVED",
+            "artifact_write_observation": "RECEIPTS_AND_CAPTURE_ARTIFACTS_ONLY",
+            "fixture_manifest_refs": [str(FIXTURE_MANIFEST_OUTPUT)],
+        },
+        "commands_for_braden_or_local_codex": manifest.get("commands_for_local_approval"),
+        "authority": manifest.get("authority"),
+        "non_claims": [
+            "not_browser_screenshot_proof",
+            "not_live_browser_execution",
+            "not_production_ui",
+            "not_accepted_ion_state",
+            "no_action_mcp_mutation",
+        ],
+    }
+
+
+def write_living_graph_browser_proof_handoff(root: str | Path = ".") -> dict[str, Any]:
+    root_path = Path(root)
+    manifest = build_living_graph_browser_proof_manifest(root_path)
+    handoff = build_living_graph_browser_proof_handoff(root_path)
+
+    manifest_path = root_path / FIXTURE_MANIFEST_OUTPUT
+    manifest_path.parent.mkdir(parents=True, exist_ok=True)
+    manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+    handoff_path = root_path / HANDOFF_OUTPUT
+    handoff_path.parent.mkdir(parents=True, exist_ok=True)
+    handoff_path.write_text(json.dumps(handoff, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+    return {
+        "manifest": manifest,
+        "handoff": handoff,
+        "paths": {
+            "manifest": str(FIXTURE_MANIFEST_OUTPUT),
+            "handoff": str(HANDOFF_OUTPUT),
+        },
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="Build the ION Living Graph local browser proof handoff.")
+    parser.add_argument("--root", default=".", help="ION repository root")
+    parser.add_argument("--write", action="store_true", help="Write manifest and handoff JSON files")
+    args = parser.parse_args(argv)
+
+    payload = write_living_graph_browser_proof_handoff(args.root) if args.write else {
+        "manifest": build_living_graph_browser_proof_manifest(args.root),
+        "handoff": build_living_graph_browser_proof_handoff(args.root),
+    }
+    print(json.dumps(payload, indent=2, sort_keys=True))
+    status = payload.get("handoff", {}).get("status")
+    return 0 if status == "candidate_browser_proof_handoff_ready" else 1
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
