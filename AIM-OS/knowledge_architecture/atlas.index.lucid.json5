        "sharedEvidenceGraph": {
          "systemId": "seg.sharedEvidenceGraph",
          "systemName": "Shared Evidence Graph - Knowledge Synthesis and Contradiction Detection",
          "version": "v0.1",
          "description": "Knowledge synthesis system that builds a shared evidence graph to detect contradictions, resolve conflicts, and synthesize insights across all AIM-OS systems. Think 'AI's reasoning engine' - connects all knowledge, finds patterns, and maintains logical consistency.",
          "status": "production",
          "layer": 1,
          "internalNodes": [
            {
              "id": "graphBuilder",
              "kind": "core.component",
              "responsibility": "Builds and maintains the shared evidence graph structure",
              "status": "production",
              "must_never": [
                "Create circular dependencies in graph",
                "Lose graph connectivity",
                "Allow inconsistent graph state"
              ],
              "perf_budget_ms": 50,
              "security_level": "high"
            },
            {
              "id": "contradictionDetector",
              "kind": "analysis.component",
              "responsibility": "Detects contradictions and conflicts in the evidence graph",
              "status": "production",
              "must_never": [
                "Miss critical contradictions",
                "Create false positive conflicts",
                "Lose contradiction context"
              ],
              "perf_budget_ms": 30,
              "security_level": "high"
            },
            {
              "id": "conflictResolver",
              "kind": "resolution.component",
              "responsibility": "Resolves conflicts using evidence strength and provenance",
              "status": "production",
              "must_never": [
                "Resolve conflicts without evidence",
                "Lose conflict resolution reasoning",
                "Create inconsistent resolutions"
              ],
              "perf_budget_ms": 40,
              "security_level": "high"
            },
            {
              "id": "knowledgeSynthesizer",
              "kind": "synthesis.component",
              "responsibility": "Synthesizes insights and patterns from the evidence graph",
              "status": "production",
              "must_never": [
                "Synthesize without sufficient evidence",
                "Create false synthesis patterns",
                "Lose synthesis provenance"
              ],
              "perf_budget_ms": 60,
              "security_level": "medium"
            },
            {
              "id": "evidenceValidator",
              "kind": "validation.component",
              "responsibility": "Validates evidence quality and reliability",
              "status": "production",
              "must_never": [
                "Accept invalid evidence",
                "Skip evidence validation",
                "Lose validation reasoning"
              ],
              "perf_budget_ms": 25,
              "security_level": "high"
            },
            {
              "id": "relationshipMapper",
              "kind": "mapping.component",
              "responsibility": "Maps relationships and dependencies between evidence nodes",
              "status": "production",
              "must_never": [
                "Create incorrect relationships",
                "Lose relationship context",
                "Allow relationship cycles"
              ],
              "perf_budget_ms": 35,
              "security_level": "medium"
            },
            {
              "id": "consistencyChecker",
              "kind": "consistency.component",
              "responsibility": "Maintains logical consistency across the entire graph",
              "status": "production",
