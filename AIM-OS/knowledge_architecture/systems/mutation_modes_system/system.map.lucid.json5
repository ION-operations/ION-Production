{
  system_id: "mutation_modes_system",
  system_name: "Mutation Modes System",
  version: "1.0.0",
  last_updated: "2025-01-27T20:50:00Z",
  map_type: "system_topology",
  internal_topology: {
    core_components: [
      {
        component_id: "change_classifier",
        name: "Change Classifier",
        type: "classification_engine",
        tier: 2,
        description: "Classifies changes by risk level and complexity",
        ports: {
          input: [
            "change_request",
            "classification_rules",
          ],
          output: [
            "change_classification",
            "risk_assessment",
          ],
        },
        dependencies: [
          "risk_assessment_rules",
          "complexity_assessment_rules",
        ],
        blast_radius: "system",
        must_never: [
          "Classify changes without validation",
          "Skip risk assessment",
          "Bypass complexity assessment",
          "Ignore mode selection rules",
        ],
      },
      {
        component_id: "mode_router",
        name: "Mode Router",
        type: "routing_engine",
        tier: 2,
        description: "Routes changes to appropriate mutation mode",
        ports: {
          input: [
            "change_request",
            "change_classification",
          ],
          output: [
            "routing_decision",
            "mode_status",
          ],
        },
        dependencies: [
          "change_classification",
          "mode_processors",
        ],
        blast_radius: "system",
        must_never: [
          "Route changes without classification",
          "Skip mode validation",
          "Bypass routing rules",
          "Ignore mode status",
        ],
      },
      {
        component_id: "trivial_mode_processor",
        name: "Trivial Mode Processor",
        type: "processing_engine",
        tier: 2,
        description: "Processes trivial and gentle changes",
        ports: {
          input: [
            "change_request",
            "validation_rules",
          ],
          output: [
            "processing_result",
            "execution_status",
          ],
        },
        dependencies: [
          "validation_engine",
          "propagation_manager",
        ],
        blast_radius: "local",
        must_never: [
          "Process high-risk changes",
          "Skip validation",
          "Bypass auto-propagation",
          "Ignore safety checks",
        ],
      },
      {
        component_id: "governed_mode_processor",
        name: "Governed Mode Processor",
        type: "processing_engine",
        tier: 2,
        description: "Processes governed and critical changes",
        ports: {
          input: [
            "change_request",
            "confidence_packet",
          ],
          output: [
            "processing_result",
            "approval_status",
          ],
        },
        dependencies: [
          "validation_engine",
          "approval_engine",
        ],
        blast_radius: "system",
        must_never: [
          "Process changes without approval",
          "Skip comprehensive validation",
          "Bypass approval workflows",
          "Ignore risk assessment",
        ],
      },
      {
        component_id: "propagation_manager",
        name: "Propagation Manager",
        type: "propagation_engine",
        tier: 2,
        description: "Manages change propagation and notification",
        ports: {
          input: [
            "change_request",
            "propagation_rules",
          ],
          output: [
            "propagation_result",
            "notification_status",
          ],
        },
        dependencies: [
          "dependency_analyzer",
          "notification_engine",
        ],
        blast_radius: "platform",
        must_never: [
          "Propagate changes without analysis",
          "Skip dependency checks",
          "Bypass notification requirements",
          "Ignore rollback support",
        ],
      },
    ],
    supporting_components: [
      {
        component_id: "validation_engine",
        name: "Validation Engine",
        type: "validation_engine",
        tier: 1,
        description: "Provides validation services for both modes",
        ports: {
          input: [
            "change_request",
            "validation_rules",
          ],
          output: [
            "validation_result",
            "validation_errors",
          ],
        },
        dependencies: [
          "validation_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Skip validation rules",
          "Ignore validation errors",
          "Bypass validation checks",
          "Skip validation escalation",
        ],
      },
      {
        component_id: "approval_engine",
        name: "Approval Engine",
        type: "approval_engine",
        tier: 1,
        description: "Provides approval workflows for governed mode",
        ports: {
          input: [
            "change_request",
            "approval_rules",
          ],
          output: [
            "approval_result",
            "approval_status",
          ],
        },
        dependencies: [
          "approval_rules",
        ],
        blast_radius: "system",
        must_never: [
          "Skip approval workflows",
          "Ignore approval requirements",
          "Bypass approval validation",
          "Skip approval tracking",
        ],
      },
      {
        component_id: "notification_engine",
        name: "Notification Engine",
        type: "notification_engine",
        tier: 1,
        description: "Provides notification services for propagation",
        ports: {
          input: [
            "notification_request",
            "notification_rules",
          ],
          output: [
            "notification_result",
            "delivery_status",
          ],
        },
        dependencies: [
          "notification_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Skip notifications",
          "Ignore notification delivery",
          "Bypass notification tracking",
          "Skip notification validation",
        ],
      },
      {
        component_id: "rollback_engine",
        name: "Rollback Engine",
        type: "rollback_engine",
        tier: 1,
        description: "Provides rollback capabilities",
        ports: {
          input: [
            "rollback_request",
            "rollback_rules",
          ],
          output: [
            "rollback_result",
            "rollback_status",
          ],
        },
        dependencies: [
          "rollback_rules",
        ],
        blast_radius: "system",
        must_never: [
          "Skip rollback validation",
          "Ignore rollback safety",
          "Bypass rollback checks",
          "Skip rollback tracking",
        ],
      },
    ],
  },
  boundary_tendrils: {
    input_ports: [
      {
        port_id: "change_request_input",
        name: "Change Request Input",
        type: "data_input",
        protocol: "json",
        description: "Receives change requests from external systems",
        required: true,
        validation: "change_request_schema",
      },
      {
        port_id: "classification_rules_input",
        name: "Classification Rules Input",
        type: "data_input",
        protocol: "json",
        description: "Receives classification rules from external systems",
        required: true,
        validation: "classification_rules_schema",
      },
      {
        port_id: "validation_rules_input",
        name: "Validation Rules Input",
        type: "data_input",
        protocol: "json",
        description: "Receives validation rules from external systems",
        required: true,
        validation: "validation_rules_schema",
      },
    ],
    output_ports: [
      {
        port_id: "processing_result_output",
        name: "Processing Result Output",
        type: "data_output",
        protocol: "json",
        description: "Outputs processing results to external systems",
        required: true,
        validation: "processing_result_schema",
      },
      {
        port_id: "propagation_result_output",
        name: "Propagation Result Output",
        type: "data_output",
        protocol: "json",
        description: "Outputs propagation results to external systems",
        required: true,
        validation: "propagation_result_schema",
      },
      {
        port_id: "notification_output",
        name: "Notification Output",
        type: "data_output",
        protocol: "json",
        description: "Outputs notifications to external systems",
        required: true,
        validation: "notification_schema",
      },
    ],
  },
  data_flow: {
    primary_flow: [
      {
        step: 1,
        component: "change_classifier",
        action: "Classify change",
        input: [
          "change_request",
          "classification_rules",
        ],
        output: [
          "change_classification",
          "risk_assessment",
        ],
      },
      {
        step: 2,
        component: "mode_router",
        action: "Route change to appropriate mode",
        input: [
          "change_request",
          "change_classification",
        ],
        output: [
          "routing_decision",
          "mode_status",
        ],
      },
      {
        step: 3,
        component: "trivial_mode_processor",
        action: "Process trivial change",
        input: [
          "change_request",
          "validation_rules",
        ],
        output: [
          "processing_result",
          "execution_status",
        ],
      },
      {
        step: 4,
        component: "governed_mode_processor",
        action: "Process governed change",
        input: [
          "change_request",
          "confidence_packet",
        ],
        output: [
          "processing_result",
          "approval_status",
        ],
      },
      {
        step: 5,
        component: "propagation_manager",
        action: "Manage change propagation",
        input: [
          "change_request",
          "propagation_rules",
        ],
        output: [
          "propagation_result",
          "notification_status",
        ],
      },
    ],
    secondary_flows: [
      {
        flow_name: "validation_processing",
        components: [
          "validation_engine",
          "trivial_mode_processor",
          "governed_mode_processor",
        ],
        description: "Processes validation for both modes",
      },
      {
        flow_name: "approval_processing",
        components: [
          "approval_engine",
          "governed_mode_processor",
        ],
        description: "Processes approval workflows for governed mode",
      },
      {
        flow_name: "notification_processing",
        components: [
          "notification_engine",
          "propagation_manager",
        ],
        description: "Processes notifications for propagation",
      },
    ],
  },
  security_boundaries: {
    tier_0: {
      components: [
        "validation_engine",
        "notification_engine",
        "rollback_engine",
      ],
      description: "Supporting components with basic security requirements",
    },
    tier_1: {
      components: [
        "approval_engine",
      ],
      description: "Approval component with standard security requirements",
    },
    tier_2: {
      components: [
        "change_classifier",
        "mode_router",
        "trivial_mode_processor",
        "governed_mode_processor",
        "propagation_manager",
      ],
      description: "Core components with comprehensive security requirements",
    },
  },
