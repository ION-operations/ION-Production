  "internalNodes": [
    {
      "id": "quartetValidator",
      "responsibility": "Enforces quartet parity (code, docs, tests, traces) for all changes",
      "must_never": [
        "Allow changes without quartet parity",
        "Skip validation for any component",
        "Modify validation rules without approval"
      ],
      "perf_budget_ms": 20,
      "status": "production"
    },
    {
      "id": "atomicChangeManager",
      "responsibility": "Manages atomic changes with proper rollback capabilities",
      "must_never": [
        "Allow partial changes to proceed",
        "Lose rollback information",
        "Create inconsistent change states"
      ],
      "perf_budget_ms": 15,
      "status": "production"
    },
    {
      "id": "blastRadiusCalculator",
      "responsibility": "Calculates blast radius and impact analysis for changes",
      "must_never": [
        "Underestimate change impact",
        "Miss critical dependencies",
        "Lose impact analysis data"
      ],
      "perf_budget_ms": 25,
      "status": "production"
    },
    {
      "id": "doraMetricsTracker",
      "responsibility": "Tracks DORA metrics (Deployment Frequency, Lead Time, MTTR, Change Failure Rate)",
      "must_never": [
        "Lose metrics data",
        "Calculate metrics incorrectly",
        "Expose sensitive metrics data"
      ],
      "perf_budget_ms": 10,
      "status": "production"
    },
    {
      "id": "qualityGateManager",
      "responsibility": "Manages quality gates and approval workflows",
      "must_never": [
        "Bypass quality gates",
        "Allow unapproved changes",
        "Lose gate decision reasoning"
      ],
      "perf_budget_ms": 8,
      "status": "production"
    },
    {
      "id": "traceabilityEngine",
      "responsibility": "Maintains complete traceability for all changes and decisions",
      "must_never": [
        "Lose trace information",
        "Create incomplete traces",
        "Allow trace tampering"
      ],
      "perf_budget_ms": 12,
      "status": "production"
    },
    {
      "id": "evolutionTracker",
      "responsibility": "Tracks evolution of components and their relationships",
      "must_never": [
        "Lose evolution history",
        "Create inconsistent evolution records",
        "Allow evolution data corruption"
      ],
      "perf_budget_ms": 18,
      "status": "production"
    }
  ],
  
