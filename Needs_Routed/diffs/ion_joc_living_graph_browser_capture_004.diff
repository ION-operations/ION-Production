+"""Browser capture harness for the ION Living Operational Graph JOC surface.
+
+The harness is intentionally local-only.  It can render the built React shell as
+an inline fixture so proof capture does not depend on live network, live MCP, or
+loopback server mutation.  Browser execution remains candidate proof until a
+human/Steward settlement route accepts it.
+"""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import json
+import os
+import subprocess
+import sys
+from datetime import datetime, timezone
