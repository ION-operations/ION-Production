+def _selected_relationships(
+    selected_id: str,
+    *,
+    visible_nodes: list[dict[str, Any]],
+    visible_edges: list[dict[str, Any]],
+    event_cards: list[dict[str, Any]],
+) -> dict[str, Any]:
+    node_index = {_text(node.get("id"), ""): node for node in visible_nodes}
+    incoming = [edge for edge in visible_edges if edge.get("target") == selected_id]
+    outgoing = [edge for edge in visible_edges if edge.get("source") == selected_id]
+    adjacent_edges = incoming + outgoing
+    neighbor_ids: list[str] = []
+    for edge in adjacent_edges:
+        for key in ("source", "target"):
+            candidate = _text(edge.get(key), "")
+            if candidate and candidate != selected_id and candidate not in neighbor_ids:
+                neighbor_ids.append(candidate)
+    event_refs = [
+        event
+        for event in event_cards
+        if event.get("actor_node") == selected_id
+        or event.get("source_node") == selected_id
+        or event.get("target_node") == selected_id
+    ]
+    children = [node for node in visible_nodes if node.get("parent_id") == selected_id]
+    proof_refs: list[str] = []
+    receipt_refs: list[str] = []
+    for event in event_refs:
+        proof_ref = event.get("proof_ref")
+        receipt_ref = event.get("receipt_ref")
+        if proof_ref and proof_ref not in proof_refs:
+            proof_refs.append(str(proof_ref))
+        if receipt_ref and receipt_ref not in receipt_refs:
+            receipt_refs.append(str(receipt_ref))
+    return {
+        "selected_node_id": selected_id,
+        "incoming_edges": incoming[:12],
+        "outgoing_edges": outgoing[:12],
+        "neighbor_nodes": [node_index[node_id] for node_id in neighbor_ids if node_id in node_index][:12],
+        "children": children[:12],
+        "events": event_refs[:16],
