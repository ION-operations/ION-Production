        "lucid_core_console": {
          "systemId": "lucid_core_console",
          "systemName": "Lucid Core Console - Aether's Command Interface",
          "version": "v0.1",
          "description": "VS Code/Cursor extension that serves as Aether's command console - a grounded conscience and bidirectional translator between human and machine cognition, with voice I/O, phone remote control, and hard gates on file mutation.",
          "status": "production",
          "layer": 6,
          "internalNodes": [
            {
              "id": "consoleUI",
              "kind": "core.component",
              "responsibility": "Provides the main user interface with prompt input, task thread display, action buttons, and status strip.",
              "status": "design",
              "must_never": [
                "Allow silent file mutations",
                "Hide risk warnings",
                "Bypass approval gates",
                "Exceed 100ms UI response time"
              ],
              "perf_budget_ms": 100,
              "security_level": "high"
            },
            {
