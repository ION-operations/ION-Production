+def settlement_intake_preflight(
+    root: str | Path,
+    *,
+    settlement_packet_path: str | Path | None = None,
+    packet: dict[str, Any] | None = None,
+    branch_record_path: str | Path | None = None,
+) -> dict[str, Any]:
+    """Read-only intake guard for branch settlement packets.
+
+    The context settler can use this before considering any branch material
+    return. The guard never merges, assigns checkpoints, or mutates shared
+    context; it only classifies whether the packet is structurally admissible.
+    """
+
+    findings: list[str] = []
+    packet_data: dict[str, Any] | None = None
+
+    if packet is not None:
+        packet_data = dict(packet)
+    elif settlement_packet_path:
+        try:
+            packet_data = _read_json(_shell_root(root) / settlement_packet_path, {})
+            if not packet_data:
+                findings.append(f"settlement_packet_empty:{_rel_path(settlement_packet_path)}")
+        except json.JSONDecodeError:
+            findings.append(f"settlement_packet_invalid_json:{_rel_path(settlement_packet_path)}")
+        except OSError:
+            findings.append(f"settlement_packet_missing:{_rel_path(settlement_packet_path)}")
+    else:
+        findings.append("settlement_packet_required")
+
+    branch_record: dict[str, Any] | None = None
+    if branch_record_path:
+        try:
+            branch_record = load_branch_record(root, branch_record_path)
+        except FileNotFoundError:
+            findings.append(f"branch_record_missing:{_rel_path(branch_record_path)}")
+        except json.JSONDecodeError:
+            findings.append(f"branch_record_invalid_json:{_rel_path(branch_record_path)}")
+
+    material = False
+    branch_identity: dict[str, Any] = {}
+    if packet_data is not None:
+        if packet_data.get("schema_id") != "ion.context_settlement.inbox_packet.v1":
+            findings.append(f"settlement_packet_schema_unexpected:{packet_data.get('schema_id')}")
+        if packet_data.get("status") != "CANDIDATE_PENDING_SETTLEMENT":
+            findings.append(f"settlement_packet_status_unexpected:{packet_data.get('status')}")
+
+        branch_identity = packet_data.get("branch_identity") or {}
+        for field_name in ("context_instance_id", "branch_id", "conversation_tag", "agent_tag", "task_tag", "parent_context_id"):
+            if not branch_identity.get(field_name):
+                findings.append(f"branch_identity_missing:{field_name}")
+
+        checkpoint = packet_data.get("checkpoint_request") or {}
+        direct_c_number = (
+            packet_data.get("assigned_c_number")
+            or packet_data.get("agent_assigned_c_number")
+            or checkpoint.get("assigned_c_number")
+            or checkpoint.get("agent_assigned_c_number")
+        )
+        if direct_c_number:
+            findings.append(f"agent_checkpoint_assignment_forbidden:{direct_c_number}")
+
+        for ref in packet_data.get("source_refs") or ():
+            rel = _rel_path(ref)
+            if _is_shared_context_surface(rel):
+                findings.append(f"settlement_source_ref_shared_context_surface_forbidden:{rel}")
+
+        requested_scope = tuple(_rel_path(p) for p in (packet_data.get("requested_write_scope") or ()))
+        findings.extend(_scope_forbidden_findings(requested_scope, prefix="settlement_requested_write_scope"))
+
+        material = _settlement_packet_material(packet_data)
+        if material:
+            guard = packet_data.get("material_work_guard") or packet_data.get("guard_evidence")
+            if not guard:
+                findings.append("material_work_guard_evidence_required")
+            else:
+                if guard.get("ok") is not True or guard.get("verdict") != READY_VERDICT:
+                    findings.append(f"material_work_guard_not_ready:{guard.get('verdict')}")
+                if guard.get("findings"):
+                    findings.append("material_work_guard_has_findings")
+                guard_identity = guard.get("branch_identity") or {}
+                for field_name, value in branch_identity.items():
+                    if field_name in guard_identity and guard_identity.get(field_name) != value:
+                        findings.append(f"guard_branch_identity_mismatch:{field_name}")
+                guard_scope = set(_rel_path(p) for p in (guard.get("requested_write_scope") or ()))
+                packet_scope = set(requested_scope)
+                if packet_scope and guard_scope and not packet_scope.issubset(guard_scope):
+                    missing = ",".join(sorted(packet_scope - guard_scope))
+                    findings.append(f"requested_scope_not_covered_by_guard:{missing}")
+
+            workload_diff = packet_data.get("workload_diff") or {}
+            if workload_diff.get("present") is not True:
+                findings.append("workload_diff_required_for_material_settlement")
+            if not workload_diff.get("touched_paths"):
+                findings.append("workload_diff_touched_paths_required")
+
+    if branch_record is not None and branch_identity:
+        record_identity = _branch_identity(branch_record)
+        for field_name, value in branch_identity.items():
+            if record_identity.get(field_name) != value:
+                findings.append(f"branch_record_identity_mismatch:{field_name}")
+
+    ok = not findings
+    return {
+        "schema_id": "ion.agent_branch_capsule.settlement_intake_preflight.v1",
+        "ok": ok,
+        "verdict": READY_VERDICT if ok else BLOCKED_VERDICT,
+        "required_action": "context_settler_review_admissible_packet" if ok else "repair_branch_settlement_packet_before_review",
+        "settlement_packet_path": _rel_path(settlement_packet_path) if settlement_packet_path else None,
+        "branch_record_path": _rel_path(branch_record_path) if branch_record_path else None,
+        "material_settlement": material,
+        "branch_identity": branch_identity or None,
+        "findings": findings,
