{
  systemId: "lucid-ide.reactorSystems",
  systemName: "Lucid IDE Reactor Systems",
  version: "v1.0.0",
  status: "production",
  layer: 3,
  description: "Dual visualization engines providing 2D canvas-based and 3D Three.js-based reactor visualizations for system architecture, node relationships, and activity monitoring",
  purpose: "Provides interactive visual representations of system architecture, node relationships, particle effects, and real-time activity monitoring through both 2D canvas and 3D WebGL rendering",
  dependencies: ["lucid-ide.frontendSystem"],
  internalNodes: [
    {
      id: "reactor2D",
      kind: "core.component",
      responsibility: "2D canvas-based reactor visualization (590+ lines) with particle systems and node visualization",
      status: "production",
      must_never: [
        "Lose reactor state",
        "Break canvas rendering",
        "Exceed 60fps budget",
      ],
      perf_budget_ms: 16,
      security_level: "low",
    },
    {
      id: "reactor3D",
      kind: "core.component",
      responsibility: "3D WebGL-based reactor visualization (560+ lines) with Three.js, spatial positioning, and camera controls",
      status: "production",
      must_never: [
        "Lose 3D state",
        "Break WebGL rendering",
        "Exceed memory limits",
      ],
      perf_budget_ms: 16,
      security_level: "low",
    },
    {
      id: "visualEngine2D",
      kind: "supporting.component",
      responsibility: "2D visual engine managing canvas rendering, particles, and node layout",
      status: "production",
      must_never: [
        "Break rendering loop",
        "Lose particle state",
        "Cause memory leaks",
      ],
      perf_budget_ms: 16,
      security_level: "low",
    },
    {
      id: "visualEngine3D",
      kind: "supporting.component",
      responsibility: "3D visual engine managing WebGL rendering, Three.js scene, and spatial positioning",
      status: "production",
      must_never: [
        "Break WebGL context",
        "Lose scene state",
        "Cause GPU memory leaks",
      ],
      perf_budget_ms: 16,
      security_level: "low",
    },
    {
      id: "nodeSystem",
      kind: "data.component",
      responsibility: "Node system managing 3D nodes, connections, and metrics",
      status: "production",
      must_never: [
        "Lose node data",
        "Break node relationships",
        "Corrupt metrics",
      ],
      perf_budget_ms: 10,
      security_level: "low",
    },
    {
      id: "spatialPositioning",
      kind: "service.component",
      responsibility: "Spatial positioning engine for 3D node layout and camera controls",
      status: "production",
      must_never: [
        "Lose spatial state",
        "Break camera controls",
        "Cause layout instability",
      ],
      perf_budget_ms: 50,
      security_level: "low",
    },
  ],
  ports: [
    {
      id: "canvas2D",
      portName: "2D Canvas Rendering",
      type: "outbound",
      protocol: "Canvas2D",
      security: "low",
      description: "2D canvas rendering for reactor visualization",
      rateLimit: "60fps",
      authentication: "n/a",
      authorization: "n/a",
      dataFormat: "2D_graphics",
      versioning: "n/a",
    },
    {
      id: "webgl3D",
      portName: "3D WebGL Rendering",
      type: "outbound",
      protocol: "WebGL",
      security: "low",
      description: "3D WebGL rendering via Three.js",
      rateLimit: "60fps",
      authentication: "n/a",
      authorization: "n/a",
      dataFormat: "3D_scene",
      versioning: "n/a",
    },
    {
      id: "reactorData",
      portName: "Reactor Data Input",
      type: "input",
      protocol: "react-props",
      security: "low",
      description: "Receives reactor data from parent components",
      rateLimit: "unlimited",
      authentication: "n/a",
      authorization: "n/a",
      dataFormat: "JSON",
      versioning: "n/a",
    },
  ],
  internalEdges: [
    {
      from: "reactor2D",
      to: "visualEngine2D",
      type: "composition",
      description: "2D reactor uses visual engine for rendering",
      protocol: "internal",
      performance: "0ms",
      security: "low",
      dataFlow: "bidirectional",
      frequency: "continuous",
    },
    {
      from: "reactor3D",
      to: "visualEngine3D",
      type: "composition",
      description: "3D reactor uses visual engine for rendering",
      protocol: "internal",
      performance: "0ms",
      security: "low",
      dataFlow: "bidirectional",
      frequency: "continuous",
    },
    {
      from: "reactor3D",
      to: "nodeSystem",
      type: "data_flow",
      description: "3D reactor reads node data from node system",
      protocol: "internal",
      performance: "10ms",
      security: "low",
      dataFlow: "unidirectional",
      frequency: "continuous",
    },
    {
      from: "reactor3D",
      to: "spatialPositioning",
      type: "data_flow",
      description: "3D reactor uses spatial positioning for layout",
      protocol: "internal",
      performance: "50ms",
      security: "low",
      dataFlow: "bidirectional",
      frequency: "on-demand",
    },
    {
      from: "visualEngine2D",
      to: "canvas2D",
      type: "data_flow",
      description: "Visual engine renders to 2D canvas",
      protocol: "Canvas2D",
      performance: "16ms",
      security: "low",
      dataFlow: "unidirectional",
      frequency: "continuous",
    },
    {
      from: "visualEngine3D",
      to: "webgl3D",
      type: "data_flow",
      description: "Visual engine renders to WebGL",
      protocol: "WebGL",
      performance: "16ms",
      security: "low",
      dataFlow: "unidirectional",
      frequency: "continuous",
    },
  ],
  externalEdges: [
    {
      from: "lucid-ide.reactorSystems.reactorData",
      to: "lucid-ide.frontendSystem.mainPage",
      type: "data_flow",
      protocol: "react-props",
      description: "Frontend provides reactor data",
      rateLimit: "unlimited",
      security: "low",
      authentication: "n/a",
      dataFormat: "JSON",
    },
  ],
  riskOverlay: {
    performance: {
      hotspots: ["reactor2D", "reactor3D"],
      bottlenecks: ["canvas2D", "webgl3D"],
      optimization: "RequestAnimationFrame optimization, WebGL batching, particle culling",
      scalability: "client-side rendering (GPU-dependent)",
      monitoring: ["fps", "render_time", "memory_usage", "gpu_usage"],
    },
    security: {
      sensitive: [],
      critical: [],
      encryption: "n/a",
      vulnerabilities: [],
      mitigations: [],
    },
    governance: {
      touchpoints: ["reactor2D", "reactor3D"],
      compliance: [],
      audit_trail: "optional",
      approval_required: [],
      review_cycle: "quarterly",
    },
  },
  metadata: {
