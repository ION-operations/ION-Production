        "Lose emotional state",
        "Skip emotion tracking",
        "Create inconsistent emotions",
        "Allow emotion corruption"
      ],
      "perf_budget_ms": 8,
      "status": "production"
    },
    {
      "id": "promptContextTracker",
      "responsibility": "Tracks context evolution at each prompt for continuity",
      "must_never": [
        "Lose context snapshots",
        "Skip context tracking",
        "Create incomplete snapshots",
        "Allow context corruption"
      ],
      "perf_budget_ms": 12,
      "status": "production"
    }
  ],
  
