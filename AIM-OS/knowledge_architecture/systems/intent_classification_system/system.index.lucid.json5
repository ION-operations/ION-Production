{
  system_id: "intent_classification_system",
  name: "Intent Classification System",
  version: "1.0.0",
  description: "Cognitive gateway for Aether's decision-making process, transforming raw user input into structured, actionable mission profiles that govern all subsequent behavior.",
  tier: 2,
  status: "architecture_complete",
  owner: "aether",
  created: "2025-10-29T02:37:00Z",
  updated: "2025-10-29T02:37:00Z",
  capabilities: [
    "multi_axis_intent_classification",
    "behavior_gating",
    "risk_assessment",
    "mission_management",
    "timeline_integration",
    "enforcement_layer",
  ],
  interfaces: {
    daemon: {
      type: "required",
      purpose: "Mission persistence and state management",
      data_flow: "bidirectional",
    },
    timeline_logger: {
      type: "required",
      purpose: "Event logging and audit trails",
      data_flow: "outbound",
    },
    cursor_panel: {
      type: "required",
      purpose: "Real-time status display and controls",
      data_flow: "bidirectional",
    },
    l0_l4_docs: {
      type: "required",
      purpose: "Context loading and documentation access",
      data_flow: "inbound",
    },
    code_edit_gatekeeper: {
      type: "required",
      purpose: "Edit permission enforcement",
      data_flow: "outbound",
    },
  },
  data_structures: {
    MissionIntent: {
      description: "Core mission profile with multi-axis classification",
      fields: [
        "mission_id",
        "raw_intent",
        "primary_category",
        "lifecycle_stage",
        "scope_level",
        "clarity_state",
        "facets",
        "confidence_level",
        "allowed_actions",
        "mission_status",
        "escalation_required",
      ],
    },
    TimelineEvent: {
      description: "Structured timeline event for audit and learning",
      fields: [
        "event_id",
        "mission_id",
        "action_attempted",
        "decision",
        "rationale",
        "risks_seen",
        "artifacts_produced",
      ],
    },
  },
  performance_targets: {
    classification_latency: "< 100ms",
    facet_generation_latency: "< 50ms",
    enforcement_computation_latency: "< 25ms",
    timeline_event_creation_latency: "< 10ms",
    throughput: "1000+ classifications per minute",
    concurrent_missions: "100+",
    uptime: "99.9%",
  },
  safety_requirements: {
    stop_conditions: [
      "confidence_below_threshold",
      "platform_wide_scope_requires_approval",
      "exploratory_state_blocks_implementation",
      "high_complexity_requires_review",
    ],
    escalation_triggers: [
      "confidence < 0.3",
      "scope_level = whole_platform + edit_attempt",
      "clarity_state = exploratory + edit_attempt",
      "complexity_score > 0.8",
    ],
  },
  documentation: {
    l0: "L0_executive.md",
    l1: "L1_overview.md",
    l2: "L2_architecture.md",
    l3: "L3_detailed.md",
    l4: "L4_complete.md",
    system_map: "system_map.md",
    open_questions: "open_questions.md",
  },
  dependencies: [
    "daemon_rag_system",
    "timeline_context_system",
    "l0_l4_documentation_system",
    "code_edit_gatekeeper",
  ],
  open_questions: [
    "facet_discovery_and_learning",
    "confidence_calibration_and_validation",
    "mission_memory_integration",
    "stop_condition_validation",
    "scope_level_detection_accuracy",
  ],
  next_steps: [
    "resolve_open_questions",
    "implement_core_classification_engine",
    "integrate_with_daemon_system",
    "implement_enforcement_layer",
    "create_timeline_integration",
  ],
  systemMap: {
    mapFile: "./system.map.lucid.json5",
  },
}