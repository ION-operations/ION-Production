      },
    ],
  },
  data_flow: {
    primary_flow: [
      {
        step: 1,
        component: "improvement_analyzer",
        action: "Analyze system performance",
        input: [
          "performance_data",
          "improvement_rules",
        ],
        output: [
          "improvement_recommendations",
          "analysis_reports",
