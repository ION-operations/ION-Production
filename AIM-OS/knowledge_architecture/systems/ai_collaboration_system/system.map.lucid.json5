        port_id: "task_assignments_output",
        name: "Task Assignments Output",
        type: "data_output",
        protocol: "json",
        description: "Outputs task assignments to AI systems",
        required: true,
        validation: "task_assignments_schema",
      },
    ],
  },
  data_flow: {
    primary_flow: [
      {
        step: 1,
        component: "ai_communication_engine",
        action: "Manage AI communication",
        input: [
          "communication_requests",
          "communication_rules",
        ],
        output: [
          "communication_responses",
          "communication_status",
        ],
      },
      {
        step: 2,
        component: "collaboration_coordinator",
        action: "Coordinate collaboration",
        input: [
          "collaboration_requests",
          "coordination_rules",
        ],
        output: [
          "collaboration_status",
          "coordination_events",
        ],
      },
      {
        step: 3,
        component: "task_distributor",
        action: "Distribute tasks",
        input: [
          "task_requests",
          "distribution_rules",
        ],
        output: [
          "task_assignments",
          "distribution_status",
        ],
      },
      {
        step: 4,
        component: "knowledge_sharer",
        action: "Share knowledge",
        input: [
          "knowledge_requests",
          "sharing_rules",
        ],
        output: [
          "shared_knowledge",
          "sharing_status",
        ],
      },
      {
        step: 5,
        component: "collaboration_monitor",
        action: "Monitor collaboration",
        input: [
          "monitoring_requests",
          "monitoring_rules",
        ],
        output: [
          "monitoring_reports",
          "performance_metrics",
        ],
      },
    ],
    secondary_flows: [
      {
        flow_name: "communication_processing",
        components: [
          "ai_communication_engine",
          "message_router",
          "protocol_handler",
        ],
        description: "Processes communication between AI systems",
      },
      {
        flow_name: "collaboration_management",
        components: [
