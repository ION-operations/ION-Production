{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ION Custom GPT Boot Sequence Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ion_boot_sequence_result"
  ],
  "properties": {
    "ion_boot_sequence_result": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_id",
        "route_id",
        "mounted_packages",
        "objective",
        "active_workflow_object",
        "phases_completed",
        "persona_return_gate",
        "accepted_state_claim",
        "production_authority",
        "live_execution_authority",
        "receipt_status"
      ],
      "anyOf": [
        {
          "required": [
            "boot_id"
          ]
        },
        {
          "required": [
            "workflow_object"
          ],
          "properties": {
            "workflow_object": {
              "required": [
                "id"
              ]
            }
          }
        }
      ],
      "properties": {
        "schema_id": {
          "const": "ion.boot_sequence_result.v1"
        },
        "boot_id": {
          "type": "string"
        },
        "workflow_object": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "route_id": {
              "type": "string"
            }
          }
        },
        "route_id": {
          "type": "string"
        },
        "mounted_packages": {
          "type": "object",
          "required": [
            "count",
            "posture"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "posture": {
              "type": "string"
            }
          }
        },
        "objective": {
          "type": "string"
        },
        "active_workflow_object": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "phases_completed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "persona_return_gate": {
          "enum": [
            "pass",
            "blocked"
          ]
        },
        "accepted_state_claim": {
          "const": false
        },
        "production_authority": {
          "const": false
        },
        "live_execution_authority": {
          "const": false
        },
        "receipt_status": {
          "enum": [
            "candidate_boot_receipt",
            "candidate_work_receipt",
            "blocked_receipt"
          ]
        }
      }
    }
  }
}
