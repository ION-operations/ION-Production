        },
      ],
    },
    {
      id: "retrieval",
      name: "Retrieval Subsystem",
      type: "subsystem",
      parent: "hhni.hierarchicalHypergraph",
      status: "production",
      description: "Two-stage intelligent retrieval pipeline: Stage 1 (coarse KNN) → Stage 2 (DVNS refinement, deduplication, conflict resolution, compression, budget fitting)",
      meetsCriteria: ["complexity", "independence", "relationship", "evolution"],
      documentation: {
        L0: "components/retrieval/README.md",
