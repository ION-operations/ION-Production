{
  system_id: "performance_monitoring",
  system_name: "Performance Monitoring System",
  version: "1.0.0",
  last_updated: "2025-01-27T20:50:00Z",
  map_type: "system_topology",
  internal_topology: {
    core_components: [
      {
        component_id: "performance_monitor",
        name: "Performance Monitor",
        type: "monitoring_engine",
        tier: 2,
        description: "Core performance monitoring engine that tracks and analyzes system performance metrics",
        ports: {
          input: [
            "performance_data",
            "monitoring_rules",
          ],
          output: [
            "performance_metrics",
            "monitoring_alerts",
          ],
        },
        dependencies: [
          "metrics_collector",
          "alert_manager",
        ],
        blast_radius: "platform",
        must_never: [
          "Monitor performance without validation",
          "Skip monitoring rules",
          "Ignore performance thresholds",
          "Bypass monitoring validation",
        ],
      },
      {
        component_id: "metrics_collector",
        name: "Metrics Collector",
        type: "collection_engine",
        tier: 2,
        description: "Collects performance metrics from various system components",
        ports: {
          input: [
            "collection_requests",
            "collection_rules",
          ],
          output: [
            "collected_metrics",
            "collection_status",
          ],
        },
        dependencies: [
          "collection_rules",
          "data_processor",
        ],
        blast_radius: "platform",
        must_never: [
          "Collect metrics without validation",
          "Skip collection rules",
          "Ignore data quality",
          "Bypass collection validation",
        ],
      },
      {
        component_id: "alert_manager",
        name: "Alert Manager",
        type: "alert_engine",
        tier: 2,
        description: "Manages performance alerts and notifications",
        ports: {
          input: [
            "alert_requests",
            "alert_rules",
          ],
          output: [
            "performance_alerts",
            "alert_status",
          ],
        },
        dependencies: [
          "alert_rules",
          "notification_engine",
        ],
        blast_radius: "platform",
        must_never: [
          "Manage alerts without validation",
          "Skip alert rules",
          "Ignore alert thresholds",
          "Bypass alert validation",
        ],
      },
      {
        component_id: "performance_analyzer",
        name: "Performance Analyzer",
        type: "analysis_engine",
        tier: 2,
        description: "Analyzes performance data and identifies trends and issues",
        ports: {
          input: [
            "performance_data",
            "analysis_rules",
          ],
          output: [
            "performance_analysis",
            "trend_reports",
          ],
        },
        dependencies: [
          "analysis_rules",
          "trend_analyzer",
        ],
        blast_radius: "platform",
        must_never: [
          "Analyze performance without validation",
          "Skip analysis rules",
          "Ignore performance trends",
          "Bypass analysis validation",
        ],
      },
      {
        component_id: "performance_reporter",
        name: "Performance Reporter",
        type: "reporting_engine",
        tier: 2,
        description: "Generates performance reports and dashboards",
        ports: {
          input: [
            "report_requests",
            "reporting_rules",
          ],
          output: [
            "performance_reports",
            "dashboard_data",
          ],
        },
        dependencies: [
          "reporting_templates",
          "dashboard_engine",
        ],
        blast_radius: "platform",
        must_never: [
          "Generate reports without validation",
          "Skip reporting rules",
          "Ignore report requirements",
          "Bypass reporting validation",
        ],
      },
    ],
    supporting_components: [
      {
        component_id: "collection_rules",
        name: "Collection Rules",
        type: "rules_engine",
        tier: 1,
        description: "Provides rules for metrics collection",
        ports: {
          input: [
            "collection_requests",
            "rule_definitions",
          ],
          output: [
            "collection_rules",
            "rule_status",
          ],
        },
        dependencies: [
          "rule_definitions",
        ],
        blast_radius: "local",
        must_never: [
          "Provide rules without validation",
          "Skip rule definitions",
          "Ignore rule requirements",
          "Bypass rule validation",
        ],
      },
      {
        component_id: "data_processor",
        name: "Data Processor",
        type: "processing_engine",
        tier: 1,
        description: "Processes collected performance data",
        ports: {
          input: [
            "raw_data",
            "processing_rules",
          ],
          output: [
            "processed_data",
            "processing_status",
          ],
        },
        dependencies: [
          "processing_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Process data without validation",
          "Skip processing rules",
          "Ignore data quality",
          "Bypass processing validation",
        ],
      },
      {
        component_id: "alert_rules",
        name: "Alert Rules",
        type: "rules_engine",
        tier: 1,
        description: "Provides rules for alert management",
        ports: {
          input: [
            "alert_requests",
            "rule_definitions",
          ],
          output: [
            "alert_rules",
            "rule_status",
          ],
        },
        dependencies: [
          "rule_definitions",
        ],
        blast_radius: "local",
        must_never: [
          "Provide rules without validation",
          "Skip rule definitions",
          "Ignore rule requirements",
          "Bypass rule validation",
        ],
      },
      {
        component_id: "notification_engine",
        name: "Notification Engine",
        type: "notification_engine",
        tier: 1,
        description: "Sends notifications for performance alerts",
        ports: {
          input: [
            "notification_requests",
            "notification_rules",
          ],
          output: [
            "notifications",
            "notification_status",
          ],
        },
        dependencies: [
          "notification_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Send notifications without validation",
          "Skip notification rules",
          "Ignore notification requirements",
          "Bypass notification validation",
        ],
      },
      {
        component_id: "trend_analyzer",
        name: "Trend Analyzer",
        type: "analysis_engine",
        tier: 1,
        description: "Analyzes performance trends and patterns",
        ports: {
          input: [
            "performance_data",
            "trend_rules",
          ],
          output: [
            "trend_analysis",
            "pattern_reports",
          ],
        },
        dependencies: [
          "trend_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Analyze trends without validation",
          "Skip trend rules",
          "Ignore trend patterns",
          "Bypass trend validation",
        ],
      },
    ],
  },
