# Normalize line endings
* text=auto eol=lf

# Prevent diffs on binary/generated files
artifacts/** -diff
*.tar.gz -diff
*.db -diff
*.pyc -diff

# Treat as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Force LF for scripts
*.sh text eol=lf
*.py text eol=lf

# Windows batch files need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

