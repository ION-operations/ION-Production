        description: "Checks compliance with security standards",
      },
      {
        flow_name: "threat_analysis",
        components: [
          "threat_analyzer",
          "threat_database",
          "analysis_rules",
        ],
        description: "Analyzes security threats and risks",
      },
    ],
  },
