    },
    {
      fromPort: "casIntegration",
      toSystem: "cas.cognitiveAnalysis",
      type: "adds_cognitive_context",
      data_flow: "cognitive_state \u2192 witness_enhancement",
      bidirectional: true,
      reverse_data_flow: "introspection_operations \u2192 witness_creation",
    },
    {
      fromPort: "externalAudit",
      toSystem: "audit.external",
      type: "reports_compliance",
      data_flow: "audit_data \u2192 compliance_reports",
      bidirectional: false,
    },
  ],
