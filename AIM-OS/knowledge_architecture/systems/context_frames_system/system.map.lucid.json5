        ports: {
          input: [
            "template_requests",
            "template_rules",
          ],
          output: [
            "frame_templates",
            "template_status",
          ],
        },
        dependencies: [
          "template_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Provide templates without validation",
          "Skip template rules",
          "Ignore template requirements",
          "Bypass template validation",
        ],
      },
      {
        component_id: "validation_rules",
        name: "Validation Rules",
        type: "rules_engine",
        tier: 1,
        description: "Provides validation rules for context frames",
        ports: {
          input: [
            "validation_requests",
            "rule_definitions",
          ],
          output: [
            "validation_rules",
            "rule_status",
          ],
        },
        dependencies: [
          "rule_definitions",
        ],
        blast_radius: "local",
        must_never: [
          "Provide rules without validation",
          "Skip rule definitions",
          "Ignore rule requirements",
          "Bypass rule validation",
        ],
      },
      {
        component_id: "lifecycle_manager",
        name: "Lifecycle Manager",
        type: "lifecycle_engine",
        tier: 1,
        description: "Manages context frame lifecycle",
        ports: {
          input: [
            "lifecycle_requests",
            "lifecycle_rules",
          ],
          output: [
            "lifecycle_status",
            "lifecycle_events",
          ],
        },
        dependencies: [
          "lifecycle_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Manage lifecycle without validation",
          "Skip lifecycle rules",
          "Ignore lifecycle events",
          "Bypass lifecycle validation",
        ],
      },
      {
        component_id: "error_handler",
        name: "Error Handler",
        type: "error_engine",
        tier: 1,
        description: "Handles errors in context frame processing",
        ports: {
          input: [
            "error_requests",
            "error_rules",
          ],
          output: [
            "error_responses",
            "error_status",
          ],
        },
        dependencies: [
          "error_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Handle errors without validation",
          "Skip error rules",
          "Ignore error requirements",
          "Bypass error validation",
        ],
      },
    ],
  },
