+        "cockpit": {"type": "boolean"},
+        "public_safe": {"type": "boolean"},
+        "redacted": {"type": "boolean"},
+        "raw_context_exported": {"const": false}
+      },
+      "required": ["cockpit", "public_safe", "redacted", "raw_context_exported"]
+    }
+  },
+  "additionalProperties": true
+}

