        "lucid_chat": {
          "systemId": "lucid-chat.advancedAIChat",
          "systemName": "Lucid Chat Advanced AI System",
          "version": "v0.9.2",
          "description": "Advanced AI chat system integrating consciousness substrate capabilities with multi-path reasoning, autonomous research, multi-agent collaboration, and complete AIM-OS integration",
          "status": "production",
          "layer": 6,
          "internalNodes": [
            {
              "id": "advancedLLMService",
              "kind": "core.component",
              "responsibility": "Advanced LLM service with thinking modes, prompt building, and output configuration",
              "status": "production",
              "must_never": [
                "Expose API keys",
                "Allow unauthorized access",
                "Skip input validation",
                "Return unvalidated output"
              ],
              "perf_budget_ms": 30000,
              "security_level": "critical"
            },
            {
              "id": "workflowExecutor",
              "kind": "orchestration.component",
              "responsibility": "APOE workflow execution with DAG parallel processing",
              "status": "production",
              "must_never": [
                "Skip dependency validation",
                "Allow circular dependencies",
                "Exceed budget without warning",
                "Bypass quality gates"
              ],
              "perf_budget_ms": 60000,
              "security_level": "high"
            },
            {
              "id": "searchOrchestrator",
              "kind": "search.component",
              "responsibility": "Orchestrates multi-provider search (DEEPSEARCH, ICIP, Perplexity, Tavily, Web)",
              "status": "production",
              "must_never": [
                "Expose API keys",
                "Skip result validation",
                "Allow unauthorized search"
              ],
              "perf_budget_ms": 5000,
              "security_level": "high"
            }
          ],
          "ports": [
            {
              "id": "commandServer",
              "portName": "Command Server Integration",
              "type": "bidirectional",
              "protocol": "HTTP",
              "security": "high",
              "description": "HTTP endpoint to Command Server (localhost:5001) for MCP tool execution"
            },
            {
              "id": "aimosIntegration",
              "portName": "AIM-OS Systems Integration",
              "type": "bidirectional",
              "protocol": "MCP",
              "security": "critical",
              "description": "MCP tools for CMC, HHNI, VIF, SEG, APOE integration"
            },
            {
              "id": "llmProviders",
              "portName": "LLM Provider APIs",
              "type": "unidirectional",
              "protocol": "HTTP",
              "security": "critical",
              "description": "External LLM provider APIs (Anthropic, Gemini, Cerebras, Minimax, OpenAI)"
            }
          ],
          "internalEdges": [],
          "externalEdges": [
            {
              "from": "lucid-chat.advancedAIChat.commandServer",
              "to": "cursor-addon.commandServer",
              "type": "data_flow",
              "protocol": "HTTP",
              "description": "MCP tool execution via Command Server"
            },
            {
              "from": "lucid-chat.advancedAIChat.aimosIntegration",
              "to": "cmc.contextMemoryCore",
              "type": "data_flow",
              "protocol": "MCP",
              "description": "Memory storage and retrieval"
            },
            {
              "from": "lucid-chat.advancedAIChat.aimosIntegration",
              "to": "hhni.hierarchicalHypergraph",
              "type": "data_flow",
              "protocol": "MCP",
              "description": "Hierarchical retrieval and indexing"
            },
            {
              "from": "lucid-chat.advancedAIChat.aimosIntegration",
              "to": "vif.verifiableIntelligence",
              "type": "data_flow",
              "protocol": "MCP",
              "description": "Confidence tracking and witness creation"
            },
            {
              "from": "lucid-chat.advancedAIChat.aimosIntegration",
              "to": "seg.sharedEvidenceGraph",
              "type": "data_flow",
              "protocol": "MCP",
              "description": "Knowledge synthesis"
            },
            {
              "from": "lucid-chat.advancedAIChat.llmProviders",
              "to": "external.anthropic",
              "type": "data_flow",
              "protocol": "HTTP",
              "description": "Calls Anthropic Claude API"
            },
            {
              "from": "lucid-chat.advancedAIChat.llmProviders",
              "to": "external.googleGemini",
              "type": "data_flow",
              "protocol": "HTTP",
              "description": "Calls Google Gemini API"
            }
          ],
          "riskOverlay": {
            "performance": {
              "hotspots": ["workflowExecutor", "advancedLLMService"],
              "bottlenecks": ["llmProviders", "aimosIntegration"],
              "optimization": "Caching, parallel execution, budget tracking",
              "scalability": "horizontal",
              "monitoring": ["request_latency", "budget_usage", "error_rate", "quality_gate_pass_rate"]
            },
            "security": {
              "sensitive": ["llmProviders", "aimosIntegration"],
              "critical": ["commandServer"],
              "encryption": "TLS",
              "vulnerabilities": ["api_key_exposure", "budget_exhaustion"],
              "mitigations": ["api_key_management", "budget_enforcement", "input_validation"]
            },
            "governance": {
              "touchpoints": ["workflowExecutor", "searchOrchestrator"],
              "compliance": [],
              "audit_trail": "via VIF witnesses",
              "approval_required": ["security_changes", "api_changes"],
              "review_cycle": "monthly"
            }
          },
