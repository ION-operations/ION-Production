{
  systemId: "seg.sharedEvidenceGraph",
  systemName: "Shared Evidence Graph - Knowledge Synthesis and Contradiction Detection",
  version: "v2.2.0",
  status: "production",
  layer: 1,
  description: "Knowledge synthesis system that builds a shared evidence graph to detect contradictions, resolve conflicts, and synthesize insights across all AIM-OS systems. Think 'AI's reasoning engine' - connects all knowledge, finds patterns, and maintains logical consistency.",
  internalNodes: [
    {
      id: "graphBuilder",
      kind: "core.component",
      responsibility: "Builds and maintains the shared evidence graph structure",
      status: "production",
      must_never: [
        "Create circular dependencies in graph",
        "Lose graph connectivity",
        "Allow inconsistent graph state",
      ],
      perf_budget_ms: 50,
      security_level: "high",
    },
    {
      id: "contradictionDetector",
      kind: "analysis.component",
      responsibility: "Detects contradictions and conflicts in the evidence graph",
      status: "production",
      must_never: [
        "Miss critical contradictions",
        "Create false positive conflicts",
        "Lose contradiction context",
      ],
      perf_budget_ms: 30,
      security_level: "high",
    },
    {
      id: "conflictResolver",
      kind: "resolution.component",
      responsibility: "Resolves conflicts using evidence strength and provenance",
      status: "production",
      must_never: [
        "Resolve conflicts without evidence",
        "Lose conflict resolution reasoning",
        "Create inconsistent resolutions",
      ],
      perf_budget_ms: 40,
      security_level: "high",
    },
    {
      id: "knowledgeSynthesizer",
      kind: "synthesis.component",
      responsibility: "Synthesizes insights and patterns from the evidence graph",
      status: "production",
      must_never: [
        "Synthesize without sufficient evidence",
        "Create false synthesis patterns",
        "Lose synthesis provenance",
      ],
      perf_budget_ms: 60,
      security_level: "medium",
    },
    {
      id: "evidenceValidator",
      kind: "validation.component",
      responsibility: "Validates evidence quality and reliability",
      status: "production",
      must_never: [
        "Accept invalid evidence",
        "Skip evidence validation",
        "Lose validation reasoning",
      ],
      perf_budget_ms: 25,
      security_level: "high",
    },
    {
      id: "relationshipMapper",
      kind: "mapping.component",
      responsibility: "Maps relationships and dependencies between evidence nodes",
      status: "production",
      must_never: [
        "Create incorrect relationships",
        "Lose relationship context",
        "Allow relationship cycles",
      ],
      perf_budget_ms: 35,
      security_level: "medium",
    },
    {
      id: "consistencyChecker",
      kind: "consistency.component",
      responsibility: "Maintains logical consistency across the entire graph",
      status: "production",
      must_never: [
        "Allow logical inconsistencies",
        "Skip consistency checks",
        "Lose consistency reasoning",
      ],
      perf_budget_ms: 45,
      security_level: "critical",
    },
    {
      id: "insightExtractor",
      kind: "extraction.component",
      responsibility: "Extracts actionable insights from graph patterns",
      status: "production",
      must_never: [
        "Extract insights without evidence",
        "Create misleading insights",
        "Lose insight provenance",
      ],
      perf_budget_ms: 20,
      security_level: "medium",
    },
    {
      id: "graphOptimizer",
      kind: "optimization.component",
      responsibility: "Optimizes graph structure for performance and clarity",
      status: "production",
      must_never: [
        "Lose graph information during optimization",
        "Create optimization artifacts",
        "Break graph connectivity",
      ],
      perf_budget_ms: 70,
      security_level: "low",
    },
  ],
  subsystems: [
    {
      id: "graph_schema",
      name: "Graph Schema Subsystem",
      type: "subsystem",
      parent: "seg.sharedEvidenceGraph",
      status: "production",
      description: "Defines nodes and edges for evidence graph: 4 node types (Claim, Source, Derivation, Agent) and 5 edge types (supports, contradicts, derives, witnesses, cites)",
      meetsCriteria: ["complexity", "independence", "relationship", "evolution"],
      documentation: {
        L0: "components/graph_schema/README.md",
        README: "components/graph_schema/README.md",
      },
      relationships: {
        parent: "seg.sharedEvidenceGraph",
        children: [],
        siblings: ["contradictions", "bitemporal", "query", "export"],
        external: ["cmc", "vif"],
      },
      integrationPoints: [
        {
          system: "cmc",
          purpose: "Graph schema nodes reference CMC atoms",
          type: "required",
        },
        {
          system: "vif",
          purpose: "Graph schema includes VIF witness references",
          type: "required",
        },
        {
          system: "apoe",
          purpose: "Graph schema stores APOE DEPP evidence nodes",
          type: "required",
        },
        {
          system: "cas",
          purpose: "Graph schema stores CAS failure mode patterns",
          type: "required",
        },
        {
          system: "tcs",
          purpose: "Graph schema stores TCS evolution patterns",
          type: "required",
        },
        {
          system: "sdfcvf",
          purpose: "Graph schema used by SDF-CVF for blast radius analysis",
          type: "required",
        },
      ],
    },
    {
      id: "contradictions",
      name: "Contradiction Detection Subsystem",
      type: "subsystem",
      parent: "seg.sharedEvidenceGraph",
      status: "production",
      description: "Automatically finds and flags conflicting information in the evidence graph. Algorithm: find semantically similar claims, check for opposite stances, create 'contradicts' edge, flag for resolution",
      meetsCriteria: ["complexity", "independence", "relationship", "evolution"],
      documentation: {
        L0: "components/contradictions/README.md",
        README: "components/contradictions/README.md",
      },
      relationships: {
        parent: "seg.sharedEvidenceGraph",
        children: [],
        siblings: ["graph_schema", "bitemporal", "query", "export"],
        external: ["hhni", "vif"],
      },
      integrationPoints: [
        {
          system: "hhni",
          purpose: "Uses HHNI for semantic similarity detection",
          type: "required",
        },
        {
          system: "vif",
          purpose: "Uses VIF confidence scores for contradiction resolution",
          type: "required",
        },
        {
          system: "apoe",
          purpose: "Contradiction detection used by APOE DEPP for evidence validation",
          type: "required",
        },
        {
          system: "cas",
          purpose: "Contradiction detection stores CAS failure mode patterns",
          type: "required",
        },
        {
          system: "tcs",
          purpose: "Contradiction detection stores TCS evolution patterns",
          type: "required",
        },
        {
          system: "sdfcvf",
          purpose: "Contradiction detection used by SDF-CVF for blast radius analysis",
          type: "required",
        },
      ],
    },
    {
      id: "bitemporal",
      name: "Bitemporal Subsystem",
      type: "subsystem",
      parent: "seg.sharedEvidenceGraph",
      status: "production",
      description: "Bitemporal support for evidence graph nodes and edges (valid time, transaction time) enabling time-travel queries and historical analysis",
      meetsCriteria: ["complexity", "independence", "relationship", "evolution"],
      documentation: {
        L0: "components/bitemporal/README.md",
        README: "components/bitemporal/README.md",
      },
      relationships: {
        parent: "seg.sharedEvidenceGraph",
        children: [],
        siblings: ["graph_schema", "contradictions", "query", "export"],
        external: ["cmc", "tcs"],
      },
      integrationPoints: [
        {
          system: "cmc",
          purpose: "Bitemporal queries use CMC's bitemporal engine",
          type: "required",
        },
        {
          system: "tcs",
          purpose: "Bitemporal data linked to TCS timeline entries",
          type: "required",
        },
        {
          system: "apoe",
          purpose: "Bitemporal queries used by APOE DEPP for evidence time-travel",
          type: "required",
        },
        {
          system: "cas",
          purpose: "Bitemporal queries store CAS failure mode patterns",
          type: "required",
        },
        {
          system: "sdfcvf",
          purpose: "Bitemporal queries used by SDF-CVF for blast radius time analysis",
          type: "required",
        },
      ],
    },
    {
      id: "query",
      name: "Query Subsystem",
      type: "subsystem",
      parent: "seg.sharedEvidenceGraph",
      status: "production",
      description: "Graph query engine for evidence retrieval, relationship traversal, and pattern matching",
      meetsCriteria: ["complexity", "independence", "relationship", "evolution"],
      documentation: {
        L0: "components/query/README.md",
        README: "components/query/README.md",
      },
      relationships: {
        parent: "seg.sharedEvidenceGraph",
        children: [],
        siblings: ["graph_schema", "contradictions", "bitemporal", "export"],
        external: ["hhni", "cmc"],
      },
      integrationPoints: [
        {
          system: "hhni",
          purpose: "Query subsystem uses HHNI for semantic search",
          type: "required",
        },
        {
          system: "cmc",
          purpose: "Query results reference CMC atoms",
          type: "required",
        },
        {
          system: "apoe",
          purpose: "Query subsystem used by APOE DEPP for evidence retrieval",
          type: "required",
        },
        {
          system: "cas",
          purpose: "Query subsystem stores CAS failure mode patterns",
          type: "required",
        },
        {
          system: "tcs",
          purpose: "Query subsystem stores TCS evolution patterns",
          type: "required",
        },
        {
          system: "sdfcvf",
          purpose: "Query subsystem used by SDF-CVF for blast radius dependency analysis",
          type: "required",
        },
      ],
    },
  ],
  ports: [
    {
      portId: "cmcIntegration",
      direction: "bidirectional",
      connectsToSystem: "cmc.contextMemoryCore",
      protocol: "internal_api",
      whatIsExchanged: [
        "provenance_edges",
        "graph_nodes",
        "evidence_links",
        "relationship_queries",
      ],
      security_level: "high",
      implementation: "packages/seg/cmc_integration.py",
      status: "complete",
    },
    {
      portId: "hhniIntegration",
      direction: "bidirectional",
      connectsToSystem: "hhni.hierarchicalHypergraph",
      protocol: "internal_api",
      whatIsExchanged: [
        "retrieval_context",
        "evidence_queries",
        "synthesis_requests",
        "pattern_analysis",
      ],
      security_level: "high",
