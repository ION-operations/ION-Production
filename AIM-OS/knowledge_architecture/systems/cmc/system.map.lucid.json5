{
  systemId: "cmc.contextMemoryCore",
  systemName: "Context Memory Core - Bitemporal Memory Substrate",
  version: "v2.2.0",
  status: "production",
  layer: 1,
  description: "The persistent bitemporal memory substrate that stores everything in AIM-OS. Think 'AI's hippocampus' - where all memories live, never forgotten, with time-travel capabilities.",
  internalNodes: [
    {
      id: "atomManager",
      kind: "core.component",
      responsibility: "Manages fundamental memory units (atoms) with bitemporal tracking",
      status: "production",
      must_never: [
        "Allow concurrent writes to same atom",
        "Delete atoms (only supersede)",
        "Modify atoms after creation",
      ],
      perf_budget_ms: 10,
      security_level: "high",
    },
    {
      id: "snapshotEngine",
      kind: "core.component",
      responsibility: "Creates immutable content-addressed snapshots of system state",
      status: "production",
      must_never: [
        "Modify snapshots after creation",
        "Create snapshots without deterministic ordering",
        "Allow hash collisions",
      ],
      perf_budget_ms: 50,
      security_level: "critical",
    },
    {
      id: "storageManager",
      kind: "storage.component",
      responsibility: "Manages multi-tier persistence (vector, object, metadata, graph stores)",
      status: "production",
      must_never: [
        "Lose data integrity",
        "Allow unauthorized access to stored content",
        "Exceed storage quotas without notification",
      ],
      perf_budget_ms: 100,
      security_level: "critical",
    },
    {
      id: "writePipeline",
      kind: "pipeline.component",
      responsibility: "Processes context ingestion: Parse \u2192 Atomize \u2192 Enrich \u2192 Index \u2192 Gate \u2192 Snapshot",
      status: "production",
      must_never: [
        "Skip quality gates",
        "Create atoms without proper validation",
        "Allow race conditions in write path",
      ],
      perf_budget_ms: 200,
      security_level: "high",
    },
    {
      id: "readPipeline",
      kind: "pipeline.component",
      responsibility: "Retrieves context: Query \u2192 HHNI \u2192 DVNS \u2192 Dedupe \u2192 Budget \u2192 Context",
      status: "production",
      must_never: [
        "Return inconsistent results",
        "Exceed context budget without warning",
        "Return stale data when fresh is available",
      ],
      perf_budget_ms: 150,
      security_level: "medium",
    },
    {
      id: "moleculeComposer",
      kind: "semantic.component",
      responsibility: "Groups related atoms into semantic structures",
      status: "development",
      must_never: [
        "Create circular dependencies",
        "Compose atoms from different snapshots",
        "Lose semantic relationships",
      ],
      perf_budget_ms: 75,
      security_level: "medium",
    },
    {
      id: "bitemporalQueryEngine",
      kind: "query.component",
      responsibility: "Enables time-travel queries with transaction and valid time",
      status: "production",
      must_never: [
        "Return data from future valid times",
        "Allow queries that break causality",
        "Expose deleted data without proper authorization",
      ],
      perf_budget_ms: 100,
      security_level: "high",
    },
  ],
  subsystems: [
    {
      id: "atoms",
      name: "Atom Management Subsystem",
      type: "subsystem",
      parent: "cmc.contextMemoryCore",
      status: "production",
      description: "Fundamental memory units (atoms) with bitemporal tracking, semantic metadata, and provenance",
      meetsCriteria: ["complexity", "independence", "relationship", "evolution"],
      documentation: {
        L0: "components/atoms/README.md",
        L1: "components/atoms/L1_overview.md",
        L2: "components/atoms/L2_architecture.md",
        L3: "components/atoms/L3_detailed.md",
        README: "components/atoms/README.md",
      },
      relationships: {
        parent: "cmc.contextMemoryCore",
        children: [
          "atoms.fields.content_ref",
          "atoms.fields.embedding",
          "atoms.fields.modality",
          "atoms.fields.tags",
          "atoms.fields.vif",
        ],
        siblings: ["pipelines", "snapshots", "storage"],
        external: ["hhni", "vif", "seg"],
      },
      integrationPoints: [
        {
          system: "hhni",
          purpose: "Atoms indexed by HHNI for hierarchical retrieval",
          type: "required",
        },
        {
          system: "vif",
          purpose: "Atoms store VIF witness envelopes for provenance",
          type: "required",
        },
        {
          system: "seg",
          purpose: "Atoms referenced by SEG graph nodes",
          type: "required",
        },
      ],
    },
    {
      id: "pipelines",
      name: "Pipeline Subsystem",
      type: "subsystem",
      parent: "cmc.contextMemoryCore",
      status: "production",
      description: "Data flow orchestration: Write Pipeline (ingest) and Read Pipeline (query) with 7 stages each",
      meetsCriteria: ["complexity", "independence", "relationship", "evolution"],
      documentation: {
        L0: "components/pipelines/README.md",
        L1: "components/pipelines/L1_overview.md",
        L2: "components/pipelines/L2_architecture.md",
        README: "components/pipelines/README.md",
      },
      relationships: {
        parent: "cmc.contextMemoryCore",
        children: [],
        siblings: ["atoms", "snapshots", "storage"],
        external: ["hhni", "vif", "sdfcvf", "apoe", "seg", "tcs"],
      },
      integrationPoints: [
        {
          system: "hhni",
          purpose: "Read Pipeline uses HHNI for intelligent retrieval",
          type: "required",
        },
        {
          system: "vif",
          purpose: "Write Pipeline generates VIF witnesses",
          type: "required",
        },
        {
          system: "sdfcvf",
          purpose: "Pipelines enforce SDF-CVF quality gates",
          type: "required",
        },
        {
          system: "apoe",
          purpose: "Pipelines store APOE execution traces",
          type: "required",
        },
        {
          system: "seg",
          purpose: "Pipelines provide atoms for SEG graph nodes",
          type: "required",
        },
        {
          system: "tcs",
          purpose: "Pipelines store TCS timeline nodes as atoms",
          type: "required",
        },
      ],
    },
    {
      id: "snapshots",
      name: "Snapshot Subsystem",
      type: "subsystem",
      parent: "cmc.contextMemoryCore",
      status: "production",
      description: "Immutable, content-addressed atom bundles for time-travel queries and rollback",
      meetsCriteria: ["complexity", "independence", "relationship", "evolution"],
      documentation: {
        L0: "components/snapshots/README.md",
        L1: "components/snapshots/L1_overview.md",
        L2: "components/snapshots/L2_architecture.md",
        README: "components/snapshots/README.md",
      },
      relationships: {
        parent: "cmc.contextMemoryCore",
        children: [],
        siblings: ["atoms", "pipelines", "storage"],
        external: ["vif", "seg", "apoe", "sdfcvf", "tcs"],
      },
      integrationPoints: [
        {
          system: "vif",
          purpose: "Snapshots include VIF witness data for verifiable replay",
          type: "required",
        },
        {
          system: "seg",
          purpose: "Snapshot lineage tracked in SEG graph",
          type: "required",
        },
        {
          system: "apoe",
          purpose: "Snapshots store APOE execution state checkpoints",
          type: "required",
        },
        {
          system: "sdfcvf",
          purpose: "Snapshots store SDF-CVF quartet snapshots",
          type: "required",
        },
        {
          system: "tcs",
          purpose: "Snapshots enable TCS timeline state restoration",
          type: "required",
        },
      ],
    },
    {
      id: "storage",
      name: "Storage Subsystem",
      type: "subsystem",
      parent: "cmc.contextMemoryCore",
      status: "production",
      description: "Multi-tier persistence: Vector Store, Object Store, Metadata Store, Graph Store",
      meetsCriteria: ["complexity", "independence", "relationship", "evolution"],
      documentation: {
        L0: "components/storage/README.md",
        L1: "components/storage/L1_overview.md",
        L2: "components/storage/L2_architecture.md",
        README: "components/storage/README.md",
      },
      relationships: {
        parent: "cmc.contextMemoryCore",
        children: [],
        siblings: ["atoms", "pipelines", "snapshots"],
        external: ["hhni", "seg", "apoe", "vif", "sdfcvf", "tcs"],
      },
      integrationPoints: [
        {
          system: "hhni",
          purpose: "Storage provides vector data for HHNI indexing",
          type: "required",
        },
        {
          system: "seg",
          purpose: "Storage provides graph data for SEG",
          type: "required",
        },
        {
          system: "apoe",
          purpose: "Storage provides execution trace storage for APOE",
          type: "required",
        },
        {
          system: "vif",
          purpose: "Storage provides witness data storage for VIF",
          type: "required",
        },
        {
          system: "sdfcvf",
          purpose: "Storage provides quartet snapshot storage for SDF-CVF",
          type: "required",
        },
        {
          system: "tcs",
          purpose: "Storage provides timeline node storage for TCS",
          type: "required",
        },
      ],
    },
  ],
  ports: [
    {
      portId: "hhniIntegration",
      direction: "bidirectional",
      connectsToSystem: "hhni.hierarchicalHypergraph",
      protocol: "internal_api",
      // v1 notification pattern: CMC journal + MCP polling (idempotent by atom_id)
      notificationPattern: {
        trigger: "cmc_event_journal_polling",
        modalityAllowlist: ["tcs_timeline", "plan_execution", "cas_introspection_analysis"],
        tagHints: ["hhni_index", "timeline_context", "apoe", "cas", "seg"],
        delivery: "at_least_once_idempotent",
      },
      whatIsExchanged: [
        "atoms_for_indexing",
        "hierarchical_paths",
        "retrieval_queries",
        "index_updates",
      ],
      security_level: "high",
    },
    {
      portId: "apoeIntegration",
      direction: "bidirectional",
      connectsToSystem: "apoe.aiPoweredOrchestration",
      protocol: "internal_api",
      whatIsExchanged: [
        "context_retrieval_requests",
        "execution_traces",
        "plan_artifacts",
        "plan_execution_atoms", // modality: plan_execution (AtomCreate payload)
        "memory_updates",
      ],
      security_level: "high",
    },
    {
      portId: "vifIntegration",
      direction: "bidirectional",
      connectsToSystem: "vif.verifiableIntelligence",
      protocol: "internal_api",
      whatIsExchanged: [
        "witness_storage",
        "confidence_scores",
        "verification_requests",
        "proof_artifacts",
      ],
      security_level: "critical",
    },
    {
      portId: "segIntegration",
      direction: "bidirectional",
      connectsToSystem: "seg.sharedEvidenceGraph",
      protocol: "internal_api",
      whatIsExchanged: [
        "provenance_edges",
        "graph_nodes",
        "evidence_links",
        "relationship_queries",
      ],
      security_level: "high",
    },
    {
      portId: "sdfcvfIntegration",
      direction: "bidirectional",
      connectsToSystem: "sdfcvf.atomicEvolution",
      protocol: "internal_api",
      whatIsExchanged: [
        "schema_validation",
        "parity_checks",
        "evolution_artifacts",
        "consistency_reports",
      ],
      security_level: "high",
    },
    {
      portId: "tcsIntegration",
      direction: "bidirectional",
      connectsToSystem: "tcs.timelineContext",
      protocol: "internal_api",
      whatIsExchanged: [
        "timeline_entry_storage",
        "tcs_timeline_atoms", // modality: tcs_timeline (helper flow)
        "context_retrieval_queries",
        "timeline_queries",
      ],
      security_level: "high",
    },
    {
      portId: "casIntegration",
      direction: "bidirectional",
      connectsToSystem: "cas.cognitiveAnalysis",
      protocol: "internal_api",
      whatIsExchanged: [
        "introspection_analysis_storage",
        "cas_introspection_analysis_atoms", // modality: cas_introspection_analysis
        "pattern_recognition_queries",
        "cognitive_history_queries",
      ],
      security_level: "high",
    },
    {
      portId: "externalStorage",
      direction: "outbound",
      connectsToSystem: "storage.external",
      protocol: "s3_compatible",
      whatIsExchanged: [
        "large_content_objects",
        "snapshot_bundles",
        "backup_data",
        "archive_content",
      ],
      security_level: "critical",
    },
    {
      portId: "vectorStore",
      direction: "outbound",
      connectsToSystem: "vector.faiss",
      protocol: "faiss_api",
      whatIsExchanged: [
        "embedding_vectors",
        "similarity_queries",
        "index_updates",
        "search_results",
      ],
      security_level: "medium",
    },
  ],
  internalEdges: [
    {
      from: "writePipeline",
      to: "atomManager",
      type: "creates_atoms",
      data_flow: "context_input \u2192 atom_creation",
    },
    {
      from: "atomManager",
      to: "snapshotEngine",
      type: "provides_atoms",
      data_flow: "atoms \u2192 snapshot_bundles",
    },
    {
      from: "snapshotEngine",
      to: "storageManager",
      type: "stores_snapshots",
      data_flow: "snapshots \u2192 persistent_storage",
    },
    {
      from: "readPipeline",
      to: "bitemporalQueryEngine",
      type: "queries_temporal_data",
      data_flow: "queries \u2192 temporal_results",
    },
    {
      from: "bitemporalQueryEngine",
      to: "storageManager",
      type: "retrieves_data",
      data_flow: "queries \u2192 stored_atoms",
    },
    {
      from: "moleculeComposer",
      to: "atomManager",
      type: "composes_atoms",
      data_flow: "related_atoms \u2192 semantic_structures",
    },
    {
      from: "writePipeline",
      to: "moleculeComposer",
      type: "triggers_composition",
      data_flow: "new_atoms \u2192 composition_analysis",
    },
  ],
  externalEdges: [
    {
      fromPort: "hhniIntegration",
      toSystem: "hhni.hierarchicalHypergraph",
      type: "provides_indexing_data",
      data_flow: "atoms \u2192 hierarchical_index",
    },
    {
      fromPort: "apoeIntegration",
      toSystem: "apoe.aiPoweredOrchestration",
      type: "provides_context",
      data_flow: "queries \u2192 retrieved_context",
    },
    {
      fromPort: "vifIntegration",
      toSystem: "vif.verifiableIntelligence",
      type: "stores_witnesses",
      data_flow: "witnesses \u2192 persistent_storage",
    },
    {
      fromPort: "segIntegration",
      toSystem: "seg.sharedEvidenceGraph",
      type: "provides_provenance_data",
      data_flow: "atoms \u2192 graph_nodes",
    },
    {
      fromPort: "sdfcvfIntegration",
      toSystem: "sdfcvf.atomicEvolution",
      type: "validates_schema",
      data_flow: "atoms \u2192 consistency_checks",
    },
    {
      fromPort: "tcsIntegration",
      toSystem: "tcs.timelineContext",
      type: "stores_timeline_entries",
      data_flow: "timeline_entries \u2192 tcs_timeline_atoms",
    },
    {
      fromPort: "casIntegration",
      toSystem: "cas.cognitiveAnalysis",
      type: "stores_introspection_analyses",
      data_flow: "introspection_results \u2192 cas_introspection_analysis_atoms",
    },
    {
      fromPort: "externalStorage",
      toSystem: "storage.external",
      type: "stores_large_objects",
      data_flow: "content \u2192 object_store",
    },
    {
      fromPort: "vectorStore",
      toSystem: "vector.faiss",
      type: "indexes_embeddings",
      data_flow: "vectors \u2192 similarity_index",
    },
  ],
  riskOverlay: {
    perf_hotspots: [
      "writePipeline",
      "bitemporalQueryEngine",
      "storageManager",
    ],
    security_sensitive_ports: [
      "vifIntegration",
      "externalStorage",
      "hhniIntegration",
    ],
    governance_touchpoints: [
      "snapshotEngine",
      "atomManager",
      "bitemporalQueryEngine",
    ],
    critical_failure_modes: [
      "Data loss in storageManager",
      "Hash collision in snapshotEngine",
      "Race condition in writePipeline",
      "Unauthorized access via externalStorage",
    ],
    blast_radius: {
      atomManager: "entire_memory_system",
      snapshotEngine: "all_temporal_queries",
      storageManager: "all_persistent_data",
      writePipeline: "data_integrity",
    },
  },
  governance: {
    single_writer_discipline: true,
    bitemporal_integrity: true,
    content_addressing: true,
    never_delete_policy: true,
    audit_trail_required: true,
  },
  monitoring: {
    key_metrics: [
      "atoms_created_per_second",
      "snapshot_creation_latency",
      "query_response_time",
      "storage_utilization",
      "bitemporal_query_accuracy",
