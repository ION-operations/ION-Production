{
  systemId: "intent_classification_system",
  systemName: "Intent Classification System - Cognitive Gateway for Decision Making",
  version: "v0.1",
  description: "Cognitive gateway that transforms raw user input into structured mission profiles, enabling intelligent decision-making and behavior gating for autonomous AI operations. Think 'AI's decision-making brain' - understands intent, assesses risk, and controls actions.",
  internalNodes: [
    {
      id: "classificationEngine",
      kind: "core.component",
      responsibility: "Core classification logic for multi-axis intent analysis",
      status: "production",
      must_never: [
        "Classify without proper patterns",
        "Return inconsistent classifications",
        "Lose classification context",
      ],
      perf_budget_ms: 10,
      security_level: "high",
    },
    {
      id: "missionIntentModel",
      kind: "core.component",
      responsibility: "Data structure representing classified mission intent with behavior controls",
      status: "production",
      must_never: [
        "Create invalid mission intents",
        "Lose mission context",
        "Allow inconsistent behavior controls",
      ],
      perf_budget_ms: 5,
      security_level: "high",
    },
    {
      id: "enforcementLayer",
      kind: "enforcement.component",
      responsibility: "Behavior gating and action authorization based on mission profiles",
      status: "production",
      must_never: [
        "Bypass enforcement rules",
        "Allow unauthorized actions",
        "Lose enforcement reasoning",
      ],
      perf_budget_ms: 8,
      security_level: "critical",
    },
    {
      id: "patternMatcher",
      kind: "matching.component",
      responsibility: "Pattern matching for intent classification across multiple axes",
      status: "production",
      must_never: [
        "Miss relevant patterns",
        "Create false positive matches",
        "Lose pattern context",
      ],
      perf_budget_ms: 6,
      security_level: "medium",
    },
    {
      id: "confidenceCalculator",
      kind: "calculation.component",
      responsibility: "Calculates confidence scores for classification results",
      status: "production",
      must_never: [
        "Calculate confidence without evidence",
        "Return invalid confidence scores",
        "Lose confidence reasoning",
      ],
      perf_budget_ms: 4,
      security_level: "medium",
    },
    {
      id: "riskAssessor",
      kind: "assessment.component",
      responsibility: "Assesses mission risk levels and generates stop conditions",
      status: "production",
      must_never: [
        "Underestimate mission risks",
        "Skip risk assessment",
        "Lose risk reasoning",
      ],
      perf_budget_ms: 7,
      security_level: "high",
    },
    {
      id: "facetExtractor",
      kind: "extraction.component",
      responsibility: "Extracts contextual facets from user intent",
      status: "production",
      must_never: [
        "Extract irrelevant facets",
        "Lose facet context",
        "Create false facets",
      ],
      perf_budget_ms: 5,
      security_level: "low",
    },
    {
      id: "complexityCalculator",
      kind: "calculation.component",
      responsibility: "Calculates mission complexity scores",
      status: "production",
      must_never: [
        "Calculate complexity without context",
        "Return invalid complexity scores",
        "Lose complexity reasoning",
      ],
      perf_budget_ms: 3,
      security_level: "low",
    },
    {
      id: "suggestionGenerator",
      kind: "generation.component",
      responsibility: "Generates suggestions for mission improvement",
      status: "production",
      must_never: [
        "Generate misleading suggestions",
        "Lose suggestion context",
        "Create inappropriate suggestions",
      ],
      perf_budget_ms: 6,
      security_level: "low",
    },
    {
      id: "timelineIntegration",
      kind: "integration.component",
      responsibility: "Integrates with timeline system for audit trails and event logging",
      status: "production",
      must_never: [
        "Skip timeline logging",
        "Lose event context",
        "Create incomplete audit trails",
      ],
      perf_budget_ms: 4,
      security_level: "medium",
    },
  ],
  ports: [
    {
      portId: "userInput",
      direction: "inbound",
      connectsToSystem: "user.interface",
      protocol: "http_api",
      whatIsExchanged: [
        "raw_intent",
        "context_data",
        "classification_requests",
      ],
      security_level: "medium",
    },
    {
      portId: "cmcIntegration",
      direction: "bidirectional",
      connectsToSystem: "cmc.contextMemoryCore",
      protocol: "internal_api",
      whatIsExchanged: [
        "mission_data",
        "classification_results",
        "audit_trails",
      ],
      security_level: "high",
    },
    {
      portId: "hhniIntegration",
      direction: "bidirectional",
      connectsToSystem: "hhni.hierarchicalHypergraph",
      protocol: "internal_api",
      whatIsExchanged: [
        "similar_missions",
        "context_retrieval",
        "pattern_analysis",
      ],
      security_level: "high",
    },
    {
      portId: "vifIntegration",
      direction: "bidirectional",
      connectsToSystem: "vif.verifiableIntelligence",
      protocol: "internal_api",
      whatIsExchanged: [
        "confidence_tracking",
        "validation_requests",
        "witness_data",
      ],
      security_level: "high",
    },
    {
      portId: "apoeIntegration",
      direction: "bidirectional",
      connectsToSystem: "apoe.aiPoweredOrchestration",
      protocol: "internal_api",
      whatIsExchanged: [
        "mission_profiles",
        "execution_plans",
        "orchestration_requests",
      ],
      security_level: "high",
    },
    {
      portId: "segIntegration",
      direction: "bidirectional",
      connectsToSystem: "seg.sharedEvidenceGraph",
      protocol: "internal_api",
      whatIsExchanged: [
        "knowledge_synthesis",
        "evidence_validation",
        "contradiction_detection",
      ],
      security_level: "high",
    },
    {
      portId: "sdfcvfIntegration",
      direction: "bidirectional",
      connectsToSystem: "sdfcvf.atomicEvolution",
      protocol: "internal_api",
      whatIsExchanged: [
        "change_validation",
        "quality_checks",
        "evolution_tracking",
      ],
      security_level: "high",
    },
  ],
  internalEdges: [
    {
      from: "classificationEngine",
      to: "missionIntentModel",
      type: "creates_mission_intent",
      data_flow: "classification_results \u2192 mission_intent_creation",
    },
    {
      from: "missionIntentModel",
      to: "enforcementLayer",
      type: "provides_mission_profile",
      data_flow: "mission_intent \u2192 enforcement_decisions",
    },
    {
      from: "patternMatcher",
      to: "classificationEngine",
      type: "provides_patterns",
      data_flow: "pattern_matches \u2192 classification_input",
    },
    {
      from: "confidenceCalculator",
      to: "classificationEngine",
      type: "provides_confidence",
      data_flow: "confidence_scores \u2192 classification_results",
    },
    {
      from: "riskAssessor",
      to: "missionIntentModel",
      type: "provides_risk_assessment",
      data_flow: "risk_analysis \u2192 mission_intent_enhancement",
    },
    {
      from: "facetExtractor",
      to: "missionIntentModel",
      type: "provides_facets",
      data_flow: "extracted_facets \u2192 mission_intent_facets",
    },
    {
      from: "complexityCalculator",
      to: "missionIntentModel",
      type: "provides_complexity",
      data_flow: "complexity_scores \u2192 mission_intent_complexity",
    },
    {
      from: "suggestionGenerator",
      to: "classificationEngine",
      type: "provides_suggestions",
      data_flow: "suggestions \u2192 classification_enhancement",
    },
    {
      from: "timelineIntegration",
      to: "all_components",
      type: "logs_operations",
      data_flow: "operation_data \u2192 timeline_events",
    },
  ],
  externalEdges: [
    {
      fromPort: "userInput",
      toSystem: "user.interface",
      type: "receives_intent",
      data_flow: "user_input \u2192 classification_processing",
    },
    {
      fromPort: "cmcIntegration",
      toSystem: "cmc.contextMemoryCore",
      type: "stores_mission_data",
      data_flow: "mission_intent \u2192 persistent_storage",
    },
    {
      fromPort: "hhniIntegration",
      toSystem: "hhni.hierarchicalHypergraph",
      type: "retrieves_similar_missions",
      data_flow: "classification_queries \u2192 similar_context",
    },
    {
      fromPort: "vifIntegration",
      toSystem: "vif.verifiableIntelligence",
      type: "tracks_confidence",
      data_flow: "confidence_data \u2192 verification_system",
    },
    {
      fromPort: "apoeIntegration",
      toSystem: "apoe.aiPoweredOrchestration",
      type: "provides_mission_profiles",
      data_flow: "mission_intent \u2192 orchestration_planning",
    },
    {
      fromPort: "segIntegration",
      toSystem: "seg.sharedEvidenceGraph",
      type: "synthesizes_knowledge",
      data_flow: "classification_data \u2192 knowledge_synthesis",
    },
    {
      fromPort: "sdfcvfIntegration",
      toSystem: "sdfcvf.atomicEvolution",
      type: "validates_changes",
      data_flow: "mission_changes \u2192 quality_validation",
    },
  ],
  riskOverlay: {
    perf_hotspots: [
      "classificationEngine",
      "enforcementLayer",
      "patternMatcher",
    ],
    security_sensitive_ports: [
      "userInput",
      "cmcIntegration",
      "vifIntegration",
    ],
    governance_touchpoints: [
      "enforcementLayer",
      "riskAssessor",
      "timelineIntegration",
    ],
    critical_failure_modes: [
      "Classification accuracy degradation",
      "Enforcement bypass or failure",
      "Risk assessment errors",
      "Timeline logging corruption",
    ],
    blast_radius: {
      classificationEngine: "all_decision_making",
      enforcementLayer: "action_authorization",
      riskAssessor: "safety_controls",
      timelineIntegration: "audit_trail_integrity",
    },
  },
  governance: {
    classification_accuracy: true,
    enforcement_integrity: true,
    risk_assessment_completeness: true,
    timeline_audit_completeness: true,
    decision_traceability: true,
  },
  monitoring: {
    key_metrics: [
      "classification_accuracy",
      "processing_latency",
      "enforcement_decision_rate",
      "risk_assessment_accuracy",
      "timeline_logging_success",
    ],
    alerts: [
      "classification_accuracy_drop",
      "processing_latency_exceeded",
      "enforcement_bypass_detected",
      "risk_assessment_failure",
      "timeline_logging_failure",
    ],
  },
  metadata: {
    created: "2025-10-30T00:00:00Z",
