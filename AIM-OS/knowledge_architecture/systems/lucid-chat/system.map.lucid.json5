      security_level: "critical",
    },
    {
      id: "retryManager",
      kind: "recovery.component",
      responsibility: "Retry logic with exponential backoff and max retry limits",
      status: "production",
      must_never: [
        "Allow infinite retries",
        "Skip retry limits",
        "Retry on fatal errors",
      ],
      perf_budget_ms: 50,
      security_level: "medium",
    },
    {
      id: "circuitBreaker",
      kind: "recovery.component",
      responsibility: "Circuit breaker pattern for stateful error handling and automatic recovery",
      status: "production",
      must_never: [
        "Skip circuit breaker logic",
        "Allow bypassing circuit",
        "Return stale circuit state",
      ],
      perf_budget_ms: 10,
      security_level: "medium",
    },
    {
      id: "errorRecovery",
      kind: "recovery.component",
      responsibility: "Error recovery orchestration with fallback strategies and graceful degradation",
      status: "production",
      must_never: [
        "Skip error recovery",
        "Allow unhandled errors",
        "Expose error details",
      ],
      perf_budget_ms: 100,
      security_level: "high",
    },
    {
      id: "cacheManager",
      kind: "optimization.component",
      responsibility: "In-memory caching with TTL and LRU eviction",
      status: "production",
      must_never: [
        "Allow unlimited cache growth",
        "Skip cache validation",
