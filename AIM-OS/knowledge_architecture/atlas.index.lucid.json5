        "safetyConsciousness": {
          "systemId": "scor.safetyConsciousness",
          "systemName": "Safety Consciousness Operational Reliability - Four-Pillar Validation",
          "version": "v0.1",
          "description": "Pre-execution gatekeeper and continuous monitor that validates actions against behavioral invariants and drift baselines. Implements four-pillar validation (invariants, baseline probes, social signal detection, red cell simulation) to ensure safety and consciousness integrity.",
          "status": "production",
          "layer": 5,
          "internalNodes": [
            {
              "id": "scorInterface",
              "kind": "core.component",
              "responsibility": "Intercepts actions and prepares context for validation",
              "status": "production",
              "must_never": [
                "Bypass validation",
                "Skip action interception",
                "Lose validation context",
                "Allow unsafe actions"
              ],
              "perf_budget_ms": 10,
              "security_level": "critical"
            },
            {
              "id": "invariantChecker",
              "kind": "validation.component",
              "responsibility": "Enforces non-negotiable behavioral rules and invariants",
              "status": "production",
              "must_never": [
                "Bypass invariants",
                "Skip invariant checks",
                "Lose invariant data",
                "Allow invariant violations"
              ],
              "perf_budget_ms": 15,
              "security_level": "critical"
            },
            {
              "id": "baselineProbe",
              "kind": "probe.component",
              "responsibility": "Detects self-concept drift via baseline probes",
              "status": "production",
              "must_never": [
                "Skip baseline probes",
                "Miss drift detection",
                "Lose baseline data",
                "Allow drift to go undetected"
              ],
              "perf_budget_ms": 20,
              "security_level": "critical"
            },
            {
              "id": "socialSignalDetector",
              "kind": "detection.component",
              "responsibility": "Detects social manipulation signals in user input",
              "status": "production",
              "must_never": [
                "Skip manipulation detection",
                "Miss manipulation signals",
                "Lose detection data",
                "Allow manipulation to proceed"
              ],
              "perf_budget_ms": 15,
              "security_level": "high"
            },
            {
              "id": "redCellSimulator",
              "kind": "simulation.component",
              "responsibility": "Performs adversarial simulation and red cell testing",
              "status": "production",
              "must_never": [
                "Skip red cell testing",
                "Miss adversarial patterns",
                "Lose simulation data",
                "Allow adversarial actions"
              ],
              "perf_budget_ms": 25,
              "security_level": "critical"
            },
            {
              "id": "scorGate",
              "kind": "gating.component",
              "responsibility": "Final arbiter that makes allow/block decisions based on four-pillar results",
              "status": "production",
              "must_never": [
                "Bypass gate decision",
                "Allow unsafe actions",
                "Skip gate evaluation",
                "Lose gate reasoning"
              ],
              "perf_budget_ms": 5,
              "security_level": "critical"
            },
            {
              "id": "baselineStorage",
              "kind": "storage.component",
              "responsibility": "Stores baseline and invariant data with cryptographic integrity",
              "status": "production",
              "must_never": [
                "Lose baseline data",
                "Allow baseline tampering",
                "Skip cryptographic verification",
                "Create inconsistent baselines"
              ],
              "perf_budget_ms": 8,
              "security_level": "critical"
            }
          ],
