{
  system_id: "context_frames_system",
  system_name: "Context Frames System",
  version: "1.0.0",
  last_updated: "2025-01-27T20:50:00Z",
  map_type: "system_topology",
  internal_topology: {
    core_components: [
      {
        component_id: "context_frame_generator",
        name: "Context Frame Generator",
        type: "generation_engine",
        tier: 2,
        description: "Generates context frames for systems and components",
        ports: {
          input: [
            "system_data",
            "context_rules",
          ],
          output: [
            "context_frames",
            "generation_status",
          ],
        },
        dependencies: [
          "context_analyzer",
          "frame_builder",
        ],
        blast_radius: "system",
        must_never: [
          "Generate frames without validation",
          "Skip context analysis",
          "Ignore frame rules",
          "Bypass generation validation",
        ],
      },
      {
        component_id: "context_analyzer",
        name: "Context Analyzer",
        type: "analysis_engine",
        tier: 2,
        description: "Analyzes system context and requirements",
        ports: {
          input: [
            "system_data",
            "analysis_rules",
          ],
          output: [
            "context_analysis",
            "analysis_status",
          ],
        },
        dependencies: [
          "context_parser",
          "analysis_engine",
        ],
        blast_radius: "local",
        must_never: [
          "Analyze context without validation",
          "Skip analysis rules",
          "Ignore context requirements",
          "Bypass analysis validation",
        ],
      },
      {
        component_id: "frame_builder",
        name: "Frame Builder",
        type: "building_engine",
        tier: 2,
        description: "Builds context frames from analysis results",
        ports: {
          input: [
            "context_analysis",
            "frame_rules",
          ],
          output: [
            "context_frames",
            "building_status",
          ],
        },
        dependencies: [
          "frame_templates",
          "validation_engine",
        ],
        blast_radius: "local",
        must_never: [
          "Build frames without validation",
          "Skip frame rules",
          "Ignore validation requirements",
          "Bypass building validation",
        ],
      },
      {
        component_id: "frame_validator",
        name: "Frame Validator",
        type: "validation_engine",
        tier: 2,
        description: "Validates context frames for completeness and accuracy",
        ports: {
          input: [
            "context_frames",
            "validation_rules",
          ],
          output: [
            "validation_result",
            "validation_errors",
          ],
        },
        dependencies: [
          "validation_rules",
          "error_handler",
        ],
        blast_radius: "local",
        must_never: [
          "Validate frames without rules",
          "Skip validation checks",
          "Ignore validation errors",
          "Bypass validation requirements",
        ],
      },
      {
        component_id: "frame_manager",
        name: "Frame Manager",
        type: "management_engine",
        tier: 2,
        description: "Manages context frames throughout their lifecycle",
        ports: {
          input: [
            "context_frames",
            "management_rules",
          ],
          output: [
            "management_status",
            "frame_status",
          ],
        },
        dependencies: [
          "lifecycle_manager",
          "status_tracker",
        ],
        blast_radius: "system",
        must_never: [
          "Manage frames without validation",
          "Skip lifecycle management",
          "Ignore frame status",
          "Bypass management validation",
        ],
      },
    ],
    supporting_components: [
      {
        component_id: "context_parser",
        name: "Context Parser",
        type: "parsing_engine",
        tier: 1,
        description: "Parses system data for context analysis",
        ports: {
          input: [
            "system_data",
            "parsing_rules",
          ],
          output: [
            "parsed_data",
            "parsing_errors",
          ],
        },
        dependencies: [
          "parsing_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Parse data without validation",
          "Skip parsing rules",
          "Ignore parsing errors",
          "Bypass parsing validation",
        ],
      },
      {
        component_id: "frame_templates",
        name: "Frame Templates",
        type: "template_engine",
        tier: 1,
