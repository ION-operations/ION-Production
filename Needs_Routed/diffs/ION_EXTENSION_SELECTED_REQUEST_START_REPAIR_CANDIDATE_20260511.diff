+function requestAgentStartSelected(requestPath: string): void {
+  const trimmed = requestPath.trim();
+  if (!trimmed) {
+    setBridgeStatus("Start selected blocked", "Paste a request_path before starting selected Codex work.", "error");
+    setBridgeAgentDetail("REQUEST_PATH_REQUIRED\nUse Agent → Queue or a copied receipt to paste the exact codex_work_requests/*.json path.");
+    return;
+  }
+  const detail = [
+    "Start selected Codex request",
+    `request_path: ${trimmed}`,
+    "",
+    "This starts the selected request path, not the queue head.",
+    "Production authority: false",
+    "Live execution authority: false",
+  ].join("\n");
+  setBridgeAgentDetail(detail);
+  setBridgeStatus("Start selected request", trimmed, "approval");
+  chrome.runtime.sendMessage({ type: "ion_chatops_agent_start_selected", payload: { request_path: trimmed } }, async (response) => {
+    const resultDetail = response?.ok ? compactJson(response.result) : blockedDetail(response);
+    setBridgeAgentDetail(resultDetail);
+    setBridgeStatus(response?.ok ? "Start selected submitted" : "Start selected blocked", resultDetail.split("\n")[0] ?? "", response?.ok ? "success" : "error");
+    if (response?.ok) await copyBridgeResult("Start selected Codex request", resultDetail);
+  });
+}
+
 function inactiveQueueStatus(status: string): boolean {
