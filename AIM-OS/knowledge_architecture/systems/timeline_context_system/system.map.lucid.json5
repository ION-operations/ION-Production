    {
      id: "timelineTracker",
      kind: "core.component",
      responsibility: "Tracks timeline nodes and interactions between nodes",
      status: "production",
      must_never: [
        "Lose timeline nodes",
        "Skip interaction tracking",
        "Create timeline inconsistencies",
        "Allow timeline corruption",
      ],
      perf_budget_ms: 15,
      security_level: "high",
    },
    {
      id: "consciousnessJournaler",
