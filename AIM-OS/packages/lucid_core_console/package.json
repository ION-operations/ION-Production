{
  "name": "lucid-core-console",
  "displayName": "Lucid Core Console - Aether's Command Interface",
  "description": "VS Code/Cursor extension providing Aether's command interface with voice I/O, phone remote control, and hard gates on file mutations",
  "version": "0.1.0",
  "publisher": "aether-ai",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "AI"
  ],
  "keywords": [
    "ai",
    "consciousness",
    "voice",
    "remote-control",
    "daemon"
  ],
  "activationEvents": [
    "onView:lucidCoreConsole"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "lucidCoreConsolePanel",
          "title": "Lucid Core Console",
          "icon": "resources/aether-icon.svg"
        }
      ]
    },
    "views": {
      "lucidCoreConsolePanel": [
        {
          "id": "lucidCoreConsoleView",
          "name": "Aether Console",
          "when": "true"
        }
      ]
    },
    "commands": [
      {
        "command": "lucidCore.voiceInput",
        "title": "Start Voice Input",
        "icon": "$(mic)"
      },
      {
        "command": "lucidCore.phonePairing",
        "title": "Start Phone Pairing",
        "icon": "$(device-mobile)"
      },
      {
        "command": "lucidCore.forceEdit",
        "title": "Force Edit (Override Gates)",
        "icon": "$(warning)"
      },
      {
        "command": "lucidCore.approveChange",
        "title": "Approve Change",
        "icon": "$(check)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lucidCore.voiceInput",
          "when": "view == lucidCoreConsoleView",
          "group": "navigation"
        },
        {
          "command": "lucidCore.phonePairing",
          "when": "view == lucidCoreConsoleView",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "lucidCore.forceEdit",
          "when": "editorTextFocus",
          "group": "lucidCore"
        }
      ]
    },
    "configuration": {
      "title": "Lucid Core Console",
      "properties": {
        "lucidCore.daemonHost": {
          "type": "string",
          "default": "localhost",
          "description": "Daemon host address"
        },
        "lucidCore.daemonPort": {
          "type": "number",
          "default": 8080,
          "description": "Daemon port number"
        },
        "lucidCore.voiceEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable voice input/output"
        },
        "lucidCore.phoneRemoteEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable phone remote control"
        },
        "lucidCore.hardGatesEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable hard gates on file mutations"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "typescript": "^4.9.4",
    "@vscode/test-electron": "^2.2.0"
  },
  "dependencies": {
    "ws": "^8.14.2"
  }
}
