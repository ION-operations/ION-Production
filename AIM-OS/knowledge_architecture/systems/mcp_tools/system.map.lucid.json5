{
  system_id: "mcp_tools",
  system_name: "MCP Tools",
  version: "1.0.0",
  last_updated: "2025-01-27T20:50:00Z",
  map_type: "system_topology",
  internal_topology: {
    core_components: [
      {
        component_id: "tool_registry",
        name: "Tool Registry",
        type: "registry_engine",
        tier: 2,
        description: "Registers and manages all MCP tools",
        ports: {
          input: [
            "tool_registrations",
            "registry_rules",
          ],
          output: [
            "registered_tools",
            "registry_status",
          ],
        },
        dependencies: [
          "registry_rules",
          "tool_validator",
        ],
        blast_radius: "platform",
        must_never: [
          "Register tools without validation",
          "Skip registry rules",
          "Ignore tool requirements",
          "Bypass registry validation",
        ],
      },
      {
        component_id: "tool_executor",
        name: "Tool Executor",
        type: "execution_engine",
        tier: 2,
        description: "Executes MCP tools and manages their lifecycle",
        ports: {
          input: [
            "execution_requests",
            "execution_rules",
          ],
          output: [
            "execution_results",
            "execution_status",
          ],
        },
        dependencies: [
          "execution_rules",
          "lifecycle_manager",
        ],
        blast_radius: "platform",
        must_never: [
          "Execute tools without validation",
          "Skip execution rules",
          "Ignore tool requirements",
          "Bypass execution validation",
        ],
      },
      {
        component_id: "tool_selector",
        name: "Tool Selector",
        type: "selection_engine",
        tier: 2,
        description: "Selects appropriate MCP tools based on context",
        ports: {
          input: [
            "selection_requests",
            "selection_rules",
          ],
          output: [
            "selected_tools",
            "selection_reasoning",
          ],
        },
        dependencies: [
          "selection_rules",
          "context_analyzer",
        ],
        blast_radius: "platform",
        must_never: [
          "Select tools without validation",
          "Skip selection rules",
          "Ignore context requirements",
          "Bypass selection validation",
        ],
      },
      {
        component_id: "tool_monitor",
        name: "Tool Monitor",
        type: "monitoring_engine",
        tier: 2,
        description: "Monitors MCP tool performance and health",
        ports: {
          input: [
            "monitoring_requests",
            "monitoring_rules",
          ],
          output: [
            "monitoring_reports",
            "tool_metrics",
          ],
        },
        dependencies: [
          "monitoring_rules",
          "metrics_collector",
        ],
        blast_radius: "platform",
        must_never: [
          "Monitor tools without validation",
          "Skip monitoring rules",
          "Ignore tool requirements",
          "Bypass monitoring validation",
        ],
      },
      {
        component_id: "tool_optimizer",
        name: "Tool Optimizer",
        type: "optimization_engine",
        tier: 2,
        description: "Optimizes MCP tool usage and performance",
        ports: {
          input: [
            "optimization_requests",
            "optimization_rules",
          ],
          output: [
            "optimization_plans",
            "optimization_results",
          ],
        },
        dependencies: [
          "optimization_rules",
          "performance_analyzer",
        ],
        blast_radius: "platform",
        must_never: [
          "Optimize tools without validation",
          "Skip optimization rules",
          "Ignore performance requirements",
          "Bypass optimization validation",
        ],
      },
    ],
    supporting_components: [
      {
        component_id: "tool_validator",
        name: "Tool Validator",
        type: "validation_engine",
        tier: 1,
        description: "Validates MCP tools for correctness and safety",
        ports: {
          input: [
            "validation_requests",
            "validation_rules",
          ],
          output: [
            "validation_results",
            "validation_status",
          ],
        },
        dependencies: [
          "validation_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Validate tools without validation",
          "Skip validation rules",
          "Ignore validation requirements",
          "Bypass validation validation",
        ],
      },
      {
        component_id: "lifecycle_manager",
        name: "Lifecycle Manager",
        type: "lifecycle_engine",
        tier: 1,
        description: "Manages MCP tool lifecycle and versioning",
        ports: {
          input: [
            "lifecycle_requests",
            "lifecycle_rules",
          ],
          output: [
            "lifecycle_events",
            "lifecycle_status",
          ],
        },
        dependencies: [
          "lifecycle_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Manage lifecycle without validation",
          "Skip lifecycle rules",
          "Ignore lifecycle requirements",
          "Bypass lifecycle validation",
        ],
      },
      {
        component_id: "context_analyzer",
        name: "Context Analyzer",
        type: "analysis_engine",
        tier: 1,
        description: "Analyzes context for tool selection",
        ports: {
          input: [
            "context_requests",
            "analysis_rules",
          ],
          output: [
            "context_analysis",
            "analysis_status",
          ],
        },
        dependencies: [
          "analysis_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Analyze context without validation",
          "Skip analysis rules",
          "Ignore analysis requirements",
          "Bypass analysis validation",
        ],
      },
      {
        component_id: "metrics_collector",
        name: "Metrics Collector",
        type: "collection_engine",
        tier: 1,
        description: "Collects metrics for tool monitoring",
        ports: {
          input: [
            "collection_requests",
            "collection_rules",
          ],
          output: [
            "collected_metrics",
            "collection_status",
          ],
        },
        dependencies: [
          "collection_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Collect metrics without validation",
          "Skip collection rules",
          "Ignore collection requirements",
          "Bypass collection validation",
        ],
      },
      {
        component_id: "performance_analyzer",
        name: "Performance Analyzer",
        type: "analysis_engine",
        tier: 1,
        description: "Analyzes tool performance for optimization",
        ports: {
          input: [
            "performance_requests",
            "analysis_rules",
          ],
          output: [
            "performance_analysis",
            "analysis_status",
          ],
        },
        dependencies: [
          "analysis_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Analyze performance without validation",
          "Skip analysis rules",
          "Ignore performance requirements",
          "Bypass analysis validation",
        ],
      },
    ],
  },
  boundary_tendrils: {
