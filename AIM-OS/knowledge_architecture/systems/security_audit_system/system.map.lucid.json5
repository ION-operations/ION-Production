      },
      {
        port_id: "security_reports_output",
        name: "Security Reports Output",
        type: "data_output",
        protocol: "json",
        description: "Outputs security reports and recommendations",
        required: true,
        validation: "security_reports_schema",
      },
      {
        port_id: "vulnerability_reports_output",
        name: "Vulnerability Reports Output",
        type: "data_output",
        protocol: "json",
        description: "Outputs vulnerability reports",
        required: true,
        validation: "vulnerability_reports_schema",
      },
    ],
  },
  data_flow: {
    primary_flow: [
      {
        step: 1,
        component: "vulnerability_scanner",
        action: "Scan for vulnerabilities",
        input: [
          "scan_requests",
          "vulnerability_rules",
        ],
        output: [
          "vulnerability_reports",
          "scan_results",
        ],
      },
      {
        step: 2,
        component: "compliance_checker",
        action: "Check compliance",
        input: [
          "compliance_requests",
          "compliance_rules",
        ],
        output: [
          "compliance_reports",
          "compliance_status",
        ],
      },
      {
        step: 3,
        component: "threat_analyzer",
        action: "Analyze threats",
        input: [
          "threat_data",
          "analysis_rules",
        ],
        output: [
          "threat_analysis",
          "risk_assessment",
        ],
      },
      {
        step: 4,
        component: "security_audit_engine",
        action: "Perform security audit",
        input: [
          "audit_requests",
          "security_policies",
        ],
        output: [
          "audit_results",
          "security_reports",
        ],
      },
      {
        step: 5,
        component: "security_reporter",
        action: "Generate security reports",
        input: [
          "audit_data",
          "reporting_rules",
        ],
        output: [
          "security_reports",
          "recommendations",
        ],
      },
    ],
    secondary_flows: [
      {
        flow_name: "vulnerability_scanning",
        components: [
          "vulnerability_scanner",
          "vulnerability_database",
          "scanning_rules",
        ],
        description: "Scans systems for security vulnerabilities",
      },
      {
        flow_name: "compliance_checking",
        components: [
