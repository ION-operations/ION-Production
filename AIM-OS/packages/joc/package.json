{
    "name": "joc",
    "version": "0.1.0",
    "description": "Joint Operations Center — Browser-based AIM-OS command surface",
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "vite --port 5011",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "electron:dev": "concurrently \"vite --port 5011\" \"wait-on http://localhost:5011 && electron electron/main.cjs\"",
        "electron:build": "tsc && vite build && electron-builder"
    },
    "dependencies": {
        "@monaco-editor/react": "^4.7.0",
        "monaco-editor": "^0.55.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "zustand": "^5.0.8"
    },
    "devDependencies": {
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.1",
        "concurrently": "^9.1.0",
        "electron": "^39.0.0",
        "typescript": "^5.2.2",
        "vite": "^5.2.0",
        "wait-on": "^8.0.0"
    },
    "author": "Claude Opus 4.6 + Braden",
    "license": "MIT"
}
