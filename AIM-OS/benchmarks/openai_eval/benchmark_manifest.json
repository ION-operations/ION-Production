{
  "schema_version": "1.0",
  "name": "aimos_openai_eval_pack",
  "description": "Reproducible benchmark task suite for baseline vs AIM-OS-assisted comparison.",
  "profiles": {
    "smoke": [
      {
        "id": "mcp_parity",
        "name": "MCP parity check",
        "parse": "json_stdout",
        "timeout_seconds": 120,
        "command": [
          "{python}",
          "scripts/check_mcp_tool_parity.py"
        ]
      },
      {
        "id": "mcp_parity_tests",
        "name": "MCP parity pytest guardrails",
        "parse": "pytest",
        "timeout_seconds": 300,
        "command": [
          "{python}",
          "-m",
          "pytest",
          "tests/test_mcp_tool_surface_parity.py",
          "-q",
          "-o",
          "addopts=''"
        ]
      },
      {
        "id": "apoe_streaming_tests",
        "name": "APOE streaming subset",
        "parse": "pytest",
        "timeout_seconds": 600,
        "command": [
          "{python}",
          "-m",
          "pytest",
          "packages/apoe/tests/test_streaming.py",
          "-q",
          "-o",
          "addopts=''"
        ]
      },
      {
        "id": "seg_models_tests",
        "name": "SEG models subset",
        "parse": "pytest",
        "timeout_seconds": 600,
        "command": [
          "{python}",
          "-m",
          "pytest",
          "packages/seg/tests/test_models.py",
          "-q",
          "-o",
          "addopts=''"
        ]
      },
      {
        "id": "sdfcvf_parity_tests",
        "name": "SDF-CVF parity subset",
        "parse": "pytest",
        "timeout_seconds": 600,
        "command": [
          "{python}",
          "-m",
          "pytest",
          "packages/sdfcvf/tests/test_parity.py",
          "-q",
          "-o",
          "addopts=''"
        ]
      },
      {
        "id": "hhni_perf_mini",
        "name": "HHNI performance mini benchmark",
        "parse": "none",
        "timeout_seconds": 900,
        "output_json": "artifacts/hhni_perf_mini.json",
        "command": [
          "{python}",
          "benchmarks/hhni_performance.py",
          "--atoms",
          "20",
          "--backend",
          "sqlite",
          "--output",
          "{task_output}"
        ]
      },
      {
        "id": "hhni_retrieval_mini",
        "name": "HHNI retrieval mini benchmark",
        "parse": "none",
        "timeout_seconds": 900,
        "output_json": "artifacts/hhni_retrieval_mini.json",
        "command": [
          "{python}",
          "benchmarks/hhni_retrieval_benchmark.py",
          "--queries",
          "5",
          "--corpus",
          "20",
          "--provider",
          "fallback",
          "--coarse-k",
          "20",
          "--dvns-iterations",
          "5",
          "--token-budget",
          "1200",
          "--output",
          "{task_output}"
        ]
      }
    ],
    "quick": [
