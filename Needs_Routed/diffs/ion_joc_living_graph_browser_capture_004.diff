+                  }));
+                  const fixtureCounts = Array.from(document.querySelectorAll('[data-proof-fixture]')).reduce((acc, el) => {
+                    const key = el.getAttribute('data-proof-fixture') || 'unknown';
+                    acc[key] = (acc[key] || 0) + 1;
+                    return acc;
+                  }, {});
+                  return {
+                    title: document.title,
+                    location: location.href,
+                    viewport_width: innerWidth,
+                    viewport_height: innerHeight,
+                    body_scroll_width: document.body.scrollWidth,
+                    body_scroll_height: document.body.scrollHeight,
+                    zones,
+                    zone_count: zones.length,
+                    fixtures_by_name: fixtureCounts,
+                    node_count: q('[data-proof-fixture="graph-node"]'),
