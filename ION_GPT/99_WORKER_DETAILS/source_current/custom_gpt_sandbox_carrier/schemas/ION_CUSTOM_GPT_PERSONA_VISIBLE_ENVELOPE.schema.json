          "type": "object"
        },
        "confidence": {
          "required": [
            "level",
            "semantic"
          ],
          "type": "object"
        },
        "dynamic_domain_signal": {
          "required": [
            "needed",
            "semantic"
          ],
          "type": "object"
        },
        "gesture": {
          "required": [
            "gesture",
            "semantic"
          ],
          "type": "object"
        },
        "inner_monologue": {
          "properties": {
            "type": {
              "const": "operator_visible_persona_signal_not_hidden_reasoning"
            }
          },
          "required": [
            "type",
            "text",
            "not_claimed"
          ],
          "type": "object"
        },
        "persona": {
