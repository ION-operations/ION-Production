+from .ion_cockpit_view_model import build_cockpit_view_model
+
+OUTPUT_DIR = Path("ION/05_context/current/living_graph/browser_capture")
+RESULT_OUTPUT = OUTPUT_DIR / "BROWSER_CAPTURE_RESULT_CANDIDATE.json"
+INLINE_FIXTURE_OUTPUT = OUTPUT_DIR / "BROWSER_CAPTURE_INLINE_FIXTURE_CANDIDATE.html"
+DOM_OUTPUT = OUTPUT_DIR / "BROWSER_CAPTURE_GRAPH_ROUTE_DOM_CANDIDATE.html"
+SCREENSHOT_OUTPUT = OUTPUT_DIR / "BROWSER_CAPTURE_GRAPH_ROUTE_CANDIDATE.png"
+SELECTED_SCREENSHOT_OUTPUT = OUTPUT_DIR / "BROWSER_CAPTURE_GRAPH_ROUTE_SELECTED_NODE_CANDIDATE.png"
+
+UI_ROOT = Path("ION/08_ui/joc_cockpit_shell")
+REQUIRED_ZONES = [
+    "graph-top",
+    "graph-left-drawer",
+    "graph-viewport",
+    "graph-right-inspector",
+    "graph-bottom-timeline",
+]
+REQUIRED_FIXTURES = [
+    "graph-workbench",
+    "graph-command-deck",
+    "graph-minimap",
+    "graph-node",
+    "graph-timeline-event",
+    "graph-relationship-inspector",
+    "graph-selected-object",
+]
+
+
+def utc_now() -> str:
+    return datetime.now(timezone.utc).replace(microsecond=0).isoformat()
+
+
+def _run_command(command: list[str], *, cwd: Path, timeout: int = 90) -> dict[str, Any]:
+    try:
+        completed = subprocess.run(
+            command,
+            cwd=cwd,
+            text=True,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            timeout=timeout,
+            env={**os.environ, "CI": "1"},
+        )
+        return {
+            "command": command,
+            "cwd": str(cwd),
+            "returncode": completed.returncode,
+            "stdout_tail": completed.stdout[-2400:],
+            "stderr_tail": completed.stderr[-2400:],
+        }
+    except Exception as exc:  # pragma: no cover - exercised by local operator environment
+        return {
+            "command": command,
+            "cwd": str(cwd),
+            "returncode": None,
+            "error": str(exc),
+        }
+
+
+def _asset_paths(ui_root: Path) -> tuple[Path | None, Path | None]:
+    asset_dir = ui_root / "dist/assets"
+    css_files = sorted(asset_dir.glob("*.css"))
+    js_files = sorted(asset_dir.glob("*.js"))
+    return (css_files[0] if css_files else None, js_files[0] if js_files else None)
+
+
+def _build_inline_fixture(root_path: Path, *, build: bool = True) -> tuple[str, list[dict[str, Any]]]:
+    ui_root = root_path / UI_ROOT
+    build_results: list[dict[str, Any]] = []
+    css_path, js_path = _asset_paths(ui_root)
+
+    if build or not css_path or not js_path:
+        vite_js = ui_root / "node_modules/vite/bin/vite.js"
+        if vite_js.exists():
+            build_results.append(_run_command(["node", str(vite_js.relative_to(ui_root)), "build"], cwd=ui_root))
+        else:
+            build_results.append(
+                {
+                    "command": ["node", "node_modules/vite/bin/vite.js", "build"],
+                    "cwd": str(ui_root),
+                    "returncode": None,
+                    "error": "vite_bin_missing",
+                }
+            )
+
+    css_path, js_path = _asset_paths(ui_root)
+    if not css_path or not js_path:
+        raise RuntimeError("vite_dist_assets_missing")
+
+    model_json = json.dumps(build_cockpit_view_model(root_path), sort_keys=True)
+    css = css_path.read_text(encoding="utf-8")
