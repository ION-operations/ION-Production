  ports: [
    {
      portId: "apoeIntegration",
      direction: "bidirectional",
      connectsToSystem: "apoe.aiPoweredOrchestration",
      protocol: "internal_api",
      whatIsExchanged: [
        "decision_events",
        "execution_context",
        "plan_analysis",
        "cognitive_state",
      ],
      security_level: "high",
    },
    {
      portId: "vifIntegration",
      direction: "bidirectional",
      connectsToSystem: "vif.verifiableIntelligence",
      protocol: "internal_api",
      whatIsExchanged: [
        "confidence_scores",
        "provenance_data",
        "verification_results",
        "cognitive_metrics",
      ],
      security_level: "high",
    },
    {
      portId: "hhniIntegration",
      direction: "bidirectional",
      connectsToSystem: "hhni.hierarchicalHypergraph",
      protocol: "internal_api",
      whatIsExchanged: [
        "context_queries",
        "retrieval_context",
        "activation_context",
        "cognitive_load_data",
      ],
      security_level: "medium",
    },
    {
      portId: "cmcIntegration",
      direction: "bidirectional",
      connectsToSystem: "cmc.contextMemoryCore",
      protocol: "internal_api",
      whatIsExchanged: [
        "decision_logs",
        "learning_entries",
        "analysis_reports",
        "cognitive_state_snapshots",
      ],
      security_level: "high",
    },
    {
      portId: "sdfcvfIntegration",
      direction: "bidirectional",
      connectsToSystem: "sdfcvf.atomicEvolution",
      protocol: "internal_api",
      whatIsExchanged: [
        "quality_metrics",
        "failure_patterns",
        "evolution_recommendations",
        "cognitive_analysis",
      ],
      security_level: "medium",
    },
    {
      portId: "segIntegration",
      direction: "bidirectional",
      connectsToSystem: "seg.sharedEvidenceGraph",
      protocol: "general_api",
      whatIsExchanged: [
        "cognitive_connections",
        "evidence_nodes",
        "graph_queries",
        "synthesis_insights",
      ],
      security_level: "medium",
      note: "Uses SEG general API (no formal port, documented as relatedSystem)",
    },
    {
      portId: "tcsIntegration",
      direction: "bidirectional",
      connectsToSystem: "tcs.timelineContextSystem",
      protocol: "internal_api",
      whatIsExchanged: [
        "timeline_entries",
        "meta_pattern_analysis",
        "cognitive_metrics",
        "timeline_queries",
      ],
      security_level: "medium",
    },
    {
      portId: "iisIntegration",
      direction: "bidirectional",
      connectsToSystem: "iis.intuitiveIntelligenceSystem",
      protocol: "internal_api",
      whatIsExchanged: [
        "intuition_patterns",
        "audit_analysis",
        "audit_results",
        "pattern_validation",
      ],
      security_level: "low",
      note: "IIS is separate system, CAS monitors it",
    },
  ],
  internalEdges: [
    {
      from: "activationTracker",
      to: "categoryRecognizer",
      type: "provides_activation_state",
      data_flow: "activation_levels \u2192 category_analysis",
    },
    {
      from: "categoryRecognizer",
      to: "attentionMonitor",
      type: "provides_category_data",
      data_flow: "category_results \u2192 attention_analysis",
    },
    {
      from: "attentionMonitor",
      to: "failureModeDetector",
      type: "provides_attention_metrics",
      data_flow: "attention_data \u2192 failure_detection",
    },
    {
      from: "failureModeDetector",
      to: "learningExtractor",
      type: "provides_failure_patterns",
      data_flow: "failure_data \u2192 learning_extraction",
    },
    {
      from: "learningExtractor",
      to: "introspectionEngine",
      type: "provides_learnings",
      data_flow: "learnings \u2192 introspection_analysis",
    },
    {
      from: "introspectionEngine",
      to: "decisionLogger",
      type: "provides_introspection_data",
      data_flow: "introspection_results \u2192 decision_logging",
    },
    {
      from: "decisionLogger",
      to: "all_components",
      type: "provides_logging",
      data_flow: "log_events \u2192 all_operations",
    },
  ],
  externalEdges: [
    {
      fromPort: "apoeIntegration",
      toSystem: "apoe.aiPoweredOrchestration",
      type: "observes_decisions",
      pattern: "observe",
      connectionType: "observation",
      data_flow: "execution_events → cognitive_analysis, cognitive_state ← introspection_results",
      bidirectional: true,
      tags: ["APOE-OBSERVE", "CAS-META"],
    },
    {
      fromPort: "vifIntegration",
