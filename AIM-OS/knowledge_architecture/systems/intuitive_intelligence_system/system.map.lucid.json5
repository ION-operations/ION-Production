{
  systemId: "iis.intuitiveIntelligence",
  systemName: "Intuitive Intelligence System - AI Intuition and Learning",
  version: "v0.1",
  description: "Operational definition and learning loop for AI intuition. Computes IntuitionScore for candidate actions using calibrated confidence (VIF), retrieval quality (HHNI), meta-pattern similarity (CAS/timeline), emotional salience (TCS), and 4D evolution alignment. Learns online from outcomes and maintains auditability through CAS.",
  internalNodes: [
    {
      id: "intuitionCalculator",
      kind: "core.component",
      responsibility: "Computes IntuitionScore using feature vector (C', RS, M, E, F, U)",
      status: "production",
      must_never: [
        "Skip intuition calculation",
        "Use uncalibrated confidence",
        "Lose intuition reasoning",
        "Allow intuition override of safety",
      ],
      perf_budget_ms: 20,
      security_level: "high",
    },
    {
      id: "featureExtractor",
      kind: "extraction.component",
      responsibility: "Extracts intuition features (calibrated confidence, retrieval strength, meta-pattern similarity, emotional salience, 4D evolution alignment)",
      status: "production",
      must_never: [
        "Lose feature data",
        "Skip feature extraction",
        "Create incorrect features",
        "Allow feature corruption",
      ],
      perf_budget_ms: 15,
      security_level: "medium",
    },
    {
      id: "learningEngine",
      kind: "learning.component",
      responsibility: "Learns online from labeled outcomes (success/failure) using SGD",
      status: "production",
      must_never: [
        "Lose learning data",
        "Skip learning updates",
        "Create false learnings",
        "Allow learning degradation",
      ],
      perf_budget_ms: 25,
      security_level: "medium",
    },
    {
      id: "calibrationTracker",
      kind: "tracking.component",
      responsibility: "Tracks calibration metrics (AUC, ECE) and detects drift",
      status: "production",
      must_never: [
        "Lose calibration data",
        "Skip calibration tracking",
        "Allow calibration drift",
        "Create inconsistent calibration",
      ],
      perf_budget_ms: 10,
      security_level: "high",
    },
    {
      id: "evolutionPredictor",
      kind: "prediction.component",
      responsibility: "Predicts 4D evolution (AI state, user state, collaboration state) for alignment scoring",
      status: "development",
      must_never: [
        "Lose prediction data",
        "Skip evolution prediction",
        "Create incorrect predictions",
        "Allow prediction degradation",
      ],
      perf_budget_ms: 30,
      security_level: "medium",
    },
    {
      id: "intuitionTraceGenerator",
      kind: "trace.component",
      responsibility: "Generates IntuitionTrace records with full provenance",
      status: "production",
      must_never: [
        "Lose trace data",
        "Skip trace generation",
        "Create incomplete traces",
        "Allow trace tampering",
      ],
      perf_budget_ms: 8,
      security_level: "critical",
    },
    {
      id: "metaPatternAnalyzer",
      kind: "analysis.component",
      responsibility: "Analyzes meta-pattern similarity to past successful decisions",
      status: "production",
      must_never: [
        "Lose pattern data",
        "Skip pattern analysis",
        "Create false patterns",
        "Allow pattern degradation",
      ],
      perf_budget_ms: 20,
      security_level: "medium",
    },
  ],
  ports: [
    {
      portId: "vifIntegration",
      direction: "bidirectional",
      connectsToSystem: "vif.verifiableIntelligence",
      protocol: "internal_api",
      whatIsExchanged: [
        "calibrated_confidence",
        "confidence_scores",
        "provenance_data",
        "intuition_traces",
      ],
      security_level: "critical",
    },
    {
      portId: "hhniIntegration",
      direction: "bidirectional",
      connectsToSystem: "hhni.hierarchicalHypergraph",
      protocol: "internal_api",
      whatIsExchanged: [
        "retrieval_strength",
        "retrieval_scores",
        "context_quality",
        "intuition_features",
      ],
      security_level: "high",
    },
    {
      portId: "casIntegration",
      direction: "bidirectional",
      connectsToSystem: "cas.cognitiveAnalysis",
      protocol: "internal_api",
      whatIsExchanged: [
        "meta_pattern_data",
        "cognitive_metrics",
        "intuition_traces",
        "learning_insights",
      ],
      security_level: "high",
    },
    {
      portId: "tcsIntegration",
      direction: "bidirectional",
      connectsToSystem: "tcs.timelineContext",
      protocol: "internal_api",
      whatIsExchanged: [
        "emotional_salience",
        "timeline_patterns",
        "consciousness_data",
        "intuition_context",
      ],
      security_level: "medium",
    },
    {
      portId: "cmcIntegration",
      direction: "bidirectional",
      connectsToSystem: "cmc.contextMemoryCore",
      protocol: "internal_api",
      whatIsExchanged: [
        "intuition_traces",
        "learning_data",
        "calibration_snapshots",
        "intuition_metadata",
      ],
      security_level: "high",
    },
  ],
  internalEdges: [
    {
      from: "featureExtractor",
      to: "intuitionCalculator",
      type: "provides_features",
      data_flow: "feature_vector \u2192 intuition_calculation",
    },
    {
      from: "metaPatternAnalyzer",
      to: "featureExtractor",
      type: "provides_pattern_data",
      data_flow: "pattern_similarity \u2192 feature_extraction",
    },
    {
      from: "evolutionPredictor",
      to: "featureExtractor",
      type: "provides_evolution_data",
      data_flow: "evolution_prediction \u2192 feature_extraction",
    },
    {
      from: "intuitionCalculator",
      to: "intuitionTraceGenerator",
      type: "provides_intuition_score",
      data_flow: "intuition_score \u2192 trace_generation",
    },
    {
      from: "intuitionTraceGenerator",
      to: "learningEngine",
      type: "provides_traces",
      data_flow: "traces \u2192 learning_input",
    },
    {
      from: "learningEngine",
      to: "calibrationTracker",
      type: "provides_learning_updates",
      data_flow: "learning_updates \u2192 calibration_tracking",
    },
    {
      from: "calibrationTracker",
      to: "intuitionCalculator",
      type: "provides_calibration",
      data_flow: "calibration_data \u2192 intuition_calculation",
    },
  ],
  externalEdges: [
    {
      fromPort: "vifIntegration",
      toSystem: "vif.verifiableIntelligence",
      type: "retrieves_calibrated_confidence",
      data_flow: "confidence_queries \u2192 calibrated_confidence",
    },
    {
      fromPort: "hhniIntegration",
      toSystem: "hhni.hierarchicalHypergraph",
      type: "calculates_retrieval_strength",
      data_flow: "retrieval_queries \u2192 retrieval_strength",
    },
    {
      fromPort: "casIntegration",
      toSystem: "cas.cognitiveAnalysis",
      type: "analyzes_meta_patterns",
      data_flow: "decision_patterns \u2192 meta_pattern_analysis",
    },
    {
      fromPort: "tcsIntegration",
      toSystem: "tcs.timelineContext",
      type: "retrieves_emotional_salience",
      data_flow: "timeline_queries \u2192 emotional_salience",
    },
    {
      fromPort: "cmcIntegration",
      toSystem: "cmc.contextMemoryCore",
      type: "stores_intuition_data",
      data_flow: "intuition_data \u2192 persistent_storage",
    },
  ],
  riskOverlay: {
    perf_hotspots: [
      "learningEngine",
      "evolutionPredictor",
      "metaPatternAnalyzer",
    ],
    security_sensitive_ports: [
      "vifIntegration",
      "cmcIntegration",
      "casIntegration",
    ],
    governance_touchpoints: [
      "intuitionCalculator",
      "learningEngine",
      "calibrationTracker",
    ],
    critical_failure_modes: [
      "Intuition calculation failure",
      "Learning degradation",
      "Calibration drift",
      "Trace generation failure",
    ],
    blast_radius: {
      intuitionCalculator: "all_intuition_decisions",
      learningEngine: "intuition_learning",
      calibrationTracker: "intuition_calibration",
      intuitionTraceGenerator: "intuition_provenance",
    },
  },
  governance: {
    intuition_calculation: true,
    feature_extraction: true,
    online_learning: true,
    calibration_tracking: true,
    trace_generation: true,
    safety_gating: true,
  },
  monitoring: {
    key_metrics: [
      "intuition_score_accuracy",
      "calibration_auc",
      "calibration_ece",
      "learning_rate",
      "pattern_similarity_accuracy",
      "evolution_prediction_accuracy",
    ],
    alerts: [
      "intuition_calculation_failure",
      "calibration_drift_detected",
      "learning_degradation",
      "trace_generation_failure",
      "pattern_analysis_failure",
      "evolution_prediction_error",
    ],
  },
