      redCellSimulator: "adversarial_safety",
    },
  },
  governance: {
    invariant_enforcement: true,
    drift_detection: true,
    manipulation_detection: true,
    adversarial_simulation: true,
    gate_enforcement: true,
    baseline_integrity: true,
