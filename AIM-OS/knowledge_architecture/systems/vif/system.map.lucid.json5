{
  systemId: "vif.verifiableIntelligence",
  systemName: "Verifiable Intelligence Framework - Provenance and Confidence Tracking",
  version: "v2.2.0",
  status: "production",
  layer: 2,
  description: "Provenance and confidence tracking system that prevents hallucinations and ensures verifiable AI operations. Think 'AI's conscience' - tracks every decision, validates every claim, and maintains cryptographic proof of truth.",
  internalNodes: [
    {
      id: "confidenceTracker",
      kind: "core.component",
      responsibility: "Tracks confidence scores and calibration across all operations",
      status: "production",
      must_never: [
        "Allow confidence scores without evidence",
        "Modify confidence scores after validation",
        "Track confidence without proper provenance",
      ],
      perf_budget_ms: 5,
      security_level: "critical",
    },
    {
      id: "witnessManager",
      kind: "core.component",
      responsibility: "Manages cryptographic witnesses for all AI operations",
      status: "production",
      must_never: [
        "Create witnesses without proper evidence",
        "Modify witnesses after creation",
        "Allow witness tampering",
      ],
      perf_budget_ms: 10,
      security_level: "critical",
    },
    {
      id: "provenanceEngine",
      kind: "core.component",
      responsibility: "Tracks complete provenance chain for all decisions and outputs",
      status: "production",
      must_never: [
        "Lose provenance information",
        "Create circular provenance chains",
        "Allow provenance tampering",
      ],
      perf_budget_ms: 15,
      security_level: "high",
    },
    {
      id: "validationEngine",
      kind: "validation.component",
      responsibility: "Validates AI outputs against confidence claims and evidence",
      status: "production",
      must_never: [
        "Skip validation for high-confidence claims",
        "Accept validation without proper evidence",
        "Allow false positive validations",
      ],
      perf_budget_ms: 20,
      security_level: "high",
    },
    {
      id: "replayEngine",
      kind: "replay.component",
      responsibility: "Enables deterministic replay of AI operations for verification",
      status: "production",
      must_never: [
        "Lose replay state information",
        "Allow non-deterministic replay",
        "Expose sensitive data during replay",
      ],
      perf_budget_ms: 25,
      security_level: "high",
    },
    {
      id: "eceCalculator",
      kind: "metrics.component",
      responsibility: "Calculates Expected Calibration Error (ECE) for confidence calibration",
      status: "production",
      must_never: [
        "Calculate ECE with insufficient data",
        "Modify ECE calculations after validation",
        "Expose calibration data inappropriately",
      ],
      perf_budget_ms: 10,
      security_level: "medium",
    },
    {
      id: "kappaGating",
      kind: "gating.component",
      responsibility: "Implements Cohen's Kappa gating for inter-annotator agreement",
      status: "production",
      must_never: [
        "Gate operations without proper agreement",
        "Allow low-agreement operations to proceed",
        "Modify kappa thresholds without approval",
      ],
      perf_budget_ms: 8,
      security_level: "medium",
    },
    {
      id: "rsLiftCalculator",
      kind: "metrics.component",
      responsibility: "Calculates RS-Lift metrics for retrieval system performance",
      status: "production",
      must_never: [
        "Calculate metrics with invalid data",
        "Expose performance data inappropriately",
        "Modify metrics after calculation",
      ],
      perf_budget_ms: 12,
      security_level: "low",
    },
    {
      id: "auditLogger",
      kind: "logging.component",
      responsibility: "Comprehensive audit logging for all VIF operations",
      status: "production",
      must_never: [
        "Skip logging for critical operations",
        "Modify audit logs after creation",
        "Expose sensitive audit information",
      ],
      perf_budget_ms: 3,
      security_level: "critical",
    },
  ],
  subsystems: [
    {
      id: "witness",
      name: "Witness Management Subsystem",
      type: "subsystem",
      parent: "vif.verifiableIntelligence",
      status: "production",
      description: "Cryptographic witness envelopes for complete provenance capture of all AI operations (model ID, weights hash, prompts, context snapshots, tools, uncertainty metrics)",
      meetsCriteria: ["complexity", "independence", "relationship", "evolution"],
      documentation: {
        L0: "components/witness/README.md",
        README: "components/witness/README.md",
      },
      relationships: {
        parent: "vif.verifiableIntelligence",
        children: [],
        siblings: ["kappa_gating", "replay", "confidence_bands"],
        external: ["cmc", "hhni", "apoe", "seg", "cas", "sdfcvf", "tcs"],
      },
      integrationPoints: [
        {
          system: "cmc",
          tag: "[CMC-STORAGE]",
          purpose: "Witnesses stored with CMC atoms for provenance",
          type: "required",
          bidirectional: true,
          reverseTag: "[VIF-WITNESS]",
        },
        {
          system: "hhni",
          tag: "[HHNI-RETRIEVAL]",
          purpose: "Witnesses HHNI retrieval operations for RS-lift metrics",
          type: "required",
          bidirectional: true,
          reverseTag: "[VIF-WITNESS]",
        },
        {
          system: "apoe",
          tag: "[APOE-EXECUTION]",
          purpose: "Witnesses APOE plan execution steps",
          type: "required",
          bidirectional: true,
          reverseTag: "[VIF-WITNESS]",
        },
        {
          system: "seg",
          tag: "[SEG-PROVENANCE]",
          purpose: "Witness references included in SEG graph schema",
          type: "required",
          bidirectional: true,
          reverseTag: "[VIF-WITNESS]",
        },
        {
          system: "cas",
          tag: "[CAS-INTROSPECTION]",
          purpose: "Witnesses CAS introspection operations",
          type: "required",
          bidirectional: true,
          reverseTag: "[VIF-WITNESS]",
        },
        {
          system: "sdfcvf",
          tag: "[SDFCVF-QUARTET]",
          purpose: "Witnesses SDF-CVF quartet changes",
          type: "required",
          bidirectional: true,
          reverseTag: "[VIF-WITNESS]",
        },
        {
          system: "tcs",
          tag: "[TCS-TIMELINE]",
          purpose: "Witnesses TCS timeline entries",
          type: "required",
          bidirectional: true,
          reverseTag: "[VIF-WITNESS]",
        },
      ],
    },
    {
      id: "kappa_gating",
      name: "κ-Gating Subsystem",
      type: "subsystem",
      parent: "vif.verifiableIntelligence",
      status: "production",
      description: "Behavioral abstention enforcement - AI must say 'I don't know' when confidence < threshold (prevents hallucinations). Per-task thresholds: critical κ=0.95, important κ=0.85, routine κ=0.70",
      meetsCriteria: ["complexity", "independence", "relationship", "evolution"],
      documentation: {
        L0: "components/kappa_gating/README.md",
        README: "components/kappa_gating/README.md",
      },
      relationships: {
        parent: "vif.verifiableIntelligence",
        children: [],
        siblings: ["witness", "replay", "confidence_bands"],
        external: ["apoe", "cmc", "seg", "cas", "sdfcvf"],
      },
      integrationPoints: [
        {
          system: "apoe",
          tag: "[APOE-GATE]",
          purpose: "Gates APOE step execution based on confidence thresholds",
          type: "required",
          bidirectional: true,
          reverseTag: "[VIF-KAPPA]",
        },
        {
          system: "cmc",
          tag: "[CMC-STORAGE]",
          purpose: "Gated operations stored in CMC with confidence metadata",
          type: "required",
          bidirectional: true,
          reverseTag: "[VIF-KAPPA]",
        },
        {
          system: "seg",
          tag: "[SEG-CONTRADICTION]",
          purpose: "Confidence scores used by SEG for contradiction resolution",
          type: "required",
          bidirectional: true,
          reverseTag: "[VIF-KAPPA]",
        },
        {
          system: "cas",
          tag: "[CAS-CATEGORY]",
          purpose: "Confidence scores used by CAS category recognition",
          type: "required",
          bidirectional: true,
          reverseTag: "[VIF-KAPPA]",
        },
        {
          system: "sdfcvf",
          tag: "[SDFCVF-GATE]",
          purpose: "Confidence scores used by SDF-CVF quality gates",
          type: "required",
          bidirectional: true,
          reverseTag: "[VIF-KAPPA]",
        },
      ],
    },
    {
      id: "replay",
      name: "Replay Subsystem",
      type: "subsystem",
      parent: "vif.verifiableIntelligence",
      status: "production",
      description: "Deterministic replay of AI operations for verification and audit. Enables time-travel verification of all AI decisions",
      meetsCriteria: ["complexity", "independence", "relationship", "evolution"],
      documentation: {
        L0: "components/replay/README.md",
        README: "components/replay/README.md",
      },
      relationships: {
        parent: "vif.verifiableIntelligence",
        children: [],
        siblings: ["witness", "kappa_gating", "confidence_bands"],
        external: ["cmc", "hhni", "tcs"],
      },
      integrationPoints: [
        {
          system: "cmc",
          tag: "[CMC-SNAPSHOT]",
          purpose: "Replay uses CMC snapshots for deterministic state restoration",
          type: "required",
          bidirectional: true,
          reverseTag: "[VIF-REPLAY]",
        },
        {
          system: "hhni",
          tag: "[HHNI-CONTEXT]",
          purpose: "Replay uses HHNI for context retrieval during replay",
          type: "required",
          bidirectional: true,
          reverseTag: "[VIF-REPLAY]",
        },
        {
          system: "tcs",
          tag: "[TCS-SYNC]",
          purpose: "Replay synchronizes with TCS timeline tracker for chronological audits",
          type: "required",
          bidirectional: true,
          reverseTag: "[VIF-REPLAY]",
        },
      ],
    },
    {
      id: "confidence_bands",
      name: "Confidence Bands Subsystem",
      type: "subsystem",
      parent: "vif.verifiableIntelligence",
      status: "production",
      description: "Confidence calibration and band management (A/B/C/D bands) for accurate uncertainty quantification",
      meetsCriteria: ["complexity", "independence", "relationship", "evolution"],
      documentation: {
        L0: "components/confidence_bands/README.md",
        README: "components/confidence_bands/README.md",
      },
      relationships: {
        parent: "vif.verifiableIntelligence",
        children: ["ece"],
        siblings: ["witness", "kappa_gating", "replay"],
        external: ["cmc", "cas"],
      },
      integrationPoints: [
        {
          system: "cmc",
          tag: "[CMC-STORAGE]",
          purpose: "Confidence bands stored with CMC atoms",
          type: "required",
          bidirectional: true,
          reverseTag: "[VIF-BANDS]",
        },
        {
          system: "cas",
          tag: "[CAS-ANALYSIS]",
          purpose: "Confidence bands used by CAS for cognitive analysis",
          type: "required",
          bidirectional: true,
          reverseTag: "[VIF-BANDS]",
        },
      ],
    },
  ],
  ports: [
    {
      portId: "cmcIntegration",
      direction: "bidirectional",
      connectsToSystem: "cmc.contextMemoryCore",
      protocol: "internal_api",
      whatIsExchanged: [
        "witness_storage",
        "confidence_scores",
        "verification_requests",
        "proof_artifacts",
      ],
      security_level: "critical",
    },
    {
      portId: "hhniIntegration",
      direction: "bidirectional",
