          "workflow_manager",
        ],
        description: "Manages collaboration workflows",
      },
      {
        flow_name: "task_management",
        components: [
          "task_distributor",
          "load_balancer",
        ],
        description: "Manages task distribution and load balancing",
      },
    ],
  },
