      whatIsExchanged: [
        "audit_reports",
        "compliance_data",
        "verification_results",
        "security_alerts",
      ],
      security_level: "critical",
    },
  ],
  internalEdges: [
    {
      from: "confidenceTracker",
      to: "witnessManager",
