      name: "Render Target Manager",
      type: "gpu_resource_manager",
      file: "main.js",
      responsibilities: [
        "Compute render resolution (canvas CSS size * renderScale * devicePixelRatio)",
        "Allocate textures + FBOs for BufferA, BufferB, CurrentColor, History",
        "Recreate targets on resize or key config changes",
        "Manage double-buffered textures (BufferA, BufferB, History)",
        "Handle fallback to RGBA8 if float-linear filtering unavailable",
      ],
      interfaces: {
        inputs: ["Canvas size", "renderScale", "TAA enabled", "godrays enabled", "devicePixelRatio"],
        outputs: ["Allocated GPU resources and updated `rtWidth/rtHeight`", "Texture/FBO handles"],
      },
      performance: {
        criticalPath: false,
        spikes: "Can stutter during resize/realloc (100-500ms)",
