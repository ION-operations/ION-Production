{
  "name": "@aimos/lucid-document-editor",
  "version": "1.0.0",
  "description": "Revolutionary document intelligence system combining LaTeX math rendering, rich text editing, AI-powered management, advanced tagging/organization, section-based editing, and visual diff tracking",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "build:lib": "tsc && vite build --mode library",
    "build:demo": "tsc && vite build --mode demo",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/**/*.{ts,tsx}",
    "lint:fix": "eslint src/**/*.{ts,tsx} --fix",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "keywords": [
    "document-editor",
    "latex",
    "math-rendering",
    "rich-text",
    "ai-powered",
    "collaboration",
    "monaco-editor",
    "katex",
    "mathjax",
    "aimos",
    "typescript",
    "react"
  ],
  "author": "Ra (AI Agent)",
  "license": "MIT",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "katex": "^0.16.9",
    "lucide-react": "^0.454.0",
    "mammoth": "^1.11.0",
    "mathjax": "^3.2.2",
    "monaco-editor": "^0.54.0",
    "pdfjs-dist": "^5.4.394",
    "prop-types": "^15.8.1",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-katex": "^3.0.1",
    "slate": "^0.100.0",
    "slate-history": "^0.100.0",
    "slate-react": "^0.100.0",
    "y-websocket": "^1.5.0",
    "yjs": "^13.6.0",
    "zustand": "^5.0.8",
    "lucide-react": "^0.454.0",
    "pdfjs-dist": "^5.4.394",
    "mammoth": "^1.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/katex": "^0.16.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "^23.0.1",
    "postcss": "^8.4.41",
    "rimraf": "^5.0.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vitest": "^1.4.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aimos/lucid-document-editor.git"
  }
}
