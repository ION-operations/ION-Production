+import { useMemo, useState } from 'react';
+import type { IonCockpitViewModel, IonLivingGraphNodeCard } from './ionRuntimeCockpitTypes';
+
+type Props = {
+  runtime: IonCockpitViewModel;
+};
+
+function fmt(value: unknown, fallback = '—') {
+  if (value === null || value === undefined || value === '') return fallback;
+  return String(value);
+}
+
+function statusClass(value: unknown) {
+  return String(value ?? 'unknown').toLowerCase().replace(/[^a-z0-9_-]+/g, '_');
+}
+
+function toScreenPoint(node: IonLivingGraphNodeCard, index: number, count: number) {
+  const raw = node.position ?? {};
+  const x = typeof raw.x === 'number' ? raw.x : undefined;
+  const z = typeof raw.z === 'number' ? raw.z : undefined;
+  if (typeof x === 'number' && typeof z === 'number') {
+    return {
+      x: 360 + x * 34,
+      y: 210 + z * 28,
+    };
+  }
+  const angle = (Math.PI * 2 * index) / Math.max(count, 1) - Math.PI / 2;
+  return {
+    x: 360 + Math.cos(angle) * 210,
+    y: 210 + Math.sin(angle) * 145,
+  };
+}
+
+export function LivingGraphWorkbenchPanel({ runtime }: Props) {
+  const graph = runtime.living_graph;
+  const nodes = useMemo(() => {
+    if (!graph) return [];
+    const all = [];
+    if (graph.core?.id) all.push(graph.core);
+    all.push(...(graph.domains ?? []));
+    return all;
+  }, [graph]);
+  const [activeNodeId, setActiveNodeId] = useState<string | undefined>(graph?.selected?.id ?? graph?.core?.id);
+  const [hiddenLayers, setHiddenLayers] = useState<Record<string, boolean>>({});
+  const [timelineCursor, setTimelineCursor] = useState<string | undefined>(typeof graph?.timeline?.playback?.scrubber_event_id === 'string' ? graph.timeline.playback.scrubber_event_id : undefined);
+
+  if (!graph) {
+    return (
+      <section className="ion-panel ion-living-graph-panel is-missing">
+        <div className="ion-section-title">LIVING OPERATIONAL GRAPH</div>
+        <h2>GRAPH MODEL ABSENT</h2>
+        <p>The cockpit model has not exposed a living_graph projection yet.</p>
+      </section>
+    );
+  }
+
+  const activeNode = nodes.find((node) => node.id === activeNodeId) ?? graph.selected ?? graph.core ?? nodes[0];
+  const pointById = new Map(nodes.map((node, index) => [node.id, toScreenPoint(node, index, nodes.length)]));
+  const showDomains = !hiddenLayers.domains;
+  const showRoutes = !hiddenLayers.routes;
+  const showTimeline = !hiddenLayers.timeline;
+
+  return (
+    <section className={`ion-living-graph-workbench is-${statusClass(graph.status)}`} aria-label="ION Living Operational Graph">
+      <header className="ion-living-graph-top">
+        <div>
+          <div className="ion-section-title">LIVING OPERATIONAL GRAPH / SAMPLE VERTICAL SLICE</div>
+          <h2>Developer cockpit territory map</h2>
+          <p>{graph.honesty?.non_claim ?? 'No live graph claim is made by this surface.'}</p>
+        </div>
+        <div className="ion-living-graph-badges">
+          <span>{fmt(graph.honesty?.global_badge_label, 'SAMPLE / CANDIDATE DATA')}</span>
+          <b className={`is-${statusClass(graph.status)}`}>{fmt(graph.status)}</b>
+        </div>
+      </header>
+
+      <aside className="ion-living-graph-left" aria-label="Graph layers">
+        <div className="ion-section-title">LAYERS</div>
+        {(graph.layers ?? []).map((layer) => (
+          <button
+            className={hiddenLayers[layer.id] ? 'is-muted' : 'is-active'}
+            key={layer.id}
+            onClick={() => setHiddenLayers((previous) => ({ ...previous, [layer.id]: !previous[layer.id] }))}
+            type="button"
+          >
+            <span>{layer.label}</span>
+            <b>{layer.node_count ?? layer.edge_count ?? layer.event_count ?? 0}</b>
+          </button>
+        ))}
+        <div className="ion-section-title">PROOF GATES</div>
+        <div className="ion-living-graph-proof-stack">
+          {Object.entries(graph.proof_gates ?? {}).map(([key, value]) => (
+            <span className={value ? 'is-pass' : 'is-watch'} key={key}>{key}</span>
+          ))}
+        </div>
+      </aside>
+
+      <div className="ion-living-graph-viewport" aria-label="Graph territory viewport">
+        {graph.status !== 'ready' && (
+          <div className="ion-living-graph-missing-source">
+            <b>GRAPH SOURCE NOT MOUNTED</b>
+            <span>{fmt(graph.source_paths?.bundle)}</span>
+            <span>{fmt(graph.source_paths?.layout)}</span>
+          </div>
+        )}
+
+        <svg role="img" aria-label="Living operational graph map" viewBox="0 0 720 420">
+          <defs>
+            <filter id="ionGraphGlow" x="-20%" y="-20%" width="140%" height="140%">
+              <feGaussianBlur stdDeviation="2" result="blur" />
+              <feMerge>
+                <feMergeNode in="blur" />
+                <feMergeNode in="SourceGraphic" />
+              </feMerge>
+            </filter>
+          </defs>
+          <rect x="10" y="10" width="700" height="400" rx="2" className="ion-graph-board" />
+          <g className="ion-graph-grid">
+            {Array.from({ length: 13 }).map((_, index) => (
+              <line key={`v-${index}`} x1={40 + index * 56} x2={40 + index * 56} y1="28" y2="392" />
+            ))}
+            {Array.from({ length: 8 }).map((_, index) => (
+              <line key={`h-${index}`} x1="28" x2="692" y1={42 + index * 48} y2={42 + index * 48} />
+            ))}
+          </g>
+
+          {showRoutes && (graph.route_edges ?? []).map((route) => {
+            const a = pointById.get(route.source);
+            const b = pointById.get(route.target);
+            if (!a || !b) return null;
+            const active = activeNode?.id === route.source || activeNode?.id === route.target;
+            return (
+              <g className={active ? 'ion-graph-route is-active' : 'ion-graph-route'} key={route.id}>
+                <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} />
+                <text x={(a.x + b.x) / 2} y={(a.y + b.y) / 2 - 5}>{route.authority_class}</text>
+              </g>
+            );
+          })}
+
+          {showDomains && nodes.map((node, index) => {
+            const point = pointById.get(node.id) ?? toScreenPoint(node, index, nodes.length);
+            const isCore = node.type === 'core';
+            const active = activeNode?.id === node.id;
+            return (
+              <g
+                className={`ion-graph-node is-${statusClass(node.type)} ${active ? 'is-selected' : ''}`}
+                key={node.id}
+                onClick={() => setActiveNodeId(node.id)}
+                tabIndex={0}
+                role="button"
+                aria-label={`Select ${node.label}`}
+              >
+                <rect x={point.x - (isCore ? 50 : 42)} y={point.y - (isCore ? 30 : 24)} width={isCore ? 100 : 84} height={isCore ? 60 : 48} rx="2" />
+                <text x={point.x} y={point.y - 3}>{node.label}</text>
+                <text x={point.x} y={point.y + 13}>{node.proof_status} / {node.operational_status}</text>
+              </g>
+            );
+          })}
+        </svg>
+      </div>
+
+      <aside className="ion-living-graph-inspector" aria-label="Selected graph object inspector">
+        <div className="ion-section-title">SELECTED OBJECT TRUTH</div>
+        {activeNode ? (
+          <>
+            <h3>{activeNode.label}</h3>
+            <div className={`ion-living-graph-verdict is-${statusClass(activeNode.proof_status)}`}>{activeNode.type} / {activeNode.proof_status}</div>
+            <p>{activeNode.summary || 'No summary available for this graph object.'}</p>
+            <div className="ion-runtime-grid">
+              <Metric label="authority" value={activeNode.authority_status} />
+              <Metric label="transition" value={activeNode.transition_authority_class} />
+              <Metric label="routes" value={activeNode.route_count} />
+              <Metric label="children" value={activeNode.child_count} />
+              <Metric label="receipts" value={activeNode.receipt_count} />
+              <Metric label="honesty" value={activeNode.honesty_status} />
+            </div>
+            <div className="ion-section-title">INSPECTOR TABS</div>
+            <div className="ion-living-graph-tab-row">
+              {(activeNode.available_tabs ?? []).map((tab) => <span key={tab}>{tab}</span>)}
+            </div>
+          </>
+        ) : (
+          <div className="ion-empty-state">NO GRAPH OBJECT SELECTED</div>
+        )}
+      </aside>
+
+      <footer className="ion-living-graph-timeline" aria-label="Graph timeline replay">
+        <div>
+          <span className="ion-section-title">TIMELINE / {fmt(graph.timeline?.mode, 'sample replay')}</span>
+          <strong>{fmt(graph.timeline?.event_count, '0')} events</strong>
+        </div>
+        {showTimeline && (
+          <div className="ion-living-graph-events">
+            {(graph.timeline?.latest_events ?? []).map((event) => (
+              <button
+                className={timelineCursor === event.id ? 'is-active' : undefined}
+                key={event.id}
+                onClick={() => {
+                  setTimelineCursor(event.id);
+                  setActiveNodeId(event.target_node ?? event.source_node ?? event.actor_node ?? activeNodeId);
+                }}
+                type="button"
+              >
+                <span>{event.timestamp}</span>
+                <b>{event.event_type}</b>
+                <em>{event.timeline_track}</em>
+              </button>
+            ))}
+          </div>
+        )}
+      </footer>
+    </section>
+  );
+}
+
+function Metric({ label, value }: { label: string; value: unknown }) {
+  return (
+    <div className="ion-runtime-metric">
+      <span>{label}</span>
+      <b>{fmt(value)}</b>
+    </div>
+  );
+}
