{
  "systemId": "vif.verifiableIntelligence",
  "humanName": "Verifiable Intelligence Framework - Provenance and Confidence Tracking",
  "version": "v2.2.0",
  "status": "production",
  
  "intent": {
    "purpose": "Provide provenance and confidence tracking system that prevents hallucinations and ensures verifiable AI operations. Think 'AI's conscience' - tracks every decision, validates every claim, and maintains cryptographic proof of truth.",
    "must_not_regress": [
      "Must not allow confidence scores without evidence",
      "Must not modify witnesses after creation",
      "Must not lose provenance information",
      "Must not skip validation for high-confidence claims",
      "Must not break deterministic replay"
    ],
    "why_it_exists": "Enables verifiable AI operations with complete provenance tracking, confidence calibration, and deterministic replay. Prevents hallucinations through κ-gating and witness validation."
  },
  
  "classification": {
    "security_level": "critical",
    "perf_sensitivity": "high",
    "ownership": "core",
    "sideEffects": [
      "Tracks all AI operations with provenance",
      "Validates confidence claims",
      "Prevents hallucinations through gating",
      "Enables deterministic replay",
      "Provides cryptographic proof of truth"
    ]
  },
  
  "internalNodes": [
    {
      "id": "confidenceTracker",
      "responsibility": "Tracks confidence scores and calibration across all operations",
      "must_never": [
        "Allow confidence scores without evidence",
        "Modify confidence scores after validation",
        "Track confidence without proper provenance"
      ],
      "perf_budget_ms": 5,
      "status": "production"
    },
    {
      "id": "witnessManager",
      "responsibility": "Manages cryptographic witnesses for all AI operations",
      "must_never": [
        "Create witnesses without proper evidence",
        "Modify witnesses after creation",
        "Allow witness tampering"
      ],
      "perf_budget_ms": 10,
      "status": "production"
    },
    {
      "id": "provenanceEngine",
      "responsibility": "Tracks complete provenance chain for all decisions and outputs",
      "must_never": [
        "Lose provenance information",
        "Create circular provenance chains",
        "Allow provenance tampering"
      ],
      "perf_budget_ms": 15,
      "status": "production"
    },
    {
      "id": "validationEngine",
      "responsibility": "Validates AI outputs against confidence claims and evidence",
      "must_never": [
        "Skip validation for high-confidence claims",
        "Accept validation without proper evidence",
        "Allow false positive validations"
      ],
      "perf_budget_ms": 20,
      "status": "production"
    },
    {
      "id": "replayEngine",
      "responsibility": "Enables deterministic replay of AI operations for verification",
      "must_never": [
        "Lose replay state information",
        "Allow non-deterministic replay",
        "Expose sensitive data during replay"
      ],
      "perf_budget_ms": 25,
      "status": "production"
    },
    {
      "id": "eceCalculator",
      "responsibility": "Calculates Expected Calibration Error (ECE) for confidence calibration",
      "must_never": [
        "Calculate ECE with insufficient data",
        "Modify ECE calculations after validation",
        "Expose calibration data inappropriately"
      ],
      "perf_budget_ms": 10,
      "status": "production"
    },
    {
      "id": "kappaGating",
      "responsibility": "Implements Cohen's Kappa gating for inter-annotator agreement",
      "must_never": [
        "Gate operations without proper agreement",
        "Allow low-agreement operations to proceed",
        "Modify kappa thresholds without approval"
      ],
      "perf_budget_ms": 8,
      "status": "production"
    },
    {
      "id": "rsLiftCalculator",
      "responsibility": "Calculates RS-Lift metrics for retrieval system performance",
      "must_never": [
        "Calculate metrics with invalid data",
        "Expose performance data inappropriately",
        "Modify metrics after calculation"
      ],
      "perf_budget_ms": 12,
      "status": "production"
    },
    {
      "id": "auditLogger",
      "responsibility": "Comprehensive audit logging for all VIF operations",
      "must_never": [
        "Skip logging for critical operations",
        "Modify audit logs after creation",
        "Expose sensitive audit information"
      ],
      "perf_budget_ms": 3,
      "status": "production"
    }
  ],
  
  "systemMap": {
    "mapFile": "./system.map.lucid.json5"
  },
  
  "foresight": {
    "predictedRisks": [
      {
        "risk_id": "witness_storage_exhaustion",
        "description": "Unlimited witness creation could exhaust storage capacity",
        "likelihood": "medium",
        "blast_radius_if_real": "witness_creation_unavailable",
        "mitigation": "Implement witness archival policies and compression",
        "watchpoint": "if witness_count > 1M for 24h, trigger archival"
      },
      {
        "risk_id": "confidence_calibration_drift",
        "description": "Confidence calibration could drift over time",
        "likelihood": "high",
        "blast_radius_if_real": "confidence_scores_unreliable",
        "mitigation": "Implement continuous calibration monitoring and recalibration",
        "watchpoint": "if ECE > 0.15 for 100 consecutive predictions, trigger recalibration"
      },
      {
        "risk_id": "replay_determinism_failure",
        "description": "Deterministic replay could fail due to non-deterministic operations",
        "likelihood": "low",
        "blast_radius_if_real": "replay_verification_unreliable",
        "mitigation": "Implement strict replay state validation and fallback mechanisms",
        "watchpoint": "if replay_determinism_check fails, halt replay and alert"
      },
      {
        "risk_id": "provenance_chain_corruption",
        "description": "Provenance chains could become corrupted or circular",
        "likelihood": "low",
        "blast_radius_if_real": "provenance_tracking_unreliable",
        "mitigation": "Implement provenance chain validation and cycle detection",
        "watchpoint": "if provenance_cycle_detected, halt operation and alert"
      }
    ],
    "killSwitch": "vif.verification.enabled=false",
    "emergencyProcedures": [
      "Disable witness creation immediately",
      "Switch to read-only mode",
      "Create emergency audit snapshot",
      "Notify all dependent systems"
    ]
  },
  
