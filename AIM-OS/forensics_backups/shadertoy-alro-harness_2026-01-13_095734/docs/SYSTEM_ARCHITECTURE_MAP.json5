  renderPasses: [
    {
      passId: "bufferA",
      name: "BufferA (mouse tracking + resolution change)",
      shader: "shaders/bufferA.glsl",
      output: "bufferA (double-buffered)",
      resolution: "1x4",
      notes: "Must run every frame; feeds targetDir + flags into downstream passes.",
      dependencies: ["Previous BufferA (feedback)"],
      uniforms: ["iResolution", "iTime", "iFrame", "iMouse", "iChannel0 (previous BufferA)"],
    },
    {
      passId: "bufferB",
      name: "BufferB (Perlin-Worley atlas + cloud map + moon texture)",
      shader: "shaders/bufferB.glsl",
      output: "bufferB (double-buffered)",
      resolution: "rtWidth x rtHeight",
      notes: "Generated on init/resize; persists atlas via feedback to avoid recompute.",
      dependencies: ["BufferA", "Previous BufferB (feedback)"],
      uniforms: ["iResolution", "iTime", "iChannel0 (BufferA)", "iChannel1 (previous BufferB)"],
    },
    {
      passId: "image",
      name: "Image (cloud rendering)",
      shader: "shaders/image.glsl",
      output: "currentColorTex or canvas",
      resolution: "rtWidth x rtHeight",
      notes: "Reference shader; alpha carries transmittance (used by god rays).",
      dependencies: ["BufferA", "BufferB", "Blue noise"],
      uniforms: [
        "Shadertoy uniforms (iResolution, iTime, iMouse, iChannel0-3)",
        "Lighting uniforms (uLightingMode, uLightAzimuth, uLightHeight, uLightColor, etc.)",
        "Camera uniforms (uHarnessCameraPos, uHarnessTargetDir, uHarnessCameraUp, uHarnessFovDeg)",
      ],
      variants: ["Normal (64 steps)", "FAST (32 steps, #define FAST)"],
    },
    {
      passId: "accum",
      name: "Temporal Accumulation (TAA-lite)",
      shader: "shaders/accum.glsl",
      output: "history (double-buffered)",
      resolution: "rtWidth x rtHeight",
      notes: "Blends currentColor into history with optional reprojection based on targetDir.",
      dependencies: ["currentColorTex", "history (previous frame)"],
      uniforms: [
        "uResolution",
        "uCurrent",
        "uHistory",
        "uAlpha",
        "uReset",
        "uUseReprojection",
        "uTargetDirCur",
        "uTargetDirPrev",
        "uFovDeg",
      ],
    },
    {
      passId: "godrays",
      name: "God Rays (post)",
      shader: "shaders/godrays.glsl",
      output: "canvas",
      resolution: "rtWidth x rtHeight",
      notes: "Radial blur of transmittance from light UV; expensive at high samples.",
      dependencies: ["Scene texture (with transmittance in alpha)"],
      uniforms: [
        "uResolution",
        "uScene",
        "uLightUv",
        "uLightColor",
        "uIntensity",
        "uDensity",
        "uDecay",
        "uWeight",
        "uSamples",
        "uSourceRadius",
      ],
    },
    {
      passId: "blit",
      name: "Blit (present)",
      shader: "(inline in main.js)",
      output: "canvas",
      resolution: "rtWidth x rtHeight",
      notes: "Simple fullscreen texture copy.",
      dependencies: ["Source texture (history or currentColor)"],
      uniforms: ["uResolution", "uTex"],
    },
  ],

  gpuResources: [
    {
      name: "bufferA",
      type: "RGBA16F + FBO",
      size: "1x4",
      buffering: "double",
      purpose: "state + targetDir",
      format: "RGBA16F (or RGBA8 fallback)",
      usage: "Read/write every frame",
    },
    {
      name: "bufferB",
      type: "RGBA16F + FBO",
      size: "rtWidth x rtHeight",
      buffering: "double",
      purpose: "atlas + maps",
      format: "RGBA16F (or RGBA8 fallback if float-linear unavailable)",
      usage: "Read/write on init/resize only",
    },
    {
      name: "currentColorTex",
      type: "RGBA16F + FBO",
      size: "rtWidth x rtHeight",
      purpose: "Image pass output",
      format: "RGBA16F",
      usage: "Write by Image pass, read by Accum pass",
    },
    {
      name: "history",
      type: "RGBA16F + FBO",
      size: "rtWidth x rtHeight",
      buffering: "double",
      purpose: "TAA accumulation",
      format: "RGBA16F",
      usage: "Read/write by Accum pass",
    },
    {
      name: "blueNoise",
      type: "R8 texture",
      size: "1024x1024",
      purpose: "Dither/jitter source",
      format: "R8 (single channel)",
      usage: "Read-only by shaders (iChannel2)",
    },
  ],

