{
  system_id: "security_audit_system",
  system_name: "Security Audit System",
  version: "1.0.0",
  last_updated: "2025-01-27T20:50:00Z",
  map_type: "system_topology",
  internal_topology: {
    core_components: [
      {
        component_id: "security_audit_engine",
        name: "Security Audit Engine",
        type: "audit_engine",
        tier: 2,
        description: "Core security audit engine that performs comprehensive security assessments",
        ports: {
          input: [
            "audit_requests",
            "security_policies",
          ],
          output: [
            "audit_results",
            "security_reports",
          ],
        },
        dependencies: [
          "vulnerability_scanner",
          "compliance_checker",
        ],
        blast_radius: "platform",
        must_never: [
          "Perform audits without validation",
          "Skip security policies",
          "Ignore vulnerability findings",
          "Bypass audit validation",
        ],
      },
      {
        component_id: "vulnerability_scanner",
        name: "Vulnerability Scanner",
        type: "scanner_engine",
        tier: 2,
        description: "Scans systems for security vulnerabilities and weaknesses",
        ports: {
          input: [
            "scan_requests",
            "vulnerability_rules",
          ],
          output: [
            "vulnerability_reports",
            "scan_results",
          ],
        },
        dependencies: [
          "vulnerability_database",
          "scanning_rules",
        ],
        blast_radius: "platform",
        must_never: [
          "Scan without validation",
          "Skip vulnerability checks",
          "Ignore scan results",
          "Bypass scanning validation",
        ],
      },
      {
        component_id: "compliance_checker",
        name: "Compliance Checker",
        type: "compliance_engine",
        tier: 2,
        description: "Checks compliance with security standards and regulations",
        ports: {
          input: [
            "compliance_requests",
            "compliance_rules",
          ],
          output: [
            "compliance_reports",
            "compliance_status",
          ],
        },
        dependencies: [
          "compliance_rules",
          "standards_database",
        ],
        blast_radius: "platform",
        must_never: [
          "Check compliance without validation",
          "Skip compliance rules",
          "Ignore compliance violations",
          "Bypass compliance validation",
        ],
      },
      {
        component_id: "threat_analyzer",
        name: "Threat Analyzer",
        type: "analysis_engine",
        tier: 2,
        description: "Analyzes security threats and attack vectors",
        ports: {
          input: [
            "threat_data",
            "analysis_rules",
          ],
          output: [
            "threat_analysis",
            "risk_assessment",
          ],
        },
        dependencies: [
          "threat_database",
          "analysis_rules",
        ],
        blast_radius: "platform",
        must_never: [
          "Analyze threats without validation",
          "Skip threat checks",
          "Ignore threat findings",
          "Bypass analysis validation",
        ],
      },
      {
        component_id: "security_reporter",
        name: "Security Reporter",
        type: "reporting_engine",
        tier: 2,
        description: "Generates comprehensive security reports and recommendations",
        ports: {
          input: [
            "audit_data",
            "reporting_rules",
          ],
          output: [
            "security_reports",
            "recommendations",
          ],
        },
        dependencies: [
          "reporting_templates",
          "recommendation_engine",
        ],
        blast_radius: "platform",
        must_never: [
          "Generate reports without validation",
          "Skip reporting rules",
          "Ignore report requirements",
          "Bypass reporting validation",
        ],
      },
    ],
    supporting_components: [
      {
        component_id: "vulnerability_database",
        name: "Vulnerability Database",
        type: "database_engine",
        tier: 1,
        description: "Maintains database of known vulnerabilities and security issues",
        ports: {
          input: [
            "vulnerability_data",
            "update_requests",
          ],
          output: [
            "vulnerability_info",
            "update_status",
          ],
        },
        dependencies: [
          "database_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Store vulnerabilities without validation",
          "Skip database rules",
          "Ignore data integrity",
          "Bypass database validation",
        ],
      },
      {
        component_id: "scanning_rules",
        name: "Scanning Rules",
        type: "rules_engine",
        tier: 1,
        description: "Provides scanning rules and configurations",
        ports: {
          input: [
            "scanning_requests",
            "rule_definitions",
          ],
          output: [
            "scanning_rules",
            "rule_status",
          ],
        },
        dependencies: [
          "rule_definitions",
        ],
        blast_radius: "local",
        must_never: [
          "Provide rules without validation",
          "Skip rule definitions",
          "Ignore rule requirements",
          "Bypass rule validation",
        ],
      },
      {
        component_id: "compliance_rules",
        name: "Compliance Rules",
        type: "rules_engine",
        tier: 1,
        description: "Provides compliance rules and standards",
        ports: {
          input: [
            "compliance_requests",
            "rule_definitions",
          ],
          output: [
            "compliance_rules",
            "rule_status",
          ],
        },
        dependencies: [
          "rule_definitions",
        ],
        blast_radius: "local",
        must_never: [
          "Provide rules without validation",
          "Skip rule definitions",
          "Ignore rule requirements",
          "Bypass rule validation",
        ],
      },
      {
        component_id: "threat_database",
        name: "Threat Database",
        type: "database_engine",
        tier: 1,
        description: "Maintains database of known threats and attack patterns",
        ports: {
          input: [
            "threat_data",
            "update_requests",
          ],
          output: [
            "threat_info",
            "update_status",
          ],
        },
        dependencies: [
          "database_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Store threats without validation",
          "Skip database rules",
          "Ignore data integrity",
          "Bypass database validation",
        ],
      },
      {
        component_id: "reporting_templates",
        name: "Reporting Templates",
        type: "template_engine",
        tier: 1,
        description: "Provides templates for security reports",
        ports: {
          input: [
            "template_requests",
            "template_rules",
          ],
          output: [
            "report_templates",
            "template_status",
          ],
        },
        dependencies: [
          "template_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Provide templates without validation",
          "Skip template rules",
          "Ignore template requirements",
          "Bypass template validation",
        ],
      },
    ],
  },
  boundary_tendrils: {
    input_ports: [
      {
        port_id: "audit_requests_input",
        name: "Audit Requests Input",
        type: "data_input",
        protocol: "json",
        description: "Receives security audit requests",
        required: true,
        validation: "audit_requests_schema",
      },
      {
        port_id: "security_policies_input",
        name: "Security Policies Input",
        type: "data_input",
        protocol: "json",
        description: "Receives security policies for audit",
