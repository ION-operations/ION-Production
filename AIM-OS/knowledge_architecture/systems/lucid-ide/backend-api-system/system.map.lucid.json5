{
  systemId: "lucid-ide.backendApiSystem",
  systemName: "Lucid IDE Backend API System",
  version: "v1.0.0",
  status: "production",
  layer: 2,
  description: "Next.js API Routes providing 42 endpoints for AI services, architecture generation, context preview, and real-time tracing",
  purpose: "Provides RESTful and WebSocket APIs for frontend integration, AI provider abstraction, file processing, and real-time communication",
  dependencies: [],
  internalNodes: [
    {
      id: "aiRoutes",
      kind: "core.component",
      responsibility: "25+ AI service routes (agents, chains, embeddings, knowledge-map, models, providers, etc.)",
      status: "production",
      must_never: [
        "Expose API keys",
        "Allow unauthorized access",
        "Skip input validation",
      ],
      perf_budget_ms: 200,
      security_level: "critical",
    },
    {
      id: "architectRoutes",
      kind: "core.component",
      responsibility: "Backend architecture generation and suggestion routes",
      status: "production",
      must_never: [
        "Generate insecure code",
        "Skip code validation",
        "Expose system internals",
      ],
      perf_budget_ms: 5000,
      security_level: "high",
    },
    {
      id: "contextPreviewRoutes",
      kind: "service.component",
      responsibility: "Context preview generation for backend architect",
      status: "production",
      must_never: [
        "Expose sensitive context",
        "Break context boundaries",
        "Cause memory leaks",
      ],
      perf_budget_ms: 1000,
      security_level: "high",
    },
    {
      id: "traceRoutes",
      kind: "service.component",
      responsibility: "Real-time tracing and streaming routes",
      status: "production",
      must_never: [
        "Stream sensitive data",
        "Break WebSocket connections",
        "Cause performance degradation",
      ],
      perf_budget_ms: 100,
      security_level: "medium",
    },
    {
      id: "fileStorage",
      kind: "storage.component",
      responsibility: "File-based JSON storage (⚠️ needs migration to database)",
      status: "production",
      must_never: [
        "Lose data integrity",
        "Allow path traversal",
        "Exceed file size limits",
      ],
      perf_budget_ms: 50,
      security_level: "critical",
    },
    {
      id: "lucidChat",
      kind: "subsystem.component",
      responsibility: "Advanced AI chat system with APOE orchestration, multi-source search, branch reasoning, and multi-agent collaboration",
      status: "production",
      must_never: [
        "Expose API keys",
        "Allow unauthorized access",
        "Skip input validation",
        "Skip quality gates",
        "Exceed budget without warning",
      ],
      perf_budget_ms: 120000,
      security_level: "critical",
      subsystem: {
        systemId: "lucid-chat.advancedAIChat",
        path: "knowledge_architecture/systems/lucid-chat/",
        mapFile: "knowledge_architecture/systems/lucid-chat/system.map.lucid.json5",
        indexFile: "knowledge_architecture/systems/lucid-chat/system.index.lucid.json5",
      },
    },
  ],
  ports: [
    {
      id: "restApi",
      portName: "REST API",
      type: "bidirectional",
      protocol: "REST",
      security: "high",
      description: "RESTful API endpoints for frontend integration",
      rateLimit: "unlimited",
      authentication: "session-based",
      authorization: "user-based",
      dataFormat: "JSON",
      versioning: "v1",
    },
    {
      id: "websocket",
      portName: "WebSocket API",
      type: "bidirectional",
      protocol: "WebSocket",
      security: "high",
      description: "Real-time WebSocket communication",
      rateLimit: "unlimited",
      authentication: "session-based",
      authorization: "user-based",
      dataFormat: "JSON",
      versioning: "v1",
    },
    {
      id: "aiProviders",
      portName: "AI Provider Integration",
      type: "outbound",
      protocol: "HTTP",
      security: "critical",
      description: "Integration with OpenAI, Anthropic, XAI",
      rateLimit: "provider-specific",
      authentication: "api-key",
      authorization: "n/a",
      dataFormat: "JSON",
      versioning: "provider-specific",
    },
    {
      id: "database",
      portName: "Database Connection",
      type: "bidirectional",
      protocol: "SQL/NoSQL",
      security: "critical",
      description: "Database connections (Supabase, Postgres, SQLite)",
      rateLimit: "unlimited",
      authentication: "connection-string",
      authorization: "database-level",
      dataFormat: "SQL/JSON",
      versioning: "n/a",
    },
  ],
  internalEdges: [
    {
      from: "aiRoutes",
      to: "fileStorage",
      type: "data_flow",
      description: "AI routes read/write to file storage",
      protocol: "file-io",
      performance: "50ms",
      security: "high",
      dataFlow: "bidirectional",
      frequency: "on-demand",
    },
    {
      from: "architectRoutes",
      to: "aiProviders",
      type: "data_flow",
      description: "Architect routes call AI providers for generation",
      protocol: "HTTP",
      performance: "2000ms",
      security: "critical",
      dataFlow: "unidirectional",
      frequency: "on-demand",
    },
    {
      from: "contextPreviewRoutes",
      to: "aiProviders",
      type: "data_flow",
      description: "Context preview uses AI for generation",
      protocol: "HTTP",
      performance: "1000ms",
      security: "high",
      dataFlow: "unidirectional",
      frequency: "on-demand",
    },
    {
      from: "traceRoutes",
      to: "websocket",
      type: "data_flow",
      description: "Trace routes stream via WebSocket",
      protocol: "WebSocket",
      performance: "100ms",
      security: "medium",
      dataFlow: "unidirectional",
      frequency: "continuous",
    },
  ],
  externalEdges: [
    {
      from: "lucid-ide.backendApiSystem.restApi",
      to: "lucid-ide.frontendSystem.apiClient",
      type: "data_flow",
      protocol: "REST",
      description: "Frontend calls backend API routes",
      rateLimit: "unlimited",
      security: "high",
      authentication: "session-based",
      dataFormat: "JSON",
    },
    {
      from: "lucid-ide.backendApiSystem.websocket",
      to: "lucid-ide.frontendSystem.websocket",
      type: "data_flow",
      protocol: "WebSocket",
      description: "Real-time updates to frontend",
      rateLimit: "unlimited",
      security: "high",
      authentication: "session-based",
      dataFormat: "JSON",
    },
    {
      from: "lucid-ide.backendApiSystem.aiProviders",
      to: "external.openai",
      type: "data_flow",
      protocol: "HTTP",
      description: "Calls OpenAI API",
      rateLimit: "provider-specific",
      security: "critical",
      authentication: "api-key",
      dataFormat: "JSON",
    },
    {
      from: "lucid-ide.backendApiSystem.aiProviders",
      to: "external.anthropic",
      type: "data_flow",
      protocol: "HTTP",
      description: "Calls Anthropic API",
      rateLimit: "provider-specific",
      security: "critical",
      authentication: "api-key",
      dataFormat: "JSON",
    },
    {
      from: "lucid-ide.backendApiSystem.lucidChat",
      to: "lucid-chat.advancedAIChat",
      type: "subsystem",
      protocol: "internal_api",
      description: "Lucid Chat subsystem with advanced AI capabilities",
      rateLimit: "unlimited",
      security: "high",
      authentication: "internal",
      dataFormat: "JSON",
    },
  ],
  riskOverlay: {
    performance: {
      hotspots: ["aiRoutes", "architectRoutes"],
      bottlenecks: ["fileStorage", "aiProviders"],
      optimization: "Database migration, caching, rate limiting",
      scalability: "horizontal (Next.js serverless)",
      monitoring: ["api_latency", "error_rate", "throughput"],
    },
    security: {
      sensitive: ["aiProviders", "fileStorage"],
      critical: ["restApi", "websocket"],
      encryption: "TLS",
      vulnerabilities: ["no_auth", "no_validation", "path_traversal"],
      mitigations: ["authentication_middleware", "input_validation", "path_sanitization"],
    },
    governance: {
      touchpoints: ["aiRoutes", "architectRoutes"],
      compliance: [],
      audit_trail: "required",
      approval_required: ["security_changes", "api_changes"],
      review_cycle: "monthly",
    },
  },
  metadata: {
    created: "2025-11-09T00:00:00Z",
    updated: "2025-11-09T00:00:00Z",
    author: "sev",
    tags: ["backend", "api", "nextjs"],
    maintainer: "sev",
    license: "MIT",
    documentation: {
      L0: "L0_executive.md",
      L1: "L1_overview.md",
      L2: "L2_architecture.md",
      L3: "L3_detailed.md",
      L4: "L4_complete.md",
    },
  },
}

