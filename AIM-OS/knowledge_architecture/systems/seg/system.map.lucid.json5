    {
      fromPort: "casIntegration",
      toSystem: "cas.cognitiveAnalysis",
      type: "stores_failure_patterns",
      data_flow: "failure_patterns \u2192 evidence_nodes",
    },
    {
      fromPort: "tcsIntegration",
      toSystem: "tcs.timelineContext",
      type: "transforms_timeline_entries",
      data_flow: "timeline_entries \u2192 evidence_nodes",
    },
    {
      fromPort: "graphDatabase",
      toSystem: "graph.neo4j",
      type: "stores_graph_data",
      data_flow: "graph_operations \u2192 persistent_storage",
    },
  ],
