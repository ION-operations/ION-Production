+++ b/ION/04_packages/kernel/ion_living_graph_view_model.py
@@ -0,0 +1,456 @@
+"""ION Living Operational Graph cockpit projection.
+
+This module is deliberately dependency-free.  It turns the candidate living graph
+bundle into a compact cockpit view model that can be rendered by the local JOC
+shell without guessing from chat memory or claiming live telemetry.
+
+The projection is visibility-only unless a later accepted adapter binds nodes,
+edges, or events to accepted/local evidence.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from collections import Counter
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Iterable
+
+CURRENT = Path("ION/05_context/current")
+LIVING_GRAPH = CURRENT / "living_graph"
+DEFAULT_BUNDLE = LIVING_GRAPH / "SAMPLE/living_operational_graph_sample_v0_3.json"
+DEFAULT_LAYOUT = LIVING_GRAPH / "LAYOUT/living_graph_layout_fixture_v0_3.json"
+OUTPUT = CURRENT / "ACTIVE_LIVING_GRAPH_VIEW_MODEL.json"
+
+REQUIRED_SCREEN_ZONES = {
+    "top_rail": {"role": "identity, KPI, search, global honesty badge"},
+    "left_drawer": {"role": "layers, filters, legend"},
+    "viewport": {"role": "central living operational graph territory"},
+    "right_inspector": {"role": "selected object truth surface"},
+    "bottom_timeline": {"role": "time axis and replay rail"},
+}
+
+DEFAULT_LAYERS = [
+    ("domains", "Domain districts", ("domain", "core")),
+    ("templates", "Templates and template groups", ("template", "template_group")),
+    ("carriers", "Carriers and agents", ("carrier", "agent", "operator")),
+    ("packets", "Packets, artifacts, and context", ("work_packet", "context_package", "artifact")),
+    ("receipts", "Receipts and settlements", ("receipt", "settlement")),
+    ("integrations", "Integrations and gateways", ("integration", "gateway")),
+    ("risk", "Risk and proof gates", ("risk_alert",)),
+]
+
+
+def utc_now() -> str:
+    return datetime.now(timezone.utc).replace(microsecond=0).isoformat()
+
+
+def _read_json(path: Path) -> dict[str, Any]:
+    try:
+        if not path.exists():
+            return {}
+        loaded = json.loads(path.read_text(encoding="utf-8"))
+        return loaded if isinstance(loaded, dict) else {"_read_error": "json_root_not_object", "_path": str(path)}
+    except Exception as exc:  # pragma: no cover - defensive projection
+        return {"_read_error": str(exc), "_path": str(path)}
+
+
+def _list(value: Any) -> list[Any]:
+    return value if isinstance(value, list) else []
+
+
+def _dict(value: Any) -> dict[str, Any]:
+    return value if isinstance(value, dict) else {}
+
+
+def _text(value: Any, fallback: str = "unknown") -> str:
+    if isinstance(value, str) and value.strip():
+        return value.strip()
+    if isinstance(value, (int, float, bool)):
+        return str(value)
+    return fallback
+
+
+def _counter_for(items: Iterable[dict[str, Any]], key: str) -> dict[str, int]:
+    return dict(Counter(_text(item.get(key), "unknown") for item in items))
+
+
+def _node_position(node: dict[str, Any], layout_index: dict[str, dict[str, Any]]) -> dict[str, Any]:
+    layout = _dict(node.get("layout"))
+    position = _dict(layout.get("world_position"))
+    if position:
+        return position
+    domain_id = _text(node.get("id"), "")
+    district = layout_index.get(domain_id)
+    if district:
+        return _dict(district.get("centroid"))
+    return {}
+
+
+def _safe_node_card(node: dict[str, Any], *, layout_index: dict[str, dict[str, Any]], child_count: int, route_count: int) -> dict[str, Any]:
+    inspector = _dict(node.get("inspector"))
+    tabs = _dict(inspector.get("tabs"))
+    honesty = _dict(node.get("data_honesty"))
+    visual = _dict(node.get("visual_style"))
+    layout = _dict(node.get("layout"))
+    return {
+        "id": _text(node.get("id")),
+        "label": _text(node.get("label")),
+        "type": _text(node.get("type")),
+        "domain_id": node.get("domain_id"),
+        "parent_id": node.get("parent_id"),
+        "authority_status": _text(node.get("authority_status"), "unclassified"),
+        "transition_authority_class": _text(node.get("transition_authority_class"), "unclassified"),
+        "operational_status": _text(node.get("operational_status"), "unknown"),
+        "proof_status": _text(node.get("proof_status"), "unknown"),
+        "honesty_status": _text(honesty.get("status"), "unknown"),
+        "honesty_badge_required": bool(honesty.get("requires_badge", True)),
+        "child_count": child_count,
+        "route_count": route_count,
+        "receipt_count": len(_list(node.get("receipts"))),
+        "tag_count": len(_list(node.get("tags"))),
+        "summary": _text(inspector.get("summary"), ""),
+        "available_tabs": sorted(tabs.keys()),
+        "position": _node_position(node, layout_index),
+        "height": layout.get("height"),
+        "risk_heat": visual.get("risk_heat", 0),
+        "color_token": visual.get("district_color_token"),
+    }
+
+
+def _edge_card(edge: dict[str, Any]) -> dict[str, Any]:
+    geometry = _dict(edge.get("road_geometry"))
+    traffic = _dict(edge.get("traffic_contract"))
+    honesty = _dict(edge.get("data_honesty"))
+    return {
+        "id": _text(edge.get("id")),
+        "type": _text(edge.get("type")),
+        "source": _text(edge.get("source")),
+        "target": _text(edge.get("target")),
+        "authority_class": _text(edge.get("authority_class"), "unclassified"),
+        "proof_required": bool(edge.get("proof_required")),
+        "state_can_cross": bool(edge.get("state_can_cross")),
+        "road_type": _text(edge.get("road_type"), "unclassified"),
+        "point_count": len(_list(geometry.get("curve_points"))),
+        "lane_count": geometry.get("lane_count"),
+        "timeline_track": traffic.get("timeline_track"),
+        "ambient_allowed": bool(traffic.get("ambient_allowed")),
+        "honesty_status": _text(honesty.get("status"), "unknown"),
+    }
+
+
+def _event_card(event: dict[str, Any]) -> dict[str, Any]:
+    honesty = _dict(event.get("data_honesty"))
+    return {
+        "id": _text(event.get("id")),
+        "timestamp": _text(event.get("timestamp")),
+        "event_type": _text(event.get("event_type")),
+        "actor_node": event.get("actor_node"),
+        "source_node": event.get("source_node"),
+        "target_node": event.get("target_node"),
+        "route_edge_id": event.get("route_edge_id"),
+        "timeline_track": _text(event.get("timeline_track"), "unknown"),
+        "status": _text(event.get("status"), "unknown"),
+        "severity": _text(event.get("severity"), "unknown"),
+        "receipt_ref": event.get("receipt_ref"),
+        "proof_ref": event.get("proof_ref"),
+        "honesty_status": _text(honesty.get("status"), "unknown"),
+    }
+
+
+def _validate_bundle(bundle: dict[str, Any]) -> dict[str, Any]:
+    findings: list[str] = []
+    nodes = [item for item in _list(bundle.get("nodes")) if isinstance(item, dict)]
+    edges = [item for item in _list(bundle.get("edges")) if isinstance(item, dict)]
+    events = [item for item in _list(bundle.get("events")) if isinstance(item, dict)]
+
+    node_ids = [_text(node.get("id"), "") for node in nodes]
+    edge_ids = [_text(edge.get("id"), "") for edge in edges]
+    event_ids = [_text(event.get("id"), "") for event in events]
+    node_set = {node_id for node_id in node_ids if node_id}
+    edge_set = {edge_id for edge_id in edge_ids if edge_id}
+
+    if not bundle:
+        findings.append("missing_bundle")
+    if bundle.get("_read_error"):
+        findings.append(f"bundle_read_error:{bundle.get('_read_error')}")
+    if not nodes:
+        findings.append("missing_nodes")
+    if len(node_ids) != len(node_set):
+        findings.append("duplicate_node_ids")
+    if len(edge_ids) != len({edge_id for edge_id in edge_ids if edge_id}):
+        findings.append("duplicate_edge_ids")
+    if len(event_ids) != len({event_id for event_id in event_ids if event_id}):
+        findings.append("duplicate_event_ids")
+
+    missing_edge_refs = [
+        edge.get("id")
+        for edge in edges
+        if edge.get("source") not in node_set or edge.get("target") not in node_set
+    ]
+    if missing_edge_refs:
+        findings.append(f"edge_reference_missing:{len(missing_edge_refs)}")
+
+    missing_event_refs = [
+        event.get("id")
+        for event in events
+        if (event.get("actor_node") and event.get("actor_node") not in node_set)
+        or (event.get("source_node") and event.get("source_node") not in node_set)
+        or (event.get("target_node") and event.get("target_node") not in node_set)
+        or (event.get("route_edge_id") and event.get("route_edge_id") not in edge_set)
+    ]
+    if missing_event_refs:
+        findings.append(f"event_reference_missing:{len(missing_event_refs)}")
+
+    unbadged_nodes = [node.get("id") for node in nodes if not _dict(node.get("data_honesty")).get("requires_badge", False)]
+    unbadged_edges = [edge.get("id") for edge in edges if not _dict(edge.get("data_honesty")).get("requires_badge", False)]
+    unbadged_events = [event.get("id") for event in events if not _dict(event.get("data_honesty")).get("requires_badge", False)]
+    if unbadged_nodes:
+        findings.append(f"node_honesty_badge_missing:{len(unbadged_nodes)}")
+    if unbadged_edges:
+        findings.append(f"edge_honesty_badge_missing:{len(unbadged_edges)}")
+    if unbadged_events:
+        findings.append(f"event_honesty_badge_missing:{len(unbadged_events)}")
+
+    return {
+        "ok": not findings,
+        "finding_count": len(findings),
+        "findings": findings,
+        "missing_edge_refs": missing_edge_refs[:12],
+        "missing_event_refs": missing_event_refs[:12],
+    }
+
+
+def _build_layers(nodes: list[dict[str, Any]], edges: list[dict[str, Any]], events: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    type_counts = Counter(_text(node.get("type")) for node in nodes)
+    layers: list[dict[str, Any]] = []
+    for layer_id, label, node_types in DEFAULT_LAYERS:
+        layers.append(
+            {
+                "id": layer_id,
+                "label": label,
+                "visible": True,
+                "node_types": list(node_types),
+                "node_count": sum(type_counts.get(node_type, 0) for node_type in node_types),
+            }
+        )
+    layers.append(
+        {
+            "id": "routes",
+            "label": "Routes and roads",
+            "visible": True,
+            "node_types": [],
+            "edge_count": len(edges),
+        }
+    )
+    layers.append(
+        {
+            "id": "timeline",
+            "label": "Timeline event traffic",
+            "visible": True,
+            "node_types": [],
+            "event_count": len(events),
+        }
+    )
+    return layers
+
+
+def build_living_graph_view_model(
+    root: str | Path = ".",
+    *,
+    bundle_path: str | Path | None = None,
+    layout_path: str | Path | None = None,
+    selected_node_id: str | None = None,
+) -> dict[str, Any]:
+    """Build a visibility-only living graph cockpit projection."""
+
+    root_path = Path(root)
+    bundle_rel = Path(bundle_path) if bundle_path is not None else DEFAULT_BUNDLE
+    layout_rel = Path(layout_path) if layout_path is not None else DEFAULT_LAYOUT
+    bundle_file = bundle_rel if bundle_rel.is_absolute() else root_path / bundle_rel
+    layout_file = layout_rel if layout_rel.is_absolute() else root_path / layout_rel
+
+    bundle = _read_json(bundle_file)
+    layout = _read_json(layout_file)
+    metadata = _dict(bundle.get("metadata"))
+    honesty = _dict(bundle.get("honesty"))
+    nodes = [item for item in _list(bundle.get("nodes")) if isinstance(item, dict)]
+    edges = [item for item in _list(bundle.get("edges")) if isinstance(item, dict)]
+    events = [item for item in _list(bundle.get("events")) if isinstance(item, dict)]
+    validation = _validate_bundle(bundle)
+
+    node_index = {_text(node.get("id")): node for node in nodes if node.get("id")}
+    layout_districts = [item for item in _list(layout.get("districts")) if isinstance(item, dict)]
+    layout_index = {_text(item.get("domain_id")): item for item in layout_districts if item.get("domain_id")}
+
+    child_counts = Counter(_text(node.get("parent_id"), "") for node in nodes if node.get("parent_id"))
+    route_counts = Counter()
+    for edge in edges:
+        route_counts[_text(edge.get("source"), "")] += 1
+        route_counts[_text(edge.get("target"), "")] += 1
+
+    domains = [
+        _safe_node_card(node, layout_index=layout_index, child_count=child_counts.get(_text(node.get("id")), 0), route_count=route_counts.get(_text(node.get("id")), 0))
+        for node in nodes
+        if node.get("type") == "domain"
+    ]
+    domains.sort(key=lambda item: item.get("label", ""))
+
+    core_node = next((node for node in nodes if node.get("type") == "core"), nodes[0] if nodes else {})
+    selected_raw = node_index.get(selected_node_id or "", {}) or core_node
+    selected = (
+        _safe_node_card(
+            selected_raw,
+            layout_index=layout_index,
+            child_count=child_counts.get(_text(selected_raw.get("id")), 0),
+            route_count=route_counts.get(_text(selected_raw.get("id")), 0),
+        )
+        if selected_raw
+        else {}
+    )
+
+    type_counts = _counter_for(nodes, "type")
+    edge_type_counts = _counter_for(edges, "type")
+    event_track_counts = _counter_for(events, "timeline_track")
+    event_status_counts = _counter_for(events, "status")
+    timeline = _dict(bundle.get("timeline"))
+    inspector_contract = _dict(bundle.get("inspector_contract"))
+
+    screen_zones = _dict(layout.get("screen_zones")) or REQUIRED_SCREEN_ZONES
+    missing_zones = [zone for zone in REQUIRED_SCREEN_ZONES if zone not in screen_zones]
+
+    route_edges = [_edge_card(edge) for edge in edges if edge.get("type") == "routes_to"]
+    route_edges = route_edges[:16]
+    latest_events = sorted((_event_card(event) for event in events), key=lambda item: item.get("timestamp", ""))[:12]
+
+    status = "ready" if validation["ok"] and bundle else "degraded" if bundle else "missing_source"
+    if bundle.get("_read_error"):
+        status = "invalid_source"
+
+    live_telemetry_connected = bool(honesty.get("live_telemetry_connected"))
+    return {
+        "schema_id": "ion.living_graph_cockpit_view_model.v1",
+        "generated_at": utc_now(),
+        "status": status,
+        "data_mode": _text(metadata.get("data_status"), _text(honesty.get("default_status"), "sample")),
+        "source_package_id": metadata.get("package_id"),
+        "source_paths": {
+            "bundle": str(bundle_rel),
+            "layout": str(layout_rel),
+            "visual_reference": _dict(bundle.get("layout_refs")).get("visual_reference"),
+        },
+        "honesty": {
+            "global_badge_label": honesty.get("global_badge_label") or "SAMPLE / CANDIDATE DATA",
+            "requires_badge": bool(honesty.get("requires_badge", True)),
+            "default_status": honesty.get("default_status") or "sample",
+            "live_telemetry_connected": live_telemetry_connected,
+            "non_claim": honesty.get("non_claim") or "No live graph claim is made by this projection.",
+        },
+        "kpis": {
+            "node_count": len(nodes),
+            "domain_count": len(domains),
+            "edge_count": len(edges),
+            "event_count": len(events),
+            "timeline_track_count": len(_list(timeline.get("tracks"))),
+            "proof_required_route_count": sum(1 for edge in edges if edge.get("proof_required")),
+            "risk_node_count": type_counts.get("risk_alert", 0),
+            "live_telemetry_connected": live_telemetry_connected,
+        },
+        "node_type_counts": type_counts,
+        "edge_type_counts": edge_type_counts,
+        "timeline_track_counts": event_track_counts,
+        "event_status_counts": event_status_counts,
+        "screen_zones": screen_zones,
+        "missing_screen_zones": missing_zones,
+        "layers": _build_layers(nodes, edges, events),
+        "core": _safe_node_card(core_node, layout_index=layout_index, child_count=child_counts.get(_text(core_node.get("id")), 0), route_count=route_counts.get(_text(core_node.get("id")), 0)) if core_node else {},
+        "selected": selected,
+        "domains": domains,
+        "route_edges": route_edges,
+        "timeline": {
+            "mode": timeline.get("mode"),
+            "tracks": _list(timeline.get("tracks")),
+            "window": _dict(timeline.get("window")),
+            "playback": _dict(timeline.get("playback")),
+            "event_count": len(events),
+            "latest_events": latest_events,
+        },
+        "inspector_contract": {
+            "tabs_required": _list(inspector_contract.get("tabs_required")),
+            "empty_state": inspector_contract.get("empty_state"),
+            "raw_json_policy": inspector_contract.get("raw_json_policy"),
+        },
+        "layout": {
+            "schema_id": layout.get("schema_id"),
+            "status": layout.get("status"),
+            "coordinate_system": layout.get("coordinate_system"),
+            "camera_presets": layout.get("camera_presets"),
+            "minimap": layout.get("minimap"),
+            "district_count": len(layout_districts),
+            "screen_zone_count": len(screen_zones),
+        },
+        "validation": validation,
+        "authority": {
+            "accepted_state": False,
+            "production_authority": False,
+            "live_execution_authority": False,
+            "unrestricted_filesystem_mutation": False,
+            "telemetry_claim_authority": live_telemetry_connected,
+            "settlement_required_for_inheritance": True,
+            "authority_ceiling": "sample_candidate_visibility_projection",
+        },
+        "proof_gates": {
+            "bundle_present": bundle_file.exists(),
+            "layout_present": layout_file.exists(),
+            "bundle_parses": bool(bundle) and not bundle.get("_read_error"),
+            "layout_parses": bool(layout) and not layout.get("_read_error"),
+            "references_resolve": not any(item.startswith("edge_reference_missing") or item.startswith("event_reference_missing") for item in validation["findings"]),
+            "honesty_badges_required": bool(honesty.get("requires_badge", True)),
+            "no_live_label_without_adapter": not live_telemetry_connected,
+            "required_zones_present": not missing_zones,
+        },
+        "non_claims": [
+            "not_accepted_ion_state",
+            "not_live_telemetry",
+            "not_production_authority",
+            "not_queue_worker",
+            "not_runtime_mutation",
+        ],
+    }
+
+
+def write_living_graph_view_model(root: str | Path = ".") -> dict[str, Any]:
+    root_path = Path(root)
+    model = build_living_graph_view_model(root_path)
+    out = root_path / OUTPUT
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(model, indent=2, sort_keys=True), encoding="utf-8")
+    return model
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="Build the ION Living Operational Graph cockpit view model.")
+    parser.add_argument("--root", default=".", help="ION repository root")
+    parser.add_argument("--bundle", default=None, help="Optional bundle path, relative to root unless absolute")
+    parser.add_argument("--layout", default=None, help="Optional layout path, relative to root unless absolute")
+    parser.add_argument("--selected-node-id", default=None, help="Optional selected node id")
+    parser.add_argument("--write", action="store_true", help="Write ACTIVE_LIVING_GRAPH_VIEW_MODEL.json")
+    args = parser.parse_args(argv)
+
+    model = build_living_graph_view_model(
+        args.root,
+        bundle_path=args.bundle,
+        layout_path=args.layout,
+        selected_node_id=args.selected_node_id,
+    )
+    if args.write:
+        out = Path(args.root) / OUTPUT
+        out.parent.mkdir(parents=True, exist_ok=True)
+        out.write_text(json.dumps(model, indent=2, sort_keys=True), encoding="utf-8")
+    print(json.dumps(model, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())

