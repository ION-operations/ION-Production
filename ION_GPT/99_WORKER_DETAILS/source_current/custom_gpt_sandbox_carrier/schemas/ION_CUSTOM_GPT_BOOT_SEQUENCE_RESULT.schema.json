{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "ion_boot_sequence_result": {
      "properties": {
        "accepted_state_claim": {
          "const": false
        },
        "active_workflow_object": {
          "type": "string"
        },
        "boot_id": {
          "type": "string"
        },
        "live_execution_authority": {
          "const": false
        },
        "mounted_packages": {
          "required": [
            "count",
            "posture"
          ],
          "type": "object"
        },
        "objective": {
          "type": "string"
        },
        "persona_return_gate": {
          "enum": [
            "pass",
            "blocked"
          ]
        },
        "phases_completed": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "production_authority": {
          "const": false
        },
        "receipt_status": {
          "enum": [
            "candidate_boot_receipt",
            "candidate_work_receipt",
            "blocked_receipt"
          ]
        },
        "route_id": {
          "type": "string"
        },
        "schema_id": {
          "const": "ion.boot_sequence_result.v1"
        }
      },
      "required": [
        "schema_id",
        "boot_id",
        "route_id",
        "mounted_packages",
        "objective",
        "active_workflow_object",
        "phases_completed",
        "persona_return_gate",
        "accepted_state_claim",
        "production_authority",
        "live_execution_authority",
        "receipt_status"
      ],
      "type": "object"
    }
  },
  "required": [
    "ion_boot_sequence_result"
  ],
  "title": "ION Custom GPT Boot Sequence Result",
  "type": "object"
}
