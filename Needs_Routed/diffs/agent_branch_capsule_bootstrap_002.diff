+def _branch_capsule_bootstrap_summary(shell_root: Path, model: Mapping[str, Any]) -> str:
+    """Return read-only branch-capsule startup law for Codex SessionStart."""
+    packages = ((model.get("context_packages") or {}).get("packages") or [])
+    selected = set((model.get("context_packages") or {}).get("selected_by_default") or [])
+    package_present = any(
+        isinstance(package, Mapping)
+        and package.get("package_id") == "agent_branch_capsule_bootstrap_package"
+        for package in packages
+    )
+    path_state = {
+        "protocol": (shell_root / BRANCH_CAPSULE_PROTOCOL_PATH).is_file(),
+        "bootstrap_protocol": (shell_root / BRANCH_CAPSULE_BOOTSTRAP_PROTOCOL_PATH).is_file(),
+        "branch_registry": (shell_root / BRANCH_CAPSULE_REGISTRY_PATH).is_file(),
+        "settlement_registry": (shell_root / CONTEXT_SETTLEMENT_REGISTRY_PATH).is_file(),
+        "runtime_helper": (shell_root / AGENT_BRANCH_CAPSULE_HELPER_PATH).is_file(),
+        "package_present": package_present,
+        "selected_by_default": "agent_branch_capsule_bootstrap_package" in selected,
+    }
+    return "\n".join(
+        [
+            "Branch-capsule bootstrap status:",
+            json.dumps(path_state, indent=2, sort_keys=True),
+            "",
+            "Material-work law:",
+            "- Shared Codex solo context is read-only base memory.",
+            "- Every active agent/conversation/task doing material work needs a unique branch capsule identity.",
+            "- Required identity fields: context_instance_id, branch_id, conversation_tag, agent_tag, task_tag, parent_context_id, loaded_refs, write_scope.",
+            "- Agents must not directly edit CAPSULE.md, MINI.md, HOT_CONTEXT.md, STATUS.json, ROUTE.json, or assign C-numbers.",
+            "- Candidate branch results go to branch SETTLEMENT_REQUESTS/ and ION/05_context/current/context_settlement/inbox/.",
+            "- Only context settlement may promote branch outputs into shared context.",
+            "",
+            "Route refs:",
+            f"- {BRANCH_CAPSULE_PROTOCOL_PATH.as_posix()}",
+            f"- {BRANCH_CAPSULE_BOOTSTRAP_PROTOCOL_PATH.as_posix()}",
+            f"- {BRANCH_CAPSULE_REGISTRY_PATH.as_posix()}",
+            f"- {CONTEXT_SETTLEMENT_REGISTRY_PATH.as_posix()}",
+            f"- {AGENT_BRANCH_CAPSULE_HELPER_PATH.as_posix()}",
+        ]
+    )
+
