      toSystem: "cmc.contextMemoryCore",
      type: "stores_analysis_data",
      pattern: "store",
      connectionType: "storage",
      data_flow: "cognitive_data → persistent_storage, atom_metadata ← consistency_checks",
      bidirectional: true,
      tags: ["CMC-STORAGE", "CAS-META"],
    },
    {
      fromPort: "sdfcvfIntegration",
      toSystem: "sdfcvf.atomicEvolution",
      type: "provides_quality_insights",
      pattern: "provide",
      connectionType: "provision",
      data_flow: "cognitive_analysis → quality_metrics, failure_context ← quality_insights",
      bidirectional: true,
      tags: ["SDF-CVF-PROVIDE", "CAS-META"],
    },
    {
      fromPort: "segIntegration",
      toSystem: "seg.sharedEvidenceGraph",
      type: "maps_cognitive_connections",
      pattern: "map",
      connectionType: "mapping",
      data_flow: "cognitive_connections → evidence_nodes, graph_queries ← synthesis_insights",
      bidirectional: true,
      tags: ["SEG-MAP", "CAS-META"],
      note: "Uses SEG general API (no formal port, documented as relatedSystem)",
    },
    {
      fromPort: "tcsIntegration",
      toSystem: "tcs.timelineContextSystem",
      type: "uses_timeline_entries",
      pattern: "use",
      connectionType: "usage",
      data_flow: "timeline_entries → meta_pattern_analysis, cognitive_metrics ← timeline_queries",
      bidirectional: true,
      tags: ["TCS-USE", "CAS-META"],
    },
    {
      fromPort: "iisIntegration",
      toSystem: "iis.intuitiveIntelligenceSystem",
      type: "audits_intuition_patterns",
      pattern: "audit",
      connectionType: "audit",
      data_flow: "intuition_patterns → audit_analysis, audit_results ← pattern_validation",
      bidirectional: true,
      tags: ["IIS-AUDIT", "CAS-META"],
      note: "IIS is separate system, CAS monitors it",
    },
  ],
