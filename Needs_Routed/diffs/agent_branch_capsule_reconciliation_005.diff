+def _branch_record_paths(root: str | Path) -> tuple[Path, ...]:
+    shell_root = _shell_root(root)
+    branch_root = shell_root / BRANCH_ROOT
+    if not branch_root.exists():
+        return ()
+    return tuple(sorted(branch_root.glob("*/*/*/BRANCH_RECORD.json")))
+
+
+def _branch_dir_from_record_path(path: Path) -> Path:
+    return path.parent
+
+
+def _relative_to_root(shell_root: Path, path: Path) -> str:
+    try:
+        return path.relative_to(shell_root).as_posix()
+    except ValueError:
+        return path.as_posix()
+
+
+def load_branch_records(root: str | Path) -> tuple[dict[str, Any], ...]:
+    """Load all branch records from the branch capsule tree.
+
+    This is a read-only scan. Invalid JSON records are represented as blocked
+    scan records so reconciliation can surface them without crashing.
+    """
+
+    shell_root = _shell_root(root)
+    loaded: list[dict[str, Any]] = []
+    for path in _branch_record_paths(shell_root):
+        try:
+            data = json.loads(path.read_text(encoding="utf-8"))
+            if isinstance(data, dict):
+                data = dict(data)
+            else:
+                data = {"schema_id": "ion.agent_branch_capsule.invalid_record.v1", "finding": "branch_record_not_object"}
+        except json.JSONDecodeError:
+            data = {"schema_id": "ion.agent_branch_capsule.invalid_record.v1", "finding": "branch_record_invalid_json"}
+        data["_record_path"] = _relative_to_root(shell_root, path)
+        data["_branch_dir"] = _relative_to_root(shell_root, path.parent)
+        loaded.append(data)
+    return tuple(loaded)
+
+
+def _settlement_request_count(shell_root: Path, branch_dir: Path) -> int:
+    requests = branch_dir / "SETTLEMENT_REQUESTS"
+    if not requests.exists():
+        return 0
+    return len([path for path in requests.glob("*.json") if path.is_file()])
+
+
+def _branch_status_payload(branch_dir: Path) -> dict[str, Any]:
+    return _read_json(branch_dir / "STATUS.json", {})
+
+
+def reconcile_branch_registry(
+    root: str | Path,
+    *,
+    write: bool = False,
+    confirmation: str | None = None,
+) -> dict[str, Any]:
+    """Reconcile branch registry state against branch capsule records.
+
+    Read-only mode reports stale registry rows, missing registry rows, branch
+    validation failures, write-scope collisions, and missing settlement
+    requests. Write mode may repair the registry and emit a reconciliation
+    report, but it never mutates shared Codex solo context or assigns
+    checkpoints.
+    """
+
+    if write and confirmation != WRITE_CONFIRMATION_TOKEN:
+        return {
+            "schema_id": "ion.agent_branch_capsule.registry_reconciliation.v1",
+            "ok": False,
+            "verdict": BLOCKED_VERDICT,
+            "findings": ["write_confirmation_required"],
+            "repaired_findings": [],
+            "production_authority": False,
+            "live_execution_authority": False,
+            "mutates_shared_context": False,
+            "mutates_branch_registry": False,
+        }
+
+    shell_root = _shell_root(root)
+    registry_path = shell_root / BRANCH_REGISTRY_PATH
+    registry = _read_json(registry_path, {})
+    registry_branches = [
+        branch for branch in (registry.get("active_branches") or ())
+        if isinstance(branch, dict)
+    ]
+
+    records = list(load_branch_records(shell_root))
+    record_by_id = {
+        record.get("branch_id"): record
+        for record in records
+        if record.get("branch_id")
+    }
+    registry_by_id = {
+        branch.get("branch_id"): branch
+        for branch in registry_branches
+        if branch.get("branch_id")
+    }
+
+    blocking_findings: list[str] = []
+    repairable_findings: list[str] = []
+    branch_reports: list[dict[str, Any]] = []
+
+    for branch_id in sorted(set(record_by_id) - set(registry_by_id)):
+        repairable_findings.append(f"registry_missing_branch_record:{branch_id}")
+
+    for branch_id, branch in sorted(registry_by_id.items()):
+        branch_path = branch.get("branch_path")
+        record_path = shell_root / str(branch_path or "") / "BRANCH_RECORD.json"
+        if branch_id not in record_by_id or not record_path.exists():
+            repairable_findings.append(f"registry_stale_branch:{branch_id}")
+
+    for record in records:
+        branch_id = record.get("branch_id") or "unknown"
+        branch_dir = shell_root / str(record.get("_branch_dir") or "")
+        other_claims = [
+            {
+                "claim_id": other.get("branch_id"),
+                "branch_id": other.get("branch_id"),
+                "write_scope": other.get("write_scope") or (),
+            }
+            for other in records
+            if other.get("branch_id") and other.get("branch_id") != branch_id
+        ]
+        validation = validate_branch_record(shell_root, record, active_claims=other_claims)
+        status_payload = _branch_status_payload(branch_dir)
+        settlement_count = _settlement_request_count(shell_root, branch_dir)
+        record_findings = list(validation.get("findings") or ())
+
+        if record.get("settlement_required") is True and settlement_count == 0:
+            record_findings.append(f"settlement_request_missing:{branch_id}")
+
+        if not (branch_dir / "STATUS.json").exists():
+            record_findings.append(f"branch_status_missing:{branch_id}")
+        elif status_payload.get("shared_context_write") is not False:
+            record_findings.append(f"branch_status_shared_context_write_not_false:{branch_id}")
+
+        if record_findings:
+            blocking_findings.extend(record_findings)
+
+        branch_reports.append(
+            {
+                "branch_id": branch_id,
+                "context_instance_id": record.get("context_instance_id"),
+                "conversation_tag": record.get("conversation_tag"),
+                "agent_tag": record.get("agent_tag"),
+                "task_tag": record.get("task_tag"),
+                "branch_path": record.get("branch_path"),
+                "record_path": record.get("_record_path"),
+                "write_scope": list(record.get("write_scope") or ()),
+                "loaded_refs": list(record.get("loaded_refs") or ()),
+                "settlement_request_count": settlement_count,
+                "status": "DRIFTED_BLOCKED" if record_findings else "ACTIVE_PROVISIONAL",
+                "findings": record_findings,
+            }
+        )
+
+    findings = list(blocking_findings)
+    repaired_findings: list[str] = []
+    if write:
+        repaired_findings = list(repairable_findings)
+    else:
+        findings.extend(repairable_findings)
+
+    ok = not findings
+    payload = {
+        "schema_id": "ion.agent_branch_capsule.registry_reconciliation.v1",
+        "ok": ok,
+        "verdict": READY_VERDICT if ok else BLOCKED_VERDICT,
+        "generated_at": _now(),
+        "branch_root": BRANCH_ROOT.as_posix(),
+        "registry_path": BRANCH_REGISTRY_PATH.as_posix(),
+        "report_path": BRANCH_RECONCILIATION_REPORT_PATH.as_posix(),
+        "branch_count": len(branch_reports),
+        "branches": branch_reports,
+        "findings": findings,
+        "repaired_findings": repaired_findings,
+        "production_authority": False,
+        "live_execution_authority": False,
+        "mutates_shared_context": False,
+        "mutates_branch_registry": bool(write),
+    }
+
+    if write:
+        registry_payload = {
+            "schema_id": "ion.agent_branch_capsule.registry.v1",
+            "created_at": registry.get("created_at") or _now(),
+            "updated_at": _now(),
+            "status": "ACTIVE_PROVISIONAL" if ok else "DRIFTED_BLOCKED",
+            "protocol": PROTOCOL_PATH.as_posix(),
+            "reconciliation_protocol": BRANCH_RECONCILIATION_PROTOCOL_PATH.as_posix(),
+            "branch_root": BRANCH_ROOT.as_posix(),
+            "settlement_inbox": SETTLEMENT_INBOX.as_posix(),
+            "reconciliation_report": BRANCH_RECONCILIATION_REPORT_PATH.as_posix(),
+            "active_branches": [
+                {
+                    "branch_id": branch["branch_id"],
+                    "context_instance_id": branch["context_instance_id"],
+                    "conversation_tag": branch["conversation_tag"],
+                    "agent_tag": branch["agent_tag"],
+                    "task_tag": branch["task_tag"],
+                    "branch_path": branch["branch_path"],
+                    "write_scope": branch["write_scope"],
+                    "loaded_refs": branch["loaded_refs"],
+                    "status": branch["status"],
+                    "settlement_required": True,
+                    "shared_context_write": False,
+                }
+                for branch in branch_reports
+            ],
+            "authority": {
+                "production_authority": False,
+                "live_execution_authority": False,
+                "secrets_authority": False,
+                "browser_control_authority": False,
+            },
+        }
+        _write_json(registry_path, registry_payload)
+        _write_json(shell_root / BRANCH_RECONCILIATION_REPORT_PATH, payload)
+
+    return payload
+
+
+def build_branch_cockpit_snapshot(root: str | Path) -> dict[str, Any]:
+    """Build a human/operator-facing branch health snapshot."""
+
+    reconciliation = reconcile_branch_registry(root, write=False)
+    branches = reconciliation.get("branches") or []
+    blocked = [branch for branch in branches if branch.get("findings")]
+    return {
+        "schema_id": "ion.agent_branch_capsule.cockpit_snapshot.v1",
+        "ok": reconciliation.get("ok"),
+        "verdict": reconciliation.get("verdict"),
+        "generated_at": _now(),
+        "branch_count": len(branches),
+        "blocked_branch_count": len(blocked),
+        "active_branch_count": len(branches) - len(blocked),
+        "branches": [
+            {
+                "branch_id": branch.get("branch_id"),
+                "conversation_tag": branch.get("conversation_tag"),
+                "agent_tag": branch.get("agent_tag"),
+                "task_tag": branch.get("task_tag"),
+                "write_scope": branch.get("write_scope") or [],
+                "settlement_request_count": branch.get("settlement_request_count", 0),
+                "status": branch.get("status"),
+                "findings": branch.get("findings") or [],
+            }
+            for branch in branches
+        ],
+        "registry_findings": reconciliation.get("findings") or [],
+        "production_authority": False,
+        "live_execution_authority": False,
+        "mutates_shared_context": False,
+    }
+
+
 
 
