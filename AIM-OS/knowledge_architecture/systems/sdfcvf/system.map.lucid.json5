{
  systemId: "sdfcvf.atomicEvolution",
  systemName: "Atomic Evolution Framework - Quality Assurance and Change Management",
  version: "v2.2.0",
  status: "production",
  layer: 2,
  description: "Quality assurance system that enforces 'quartet parity' (code, docs, tests, traces) and manages atomic evolution of AIM-OS components. Think 'AI's quality gatekeeper' - ensures every change is complete, tested, and traceable.",
  internalNodes: [
    {
      id: "quartetValidator",
      kind: "core.component",
      responsibility: "Enforces quartet parity (code, docs, tests, traces) for all changes",
      status: "production",
      must_never: [
        "Allow changes without quartet parity",
        "Skip validation for any component",
        "Modify validation rules without approval",
      ],
      perf_budget_ms: 20,
      security_level: "critical",
    },
    {
      id: "atomicChangeManager",
      kind: "core.component",
      responsibility: "Manages atomic changes with proper rollback capabilities",
      status: "production",
      must_never: [
        "Allow partial changes to proceed",
        "Lose rollback information",
        "Create inconsistent change states",
      ],
      perf_budget_ms: 15,
      security_level: "high",
    },
    {
      id: "blastRadiusCalculator",
      kind: "analysis.component",
      responsibility: "Calculates blast radius and impact analysis for changes",
      status: "production",
      must_never: [
        "Underestimate change impact",
        "Miss critical dependencies",
        "Lose impact analysis data",
      ],
      perf_budget_ms: 25,
      security_level: "high",
    },
    {
      id: "doraMetricsTracker",
      kind: "metrics.component",
      responsibility: "Tracks DORA metrics (Deployment Frequency, Lead Time, MTTR, Change Failure Rate)",
      status: "production",
      must_never: [
        "Lose metrics data",
        "Calculate metrics incorrectly",
        "Expose sensitive metrics data",
      ],
      perf_budget_ms: 10,
      security_level: "medium",
    },
    {
      id: "qualityGateManager",
      kind: "gating.component",
      responsibility: "Manages quality gates and approval workflows",
      status: "production",
      must_never: [
        "Bypass quality gates",
        "Allow unapproved changes",
        "Lose gate decision reasoning",
      ],
      perf_budget_ms: 8,
      security_level: "high",
    },
    {
      id: "traceabilityEngine",
      kind: "trace.component",
      responsibility: "Maintains complete traceability for all changes and decisions",
      status: "production",
      must_never: [
        "Lose trace information",
        "Create incomplete traces",
        "Allow trace tampering",
      ],
      perf_budget_ms: 12,
      security_level: "critical",
    },
    {
      id: "evolutionTracker",
      kind: "tracking.component",
      responsibility: "Tracks evolution of components and their relationships",
      status: "production",
      must_never: [
        "Lose evolution history",
        "Create inconsistent evolution records",
        "Allow evolution data corruption",
      ],
      perf_budget_ms: 18,
      security_level: "medium",
    },
    {
      id: "consistencyChecker",
      kind: "consistency.component",
      responsibility: "Ensures consistency across all quartet components",
      status: "production",
      must_never: [
        "Allow inconsistent quartet components",
        "Skip consistency checks",
        "Lose consistency reasoning",
      ],
      perf_budget_ms: 22,
      security_level: "high",
    },
    {
      id: "rollbackManager",
      kind: "rollback.component",
      responsibility: "Manages rollback operations and state restoration",
      status: "production",
      must_never: [
        "Lose rollback capabilities",
        "Allow partial rollbacks",
        "Create inconsistent rollback states",
      ],
      perf_budget_ms: 30,
      security_level: "critical",
    },
    {
      id: "complianceMonitor",
      kind: "monitoring.component",
      responsibility: "Monitors compliance with evolution standards and policies",
      status: "production",
      must_never: [
        "Skip compliance checks",
        "Lose compliance data",
        "Allow non-compliant changes",
      ],
      perf_budget_ms: 14,
      security_level: "high",
    },
  ],
  subsystems: [
    {
      id: "quartet",
      name: "Quartet Parity Subsystem",
      type: "subsystem",
      parent: "sdfcvf.atomicEvolution",
      status: "production",
      description: "Enforces atomic evolution of code + docs + tests + traces. Detects missing elements, blocks incomplete changes, guides developers to complete the quartet",
      meetsCriteria: ["complexity", "independence", "relationship", "evolution"],
      documentation: {
        L0: "components/quartet/README.md",
        README: "components/quartet/README.md",
      },
      relationships: {
        parent: "sdfcvf.atomicEvolution",
        children: ["parity"],
        siblings: ["gates", "blast_radius", "dora"],
        external: ["cmc", "vif"],
      },
      components: [
        {
          id: "quartetDetector",
          layer: 3,
          purpose: "Identifies quartet elements (code, docs, tests, traces) from changes",
          integrationPoints: [
            { system: "vif", tag: "[VIF-WITNESS]" },
            { system: "cmc", tag: "[CMC-STORAGE]" },
          ],
        },
        {
          id: "completenessChecker",
          layer: 3,
          purpose: "Validates quartet completeness (all 4 elements present)",
          integrationPoints: [
            { system: "cmc", tag: "[CMC-SNAPSHOT]" },
          ],
        },
        {
          id: "fileClassifier",
          layer: 3,
          purpose: "Classifies files into quartet categories (code, docs, tests, traces)",
          integrationPoints: [],
        },
      ],
      integrationPoints: [
        {
          system: "cmc",
          tag: "[CMC-STORAGE]",
          reverseTag: "[SDFCVF-QUARTET]",
          purpose: "Quartet snapshots stored in CMC atoms",
          type: "required",
          bidirectional: true,
        },
        {
          system: "cmc",
          tag: "[CMC-SNAPSHOT]",
          reverseTag: "[SDFCVF-VALIDATION]",
          purpose: "Quartet validation uses CMC snapshots",
          type: "required",
          bidirectional: true,
        },
        {
          system: "vif",
          tag: "[VIF-WITNESS]",
          reverseTag: "[SDFCVF-TRACE]",
          purpose: "Quartet changes witnessed by VIF",
          type: "required",
          bidirectional: true,
        },
      ],
    },
    {
      id: "parity",
      name: "Parity Validation Subsystem",
      type: "subsystem",
      parent: "sdfcvf.atomicEvolution",
      status: "production",
      description: "Validates quartet parity (code, docs, tests, traces) and ensures semantic alignment across all four elements",
      meetsCriteria: ["complexity", "independence", "relationship", "evolution"],
      documentation: {
        L0: "components/parity/README.md",
        README: "components/parity/README.md",
      },
      relationships: {
        parent: "sdfcvf.atomicEvolution",
        children: [],
        siblings: ["quartet", "gates", "blast_radius", "dora"],
        external: ["cmc"],
      },
      components: [
        {
          id: "embeddingService",
          layer: 3,
          purpose: "Generates embeddings for quartet elements (code, docs, tests, traces)",
          integrationPoints: [
            { system: "vif", tag: "[VIF-WITNESS]" },
          ],
        },
        {
          id: "similarityCalculator",
          layer: 3,
          purpose: "Calculates cosine similarity between embeddings",
          integrationPoints: [],
        },
        {
          id: "parityResultGenerator",
          layer: 3,
          purpose: "Generates ParityResult with 6-pair formula",
          integrationPoints: [
            { system: "cmc", tag: "[CMC-STORAGE]" },
          ],
        },
      ],
      integrationPoints: [
        {
          system: "cmc",
          tag: "[CMC-STORAGE]",
          reverseTag: "[SDFCVF-PARITY]",
          purpose: "Parity validation results stored in CMC",
          type: "required",
          bidirectional: true,
        },
      ],
    },
    {
      id: "gates",
      name: "Quality Gate Subsystem",
      type: "subsystem",
      parent: "sdfcvf.atomicEvolution",
      status: "production",
      description: "Manages quality gates and approval workflows for atomic changes. Enforces quartet parity gates",
      meetsCriteria: ["complexity", "independence", "relationship", "evolution"],
      documentation: {
        L0: "components/gates/README.md",
        README: "components/gates/README.md",
      },
      relationships: {
        parent: "sdfcvf.atomicEvolution",
        children: [],
