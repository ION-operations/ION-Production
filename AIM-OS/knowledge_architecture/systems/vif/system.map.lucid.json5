      ],
      security_level: "high",
    },
    {
      portId: "tcsIntegration",
      direction: "bidirectional",
      connectsToSystem: "tcs.timelineContext",
      protocol: "internal_api",
      whatIsExchanged: [
        "witness_timeline_entries",
        "kappa_gate_events",
        "timeline_queries",
        "snapshot_queries",
        "confidence_queries",
      ],
      security_level: "high",
    },
    {
      portId: "casIntegration",
      direction: "bidirectional",
      connectsToSystem: "cas.cognitiveAnalysis",
      protocol: "internal_api",
