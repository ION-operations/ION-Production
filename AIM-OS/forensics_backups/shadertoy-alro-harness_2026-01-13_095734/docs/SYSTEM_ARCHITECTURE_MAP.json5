      file: "main.js",
      responsibilities: [
        "Fetch GLSL sources from `shaders/*.glsl`",
        "Wrap Shadertoy-style fragments with WebGL2 boilerplate (`#version 300 es`, precision, uniforms, main())",
        "Compile + link programs per pass",
        "Patch shader source for harness camera override (image.glsl)",
        "Handle FAST mode shader variant generation",
        "Cache compiled programs for reuse",
      ],
      interfaces: {
        inputs: ["Shader files on disk (via Fetch API)", "Shader wrapping configuration"],
        outputs: ["WebGLProgram objects per pass", "Uniform locations tables", "Compilation errors"],
