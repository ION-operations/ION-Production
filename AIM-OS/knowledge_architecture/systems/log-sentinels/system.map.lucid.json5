{
  systemId: "log-sentinels.hybridLogAnalysis",
  systemName: "Log-Sentinels (Hybrid Log Analysis System) - Privacy-First Proactive Issue Detection",
  version: "v1.0.0",
  status: "production",
  layer: 3,
  description: "Hybrid log analysis system providing fast cloud summaries (Cerebras Scout) and deep local forensics (Ollama). Privacy-first: cloud sees only redacted/templated windows; local has raw for deep analysis. Escalates based on severity, confidence, novelty.",
  purpose: "Enables proactive issue detection with privacy protection through hybrid cloud/local analysis",
  dependencies: ["router", "seg", "vif", "cmc", "tcs"],
  internalNodes: [
    {
      id: "logSentinelsPipeline",
      kind: "core.component",
      responsibility: "Main orchestrator coordinating collectors, normalizer, template miner, windower, scout, forensics, router policy",
      status: "production",
      must_never: [
        "Skip PII redaction",
        "Send raw logs to cloud",
        "Bypass escalation logic",
        "Lose log records",
      ],
      perf_budget_ms: 1000,
      security_level: "critical",
    },
    {
      id: "logCollector",
      kind: "collection.component",
      responsibility: "Abstract base for log sources. Implementations: BrowserConsoleCollector (WebSocket), TerminalCollector (file), BackendAPICollector (OTEL)",
      status: "production",
      must_never: [
        "Lose log records",
        "Skip source validation",
        "Allow unauthorized access",
        "Bypass rate limits",
      ],
      perf_budget_ms: 50,
      security_level: "high",
    },
    {
      id: "logNormalizer",
      kind: "privacy.component",
      responsibility: "PII redaction before cloud calls. Pattern-based redaction (regex), hash raw for local storage, preserve structure",
      status: "production",
      must_never: [
        "Send raw logs to cloud",
        "Skip redaction patterns",
        "Lose raw hash references",
        "Bypass privacy checks",
      ],
      perf_budget_ms: 10,
      security_level: "critical",
    },
    {
      id: "logTemplateMiner",
      kind: "analysis.component",
      responsibility: "Template extraction using Drain3 algorithm. Clusters similar logs, computes novelty scores, cache management (LRU, 5000 templates)",
      status: "production",
      must_never: [
        "Lose template cache",
        "Skip novelty computation",
        "Allow cache corruption",
        "Bypass clustering",
      ],
      perf_budget_ms: 100,
      security_level: "low",
    },
    {
      id: "windower",
      kind: "windowing.component",
      responsibility: "Time-based windowing system. Rolling windows (60s), minimum records (12), burst detection (2.5x baseline)",
      status: "production",
      must_never: [
        "Create windows with insufficient records",
        "Lose window state",
        "Skip burst detection",
        "Bypass time windows",
      ],
      perf_budget_ms: 20,
      security_level: "low",
    },
    {
      id: "scoutAdapter",
      kind: "analysis.component",
      responsibility: "Fast cloud LLM adapter (Cerebras). Analyzes redacted windows, returns summary, confidence, severity, tags, suggested tools",
      status: "production",
      must_never: [
        "Send raw logs to cloud",
        "Exceed timeout (700ms)",
        "Lose analysis results",
        "Bypass redaction",
      ],
      perf_budget_ms: 700,
      security_level: "high",
    },
    {
      id: "forensicsAdapter",
      kind: "analysis.component",
      responsibility: "Deep local LLM adapter (Ollama). Analyzes raw windows with context, returns root cause, fix suggestion, evidence",
      status: "production",
      must_never: [
        "Send raw logs to cloud",
        "Exceed timeout (8s)",
        "Lose analysis results",
        "Bypass local-only constraint",
      ],
      perf_budget_ms: 8000,
      security_level: "high",
    },
    {
      id: "routerPolicy",
      kind: "decision.component",
      responsibility: "Escalation decision logic. Severity scoring, confidence thresholds, novelty detection, keep/escalate decisions",
      status: "production",
      must_never: [
        "Skip escalation checks",
        "Lose decision reasoning",
        "Bypass severity thresholds",
        "Allow unsafe escalations",
      ],
      perf_budget_ms: 5,
      security_level: "medium",
    },
  ],
  ports: [
    {
      portId: "routerIntegration",
      direction: "bidirectional",
      connectsToSystem: "router.apoeMcpRouter",
      protocol: "internal_api",
      whatIsExchanged: [
        "tool_suggestions",
        "log_insights",
        "anomaly_reports",
        "forensics_reports",
      ],
      security_level: "medium",
    },
    {
      portId: "segIntegration",
      direction: "bidirectional",
      connectsToSystem: "seg.sharedEvidenceGraph",
      protocol: "internal_api",
      whatIsExchanged: [
        "scout_evidence",
        "forensics_evidence",
        "escalation_chains",
        "analysis_evidence",
      ],
      security_level: "high",
    },
    {
      portId: "vifIntegration",
      direction: "bidirectional",
      connectsToSystem: "vif.verifiableIntelligence",
      protocol: "internal_api",
      whatIsExchanged: [
        "quality_gates",
        "confidence_scores",
        "validation_requests",
        "analysis_quality",
      ],
      security_level: "critical",
    },
    {
      portId: "cmcIntegration",
      direction: "bidirectional",
      connectsToSystem: "cmc.contextMemoryCore",
      protocol: "internal_api",
      whatIsExchanged: [
        "decision_atoms",
        "analysis_results",
        "escalation_decisions",
        "processing_state",
      ],
      security_level: "high",
    },
    {
      portId: "tcsIntegration",
      direction: "bidirectional",
      connectsToSystem: "tcs.timelineContextSystem",
      protocol: "internal_api",
      whatIsExchanged: [
        "incident_markers",
        "analysis_events",
        "escalation_events",
        "timeline_entries",
      ],
      security_level: "medium",
    },
    {
      portId: "idePanelsIntegration",
      direction: "bidirectional",
      connectsToSystem: "ide.external",
      protocol: "rest_websocket",
      whatIsExchanged: [
        "scout_reports",
        "forensics_reports",
        "telemetry_data",
        "real_time_updates",
      ],
      security_level: "medium",
    },
    {
      portId: "cerebrasLLM",
      direction: "outbound",
      connectsToSystem: "llm.external",
      protocol: "api",
      whatIsExchanged: [
        "scout_prompts",
        "scout_reports",
        "token_usage",
        "model_outputs",
      ],
      security_level: "high",
    },
    {
      portId: "ollamaLLM",
      direction: "outbound",
      connectsToSystem: "llm.local",
      protocol: "api",
      whatIsExchanged: [
        "forensics_prompts",
        "forensics_reports",
        "local_analysis",
        "model_outputs",
      ],
      security_level: "high",
    },
    {
      portId: "logSources",
      direction: "inbound",
      connectsToSystem: "external.logs",
      protocol: "websocket_file_otel",
      whatIsExchanged: [
        "log_records",
        "console_logs",
        "terminal_logs",
        "api_logs",
      ],
      security_level: "high",
    },
  ],
  internalEdges: [
    {
      from: "logCollector",
      to: "logNormalizer",
      type: "provides_raw_logs",
      data_flow: "raw_logs → normalized_logs",
    },
    {
      from: "logNormalizer",
      to: "logTemplateMiner",
      type: "provides_normalized_logs",
      data_flow: "normalized_logs → templates",
    },
    {
      from: "logTemplateMiner",
      to: "windower",
      type: "provides_templates",
      data_flow: "templates → window_templates",
    },
    {
      from: "windower",
      to: "logSentinelsPipeline",
      type: "provides_windows",
      data_flow: "windows → pipeline_processing",
    },
    {
      from: "logSentinelsPipeline",
      to: "scoutAdapter",
      type: "requests_scout_analysis",
      data_flow: "redacted_windows → scout_reports",
    },
    {
      from: "scoutAdapter",
      to: "routerPolicy",
      type: "provides_scout_report",
      data_flow: "scout_reports → escalation_decisions",
    },
    {
      from: "logTemplateMiner",
      to: "routerPolicy",
      type: "provides_novelty_score",
      data_flow: "novelty_scores → escalation_decisions",
    },
    {
      from: "routerPolicy",
      to: "forensicsAdapter",
      type: "triggers_forensics",
      data_flow: "escalation_decisions → forensics_reports",
    },
    {
      from: "logSentinelsPipeline",
      to: "segIntegration",
      type: "records_evidence",
      data_flow: "reports → evidence_nodes",
    },
    {
      from: "scoutAdapter",
      to: "routerIntegration",
      type: "provides_tool_suggestions",
      data_flow: "suggested_tools → router_plans",
    },
  ],
  externalEdges: [
    {
      fromPort: "routerIntegration",
      toSystem: "router.apoeMcpRouter",
      type: "provides_tool_suggestions",
      data_flow: "suggested_tools → tool_selection",
    },
    {
      fromPort: "segIntegration",
      toSystem: "seg.sharedEvidenceGraph",
      type: "records_evidence",
      data_flow: "analysis_data → evidence_chains",
    },
    {
      fromPort: "vifIntegration",
      toSystem: "vif.verifiableIntelligence",
      type: "validates_quality",
      data_flow: "reports → quality_gates",
    },
    {
      fromPort: "cmcIntegration",
      toSystem: "cmc.contextMemoryCore",
      type: "stores_decisions",
      data_flow: "analysis_data → persistent_storage",
    },
    {
      fromPort: "tcsIntegration",
      toSystem: "tcs.timelineContextSystem",
      type: "records_events",
      data_flow: "incidents → timeline_entries",
    },
    {
      fromPort: "cerebrasLLM",
      toSystem: "llm.external",
      type: "generates_scout_reports",
      data_flow: "redacted_prompts → scout_reports",
    },
    {
      fromPort: "ollamaLLM",
      toSystem: "llm.local",
      type: "generates_forensics_reports",
      data_flow: "raw_prompts → forensics_reports",
    },
    {
      fromPort: "logSources",
      toSystem: "external.logs",
      type: "collects_logs",
      data_flow: "log_sources → log_records",
    },
  ],
  riskOverlay: {
    perf_hotspots: [
      "scoutAdapter",
      "forensicsAdapter",
      "logTemplateMiner",
      "logSentinelsPipeline",
    ],
    security_sensitive_ports: [
      "logNormalizer",
      "cerebrasLLM",
      "ollamaLLM",
      "logSources",
    ],
    governance_touchpoints: [
      "routerPolicy",
      "logNormalizer",
      "logSentinelsPipeline",
    ],
    critical_failure_modes: [
      "PII leakage to cloud (normalizer failure)",
      "Raw logs sent to cloud (scout bypass)",
      "Escalation bypass allowing missed issues",
      "Template cache corruption causing false positives",
      "Forensics timeout causing analysis loss",
    ],
    blast_radius: {
      logNormalizer: "privacy_breach",
      scoutAdapter: "analysis_accuracy",
      forensicsAdapter: "root_cause_quality",
      routerPolicy: "escalation_effectiveness",
      logSentinelsPipeline: "all_analysis",
    },
  },
  governance: {
    privacy_protection: true,
    escalation_enforcement: true,
    evidence_recording: true,
    quality_gates: true,
    quartet_parity: true,
  },
  monitoring: {
    key_metrics: [
      "scout_latency_ms",
      "forensics_latency_ms",
      "escalation_rate",
      "tool_suggestion_accuracy",
      "privacy_violations",
      "cache_hit_rate",
    ],
    alerts: [
      "pii_leakage_detected",
      "raw_logs_to_cloud",
      "escalation_bypass",
      "template_cache_corruption",
      "forensics_timeout",
      "scout_timeout",
    ],
  },
  documentation: {
    T0: "knowledge_architecture/systems/log-sentinels/T0_executive.md",
    T1: "knowledge_architecture/systems/log-sentinels/T1_overview.md",
    T2: "knowledge_architecture/systems/log-sentinels/T2_architecture.md",
    T3: "knowledge_architecture/systems/log-sentinels/T3_detailed.md",
    T4: "knowledge_architecture/systems/log-sentinels/T4_complete.md",
    system_map: "knowledge_architecture/systems/log-sentinels/system.map.lucid.json5",
    usage_envelope: "knowledge_architecture/systems/log-sentinels/usage.envelope.md",
  },
  quartetParity: {
    code: [
      "packages/log_sentinels/core/pipeline.py",
      "packages/log_sentinels/core/normalizer.py",
      "packages/log_sentinels/core/scout.py",
      "packages/log_sentinels/core/forensics.py",
      "packages/log_sentinels/core/template_miner.py",
      "packages/log_sentinels/core/windower.py",
      "packages/log_sentinels/core/router_policy.py",
      "packages/log_sentinels/core/collectors.py",
    ],
    docs: [
      "T0_executive.md",
      "T1_overview.md",
      "T2_architecture.md",
      "T3_detailed.md",
      "T4_complete.md",
      "usage.envelope.md",
    ],
    tests: [
      "packages/log_sentinels/tests/test_log_sentinels.py",
    ],
    traces: [
      "VIF witnesses (analysis quality)",
      "SEG evidence (analysis chains)",
      "TCS timeline entries (incident markers)",
      "CMC decision atoms (escalation decisions)",
    ],
    parityThreshold: 0.9,
    crossTagging: {
      enabled: true,
      changeIdFormat: "log-sentinels-change-YYYYMMDD-HHMMSS",
      semanticAlignment: true,
    },
  },
  integrations: {
    aimos_systems: [
      "router (tool suggestions)",
      "seg (evidence chains)",
      "vif (quality gates)",
      "cmc (decision storage)",
      "tcs (timeline tracking)",
    ],
    external_systems: [
      "ide-panels (UI integration)",
      "cerebras-llm (scout analysis)",
      "ollama-llm (forensics analysis)",
      "log-sources (browser console, terminal, backend API)",
    ],
  },
  metadata: {
    created: "2025-01-27T00:00:00Z",
    updated: "2025-01-27T00:00:00Z",
    author: "aether",
    tags: ["log-sentinels", "log-analysis", "hybrid", "privacy", "proactive-detection"],
    maintainer: "aether",
    license: "MIT",
  },
}

