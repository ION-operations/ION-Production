      status: "production",
      must_never: [
        "Lose architecture state",
        "Break AI Studio integration",
        "Expose sensitive architecture data",
      ],
      perf_budget_ms: 100,
      security_level: "high",
    },
    {
      id: "backendCanvas",
      kind: "core.component",
      responsibility: "Visual canvas for backend architecture design",
      status: "production",
      must_never: [
