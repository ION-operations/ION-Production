+def _candidate_json_paths(values: Iterable[str] | None) -> tuple[Path, ...]:
+    if not values:
+        return ()
+    return tuple(Path(v) for v in values)
+
+
+def load_branch_record(root: str | Path, branch_record_path: str | Path) -> dict[str, Any]:
+    shell_root = _shell_root(root)
+    path = Path(branch_record_path)
+    if not path.is_absolute():
+        path = shell_root / path
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def load_active_branch_claims(root: str | Path) -> tuple[dict[str, Any], ...]:
+    shell_root = _shell_root(root)
+    registry = _read_json(shell_root / BRANCH_REGISTRY_PATH, {})
+    claims: list[dict[str, Any]] = []
+    for branch in registry.get("active_branches") or ():
+        if isinstance(branch, dict):
+            claims.append(
+                {
+                    "claim_id": branch.get("branch_id"),
+                    "branch_id": branch.get("branch_id"),
+                    "write_scope": branch.get("write_scope") or (),
+                }
+            )
+    return tuple(claims)
+
+
+def _scope_forbidden_findings(scope: Iterable[str], *, prefix: str) -> list[str]:
+    findings: list[str] = []
+    for path in tuple(_rel_path(p) for p in scope):
+        if _is_shared_context_surface(path):
+            findings.append(f"{prefix}_shared_context_surface_forbidden:{path}")
+        if re.search(r"(^|/|_)C-\d{3}($|_|/)", path):
+            findings.append(f"{prefix}_checkpoint_assignment_surface_forbidden:{path}")
+    return findings
+
+
+def material_work_preflight(
+    root: str | Path,
+    *,
+    branch_record_path: str | Path | None = None,
+    record: BranchCapsuleRecord | dict[str, Any] | None = None,
+    requested_write_scope: Iterable[str] | None = None,
+    active_claims: Iterable[dict[str, Any]] | None = None,
+) -> dict[str, Any]:
+    """Read-only guard for material work.
+
+    The guard does not create branches, mutate shared context, or assign
+    checkpoints. It answers whether a material task is allowed to proceed under
+    a declared branch capsule.
+    """
+
+    findings: list[str] = []
+    branch_data: dict[str, Any] | None = None
+
+    if record is not None:
+        branch_data = asdict(record) if isinstance(record, BranchCapsuleRecord) else dict(record)
+    elif branch_record_path:
+        try:
+            branch_data = load_branch_record(root, branch_record_path)
+        except FileNotFoundError:
+            findings.append(f"branch_record_missing:{_rel_path(branch_record_path)}")
+        except json.JSONDecodeError:
+            findings.append(f"branch_record_invalid_json:{_rel_path(branch_record_path)}")
+    else:
+        findings.append("branch_capsule_required_for_material_work")
+
+    requested_scope = tuple(_rel_path(p) for p in (requested_write_scope or ()))
+    findings.extend(_scope_forbidden_findings(requested_scope, prefix="requested_write_scope"))
+
+    validation: dict[str, Any] | None = None
+    if branch_data is not None:
+        claims = tuple(active_claims) if active_claims is not None else load_active_branch_claims(root)
+        validation = validate_branch_record(root, branch_data, active_claims=claims)
+        findings.extend(validation["findings"])
+
+        declared_scope = set(_rel_path(p) for p in (branch_data.get("write_scope") or ()))
+        if requested_scope and not declared_scope:
+            findings.append("branch_write_scope_empty_for_requested_material_work")
+        for rel in requested_scope:
+            if rel not in declared_scope:
+                findings.append(f"requested_write_scope_not_declared_in_branch:{rel}")
+
+    ok = not findings
+    return {
+        "schema_id": "ion.agent_branch_capsule.material_work_preflight.v1",
+        "ok": ok,
+        "verdict": READY_VERDICT if ok else BLOCKED_VERDICT,
+        "required_action": "proceed_with_branch_scope" if ok else "create_or_repair_branch_capsule_before_material_work",
+        "branch_record_path": _rel_path(branch_record_path) if branch_record_path else None,
+        "branch_identity": {
+            "context_instance_id": branch_data.get("context_instance_id"),
+            "branch_id": branch_data.get("branch_id"),
+            "conversation_tag": branch_data.get("conversation_tag"),
+            "agent_tag": branch_data.get("agent_tag"),
+            "task_tag": branch_data.get("task_tag"),
+            "parent_context_id": branch_data.get("parent_context_id"),
+        } if branch_data else None,
+        "requested_write_scope": list(requested_scope),
+        "findings": findings,
+        "validation": validation,
+        "production_authority": False,
+        "live_execution_authority": False,
+        "mutates_shared_context": False,
+    }
+
