      description: "HTTP endpoint to Command Server (localhost:5001) for MCP tool execution",
      rateLimit: "unlimited",
      authentication: "api-key",
      authorization: "role-based",
      dataFormat: "JSON",
      versioning: "v1",
    },
    {
      id: "aimosIntegration",
      portName: "AIM-OS Systems Integration",
      type: "bidirectional",
      protocol: "MCP",
