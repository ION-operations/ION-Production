  riskOverlay: {
    performance: {
      level: "high",
      concerns: [
        "Primary raymarch cost scales with rtWidth/rtHeight and step count (FAST vs full).",
        "God rays are a heavy post pass; sample count directly impacts frame time.",
        "TAA adds an extra fullscreen pass and can increase perceived input lag if alpha is too low.",
        "BufferB regeneration on resize can cause frame drops (5-20ms spike).",
        "Render target reallocation on config change causes stutter (100-500ms).",
        "High render scales (1.0) at high DPR can exceed GPU memory on mobile devices.",
      ],
      hotspots: ["image_pass", "godrays_pass", "render_targets"],
      bottlenecks: ["Image raymarch (64 steps)", "Godrays samples (48 default, up to 128)", "Render target allocation"],
      optimization: [
        "Render scale slider (scale < 1)",
        "FAST while dragging toggle",
        "Disable god rays while dragging (default)",
        "Higher drag-alpha option to reduce ghosting while moving",
        "Adaptive quality switching based on frame time",
      ],
      scalability: "Horizontal (multiple instances) not applicable; vertical (quality tiers) via render scale",
      monitoring: ["Frame time (target: 16.67ms)", "GPU memory usage", "Render target allocation time"],
    },
    compatibility: {
      level: "medium",
      concerns: [
        "Requires WebGL2 and EXT_color_buffer_float (some devices/browsers missing).",
        "Uniform array lookups require using `iChannelResolution[0]` base location.",
        "Float-linear filtering may be unavailable, requiring RGBA8 fallback for BufferB.",
        "Pointer lock API may be restricted in some browsers (flight mode).",
        "Clipboard API requires secure context (HTTPS or localhost).",
      ],
      mitigations: [
        "Clear overlay error messages",
        "Graceful feature toggles (TAA/godrays)",
        "RGBA8 fallback for BufferB when float-linear unavailable",
        "Feature detection before enabling flight mode",
        "Graceful clipboard API failure handling",
      ],
    },
    stability: {
      level: "medium",
      concerns: [
        "Camera reprojection must match the shader's effective camera motion or TAA artifacts appear (striping/ghosting).",
        "Mouse coordinates must be in the same pixel space as iResolution (and correct Y origin) or controls feel inverted.",
        "History reset timing must align with quality switches or 'chunky' lag/bands appear.",
        "BufferB regeneration must happen before Image pass or artifacts appear.",
        "Light UV projection must handle off-screen cases or god rays fail silently.",
        "Reprojection disocclusion detection must be correct or history bleeds into new areas.",
      ],
      mitigations: [
        "Document exact iMouse contract + coordinate mapping in the S.A.M docs",
        "Keep reference mode (pure Shadertoy pipeline) available for comparison",
        "Reset history on quality switch toggle",
        "Validate BufferB readiness before Image pass",
        "Skip god rays pass if light is off-screen",
        "Validate reprojection UV bounds before sampling history",
      ],
    },
    security: {
      level: "low",
      concerns: [
        "Shader code loaded from local files (no remote execution risk in this harness).",
        "URL parameters parsed without validation could cause XSS if embedded in other pages (not applicable here).",
        "Clipboard API requires user interaction (no auto-copy risk).",
      ],
      mitigations: [
        "Shader files are local (served via HTTP server, not remote).",
        "URL parameters are validated and clamped to safe ranges.",
        "Clipboard API only invoked on explicit user button click.",
      ],
    },
    governance: {
      level: "low",
      touchpoints: ["All shader files (al-ro MIT license)", "Harness code (project license)"],
      compliance: ["MIT license (al-ro shaders)", "Project license (harness code)"],
      audit_trail: "Git history",
      approval_required: ["Shader modifications", "License changes"],
      review_cycle: "As needed",
