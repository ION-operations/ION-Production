              "type": "emits_witnesses",
              "data_flow": "execution_data → provenance_traces"
            },
            {
              "fromPort": "cmcIntegration",
              "toSystem": "cmc.contextMemoryCore",
              "type": "stores_execution_state",
              "data_flow": "execution_data → persistent_storage"
            },
            {
              "fromPort": "segIntegration",
              "toSystem": "seg.sharedEvidenceGraph",
              "type": "provides_execution_traces",
