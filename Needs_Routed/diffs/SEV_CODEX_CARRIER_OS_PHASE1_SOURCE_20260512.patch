+    manifests: list[dict[str, Any]] = []
+    for item in sorted(path.glob("*.json")):
+        payload = _read_json(item)
+        if isinstance(payload, dict):
+            payload.setdefault("path", item.relative_to(shell_root).as_posix())
+            manifests.append(payload)
+    return manifests
