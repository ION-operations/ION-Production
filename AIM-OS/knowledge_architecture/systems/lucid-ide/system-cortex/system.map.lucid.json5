{
  systemId: "lucid-ide.systemCortex",
  systemName: "Lucid IDE System Cortex",
  version: "v1.0.0",
  status: "production",
  layer: 3,
  description: "System analysis and monitoring tool providing architecture visualization, code browsing, version history, and enhanced reactor integration",
  purpose: "Provides comprehensive system analysis interface with architecture hierarchy tree, code browser, version history tracking, and integration with enhanced reactor for visualization",
  dependencies: ["lucid-ide.frontendSystem", "lucid-ide.reactorSystems"],
  internalNodes: [
    {
      id: "systemCortex",
      kind: "core.component",
      responsibility: "Main System Cortex component (900+ lines) orchestrating all analysis features",
      status: "production",
      must_never: [
        "Lose system state",
        "Break code browsing",
        "Expose sensitive code",
      ],
      perf_budget_ms: 100,
      security_level: "high",
    },
    {
      id: "codeBrowser",
      kind: "supporting.component",
      responsibility: "Code browser for navigating and viewing codebase",
      status: "production",
      must_never: [
        "Lose navigation state",
        "Break file loading",
        "Expose unauthorized files",
      ],
      perf_budget_ms: 200,
      security_level: "high",
    },
    {
      id: "systemHierarchyTree",
      kind: "supporting.component",
      responsibility: "System hierarchy tree visualization",
      status: "production",
      must_never: [
        "Lose hierarchy state",
        "Break tree expansion",
        "Corrupt hierarchy data",
      ],
      perf_budget_ms: 50,
      security_level: "medium",
    },
    {
      id: "versionHistory",
      kind: "supporting.component",
      responsibility: "Version history tracking and visualization",
      status: "production",
      must_never: [
        "Lose version data",
        "Break history navigation",
        "Corrupt version information",
      ],
      perf_budget_ms: 100,
      security_level: "medium",
    },
    {
      id: "cortexService",
      kind: "service.component",
      responsibility: "Cortex service managing system analysis and data",
      status: "production",
      must_never: [
        "Lose service state",
        "Break data retrieval",
        "Expose system internals",
      ],
      perf_budget_ms: 200,
      security_level: "high",
    },
    {
      id: "waveEngine",
      kind: "service.component",
      responsibility: "Wave engine for context flow visualization",
      status: "production",
      must_never: [
        "Lose wave state",
        "Break flow visualization",
        "Cause performance degradation",
      ],
      perf_budget_ms: 16,
      security_level: "low",
    },
  ],
  ports: [
    {
      id: "cortexService",
      portName: "Cortex Service Integration",
      type: "bidirectional",
      protocol: "internal",
      security: "high",
      description: "Calls CortexService for system analysis",
      rateLimit: "unlimited",
      authentication: "n/a",
      authorization: "n/a",
      dataFormat: "JSON",
      versioning: "n/a",
    },
    {
      id: "enhancedReactor",
      portName: "Enhanced Reactor Integration",
      type: "bidirectional",
      protocol: "react-props",
      security: "low",
      description: "Integrates with enhanced reactor for visualization",
      rateLimit: "unlimited",
      authentication: "n/a",
      authorization: "n/a",
      dataFormat: "JSON",
      versioning: "n/a",
    },
  ],
  internalEdges: [
    {
      from: "systemCortex",
      to: "codeBrowser",
      type: "composition",
      description: "System Cortex composes code browser",
      protocol: "react-props",
      performance: "0ms",
      security: "high",
      dataFlow: "bidirectional",
      frequency: "continuous",
    },
    {
      from: "systemCortex",
      to: "systemHierarchyTree",
      type: "composition",
      description: "System Cortex composes hierarchy tree",
      protocol: "react-props",
      performance: "0ms",
      security: "medium",
      dataFlow: "bidirectional",
      frequency: "continuous",
    },
    {
      from: "systemCortex",
      to: "versionHistory",
      type: "composition",
      description: "System Cortex composes version history",
      protocol: "react-props",
      performance: "0ms",
      security: "medium",
      dataFlow: "bidirectional",
      frequency: "on-demand",
    },
    {
      from: "systemCortex",
      to: "cortexService",
      type: "data_flow",
      description: "System Cortex calls CortexService",
      protocol: "internal",
      performance: "200ms",
      security: "high",
      dataFlow: "bidirectional",
      frequency: "on-demand",
    },
    {
      from: "systemCortex",
      to: "enhancedReactor",
      type: "composition",
      description: "System Cortex integrates with enhanced reactor",
      protocol: "react-props",
      performance: "0ms",
      security: "low",
      dataFlow: "bidirectional",
      frequency: "continuous",
    },
  ],
  externalEdges: [
    {
      from: "lucid-ide.systemCortex.enhancedReactor",
      to: "lucid-ide.reactorSystems.reactor3D",
      type: "data_flow",
      protocol: "react-props",
      description: "System Cortex uses enhanced reactor for visualization",
      rateLimit: "unlimited",
      security: "low",
      authentication: "n/a",
      dataFormat: "JSON",
    },
  ],
  riskOverlay: {
    performance: {
      hotspots: ["systemCortex", "codeBrowser"],
      bottlenecks: ["cortexService"],
      optimization: "Code splitting, lazy loading, caching",
      scalability: "client-side rendering",
      monitoring: ["render_time", "service_latency", "memory_usage"],
    },
    security: {
      sensitive: ["codeBrowser", "cortexService"],
      critical: [],
      encryption: "TLS",
      vulnerabilities: ["xss", "path_traversal"],
      mitigations: ["input_validation", "path_sanitization", "authorization"],
    },
    governance: {
      touchpoints: ["systemCortex", "codeBrowser"],
      compliance: [],
      audit_trail: "required",
      approval_required: ["security_changes"],
      review_cycle: "monthly",
    },
  },
  metadata: {
    created: "2025-11-09T00:00:00Z",
