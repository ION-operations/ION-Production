+  if (url === '/model.json' || url.endsWith('/model.json')) {{
+    return new Response(window.__ION_MODEL_JSON__, {{status: 200, headers: {{'Content-Type': 'application/json'}}}});
+  }}
+  return originalFetch(input, init);
+}};
+</script>
+</head>
+<body>
+<div id="root"></div>
+<script type="module">
+{js}
+</script>
+</body>
+</html>
+"""
+    return fixture_html, build_results
