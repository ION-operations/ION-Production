    },
    {
      nodeId: "camera_model",
      name: "Camera Model (Orbit) + Light Projection",
      type: "view_controller",
      file: "main.js",
      responsibilities: [
        "Maintain orbit angles (approx mirror of BufferA mouse-tracking logic)",
        "Provide current/previous targetDir for reprojection",
        "Project light direction to screen UV for god rays",
        "Handle flight mode (free-flight with pointer lock)",
        "Update camera position and orientation per frame",
        "Compute view matrices for reprojection",
      ],
      interfaces: {
        inputs: [
          "Mouse events (x/y + button down)",
          "fovDeg",
          "lightAzimuthDeg/lightHeight",
          "Keyboard state (flight mode)",
          "Pointer lock state",
        ],
        outputs: ["curTargetDir/prevTargetDir", "lightUv", "cameraPosThisFrame", "cameraUpThisFrame"],
      },
      performance: { criticalPath: false, cpuOnly: true, latency: "<1ms", throughput: "60 updates/sec" },
      security: { level: "low", encryption: "none", authentication: "none", authorization: "none" },
      governance: { owner: "aether", reviewer: "aether", approver: "aether", compliance: [] },
    },
    {
      nodeId: "frame_loop",
      name: "Frame Loop Orchestrator",
      type: "orchestrator",
      file: "main.js",
      responsibilities: [
        "Run BufferA every frame (1x4 state texture)",
        "Run BufferB on-demand (init/resize) (perlin-worley atlas + moon/cloud map persistence)",
        "Run Image pass each frame (optionally FAST while dragging)",
        "Optionally run TAA accumulation pass",
        "Optionally run God Rays post pass",
        "Present final output to the canvas",
        "Manage frame timing and delta time calculation",
        "Handle quality switching (fast mode during drag)",
      ],
      interfaces: {
        inputs: ["Runtime config (scale/TAA/godrays/lighting)", "Mouse + keyboard state", "Time delta"],
        outputs: ["Rendered canvas frame", "Updated feedback buffers", "Frame counter"],
      },
      performance: {
        criticalPath: true,
        target: "Interactive (60 FPS)",
        hotPaths: ["Image raymarch", "Godrays samples"],
        latency: "16.67ms target (60 FPS)",
        throughput: "60 frames/sec",
      },
      security: { level: "low", encryption: "none", authentication: "none", authorization: "none" },
      governance: { owner: "aether", reviewer: "aether", approver: "aether", compliance: [] },
    },
    {
      nodeId: "bufferA_pass",
      name: "BufferA Pass (Mouse Tracking + State)",
      type: "render_pass",
      file: "shaders/bufferA.glsl",
      responsibilities: [
        "Track mouse movement and resolution change between frames",
        "Set view direction from mouse angles",
        "Store mouse state in 1x4 texture (4 pixels: mouse angles, targetDir, resolution, mouse down flag)",
        "Maintain camera angle continuity across frames",
      ],
      interfaces: {
        inputs: ["iMouse", "iResolution", "iFrame", "Previous BufferA (feedback)"],
        outputs: ["Updated BufferA texture (1x4)", "targetDir for downstream passes"],
      },
      performance: {
        criticalPath: true,
        latency: "<0.1ms (1x4 resolution)",
        throughput: "60 passes/sec",
        gpuOnly: true,
      },
      security: { level: "low", encryption: "none", authentication: "none", authorization: "none" },
      governance: { owner: "aether", reviewer: "aether", approver: "aether", compliance: [] },
    },
    {
      nodeId: "bufferB_pass",
      name: "BufferB Pass (Perlin-Worley Atlas + Maps)",
      type: "render_pass",
      file: "shaders/bufferB.glsl",
      responsibilities: [
        "Generate Perlin-Worley texture atlas (6x6 grid of 32x32 tiles with halo padding)",
        "Create cloud map and moon texture",
        "Persist atlas via feedback to avoid recompute",
        "Run only on init/resize (not every frame)",
      ],
      interfaces: {
        inputs: ["iResolution", "iTime", "Previous BufferB (feedback)", "BufferA (for state)"],
        outputs: ["Updated BufferB texture (full resolution)", "Perlin-Worley atlas in RG channels"],
      },
      performance: {
        criticalPath: false,
        latency: "5-20ms (full resolution, one-time)",
        throughput: "On init/resize only",
        gpuOnly: true,
      },
      security: { level: "low", encryption: "none", authentication: "none", authorization: "none" },
      governance: { owner: "aether", reviewer: "aether", approver: "aether", compliance: [] },
    },
    {
      nodeId: "image_pass",
      name: "Image Pass (Cloud Rendering)",
      type: "render_pass",
      file: "shaders/image.glsl",
      responsibilities: [
        "Volumetric cloud raymarching (64 steps normal, 32 steps FAST)",
        "Density field evaluation using Perlin-Worley noise",
        "Energy-conserving single-scatter integration",
        "Henyey-Greenstein phase function",
        "Sky rendering (stars, moon/sun disk, atmospheric scattering)",
        "Output cloud color (RGB) and transmittance (A)",
      ],
      interfaces: {
        inputs: [
          "BufferA (targetDir, mouse state)",
          "BufferB (Perlin-Worley atlas, cloud map, moon texture)",
          "Blue noise (dithering)",
          "Lighting uniforms (day/night mode, colors, exposure)",
          "Camera uniforms (position, targetDir, FOV)",
        ],
        outputs: ["Cloud color RGB + transmittance A", "Scene ready for post-processing"],
      },
      performance: {
        criticalPath: true,
        latency: "5-15ms (depends on steps and resolution)",
        throughput: "60 passes/sec",
        gpuOnly: true,
        hotPath: true,
      },
      security: { level: "low", encryption: "none", authentication: "none", authorization: "none" },
      governance: { owner: "aether", reviewer: "aether", approver: "aether", compliance: [] },
    },
    {
      nodeId: "accum_pass",
      name: "Temporal Accumulation (TAA-lite)",
      type: "render_pass",
      file: "shaders/accum.glsl",
      responsibilities: [
        "Blend currentColor into history with EMA (exponential moving average)",
        "Optional reprojection based on targetDir change",
        "Handle disocclusion (newly revealed pixels)",
        "Motion-aware blend (higher alpha when reprojection moves a lot)",
        "Reset history on config changes or explicit reset",
      ],
      interfaces: {
        inputs: [
          "uCurrent (current frame)",
          "uHistory (previous accumulated frame)",
          "uTargetDirCur/Prev (for reprojection)",
          "uFovDeg (for reprojection math)",
          "uAlpha (blend factor)",
          "uReset (reset flag)",
        ],
        outputs: ["Updated history texture (double-buffered)", "Smoothed output for presentation"],
      },
      performance: {
        criticalPath: true,
        latency: "1-3ms (full resolution)",
        throughput: "60 passes/sec (when enabled)",
        gpuOnly: true,
      },
      security: { level: "low", encryption: "none", authentication: "none", authorization: "none" },
      governance: { owner: "aether", reviewer: "aether", approver: "aether", compliance: [] },
    },
    {
      nodeId: "godrays_pass",
      name: "God Rays (Post)",
      type: "render_pass",
      file: "shaders/godrays.glsl",
      responsibilities: [
        "Radial blur of transmittance from light UV",
        "Sample along ray from fragment to light source",
        "Apply decay and density parameters",
        "Add god rays to scene color",
        "Skip if light is off-screen",
      ],
      interfaces: {
        inputs: [
          "uScene (scene with transmittance in alpha)",
          "uLightUv (screen-space light position)",
          "uLightColor",
          "uIntensity, uDensity, uDecay, uWeight",
          "uSamples (4-128)",
          "uSourceRadius (sun/moon disk size)",
        ],
        outputs: ["Final color with god rays added", "sRGB output"],
      },
      performance: {
        criticalPath: true,
        latency: "2-10ms (depends on sample count, expensive at high samples)",
        throughput: "60 passes/sec (when enabled)",
        gpuOnly: true,
        hotPath: true,
      },
      security: { level: "low", encryption: "none", authentication: "none", authorization: "none" },
      governance: { owner: "aether", reviewer: "aether", approver: "aether", compliance: [] },
    },
    {
      nodeId: "blit_pass",
      name: "Blit (Present)",
      type: "render_pass",
      file: "main.js (inline)",
      responsibilities: [
        "Simple fullscreen texture copy to canvas",
        "Present final frame to user",
        "Handle sRGB conversion if needed",
      ],
      interfaces: {
        inputs: ["uTex (source texture)", "uResolution"],
        outputs: ["Canvas display"],
      },
      performance: {
        criticalPath: true,
        latency: "<0.5ms",
        throughput: "60 passes/sec",
        gpuOnly: true,
      },
      security: { level: "low", encryption: "none", authentication: "none", authorization: "none" },
