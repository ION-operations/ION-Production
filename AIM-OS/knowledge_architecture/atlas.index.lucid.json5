    "layer4": {
      "layerId": "layer4",
      "layerName": "Layer 4: Consciousness Engine",
      "purpose": "Meta-cognitive awareness and self-monitoring",
      "dependencies": [
        "layer1",
        "layer2",
        "layer3"
      ],
      "systems": {
        "cognitiveAnalysis": {
          "systemId": "cas.cognitiveAnalysis",
          "systemName": "Cognitive Analysis System - Meta-Cognition Monitoring and Improvement",
          "version": "v0.1",
          "description": "Meta-layer system that observes and analyzes cognitive processes across all AIM-OS systems. Monitors activation state (hot vs cold), category recognition accuracy, attention load, and failure modes. Creates transparent, debuggable cognition by analyzing HOW the AI thinks during operation.",
          "status": "production",
          "layer": 4,
          "internalNodes": [
            {
              "id": "activationTracker",
              "kind": "tracking.component",
              "responsibility": "Tracks what's 'hot' (actively used) vs 'cold' (available but inactive) in AI attention",
              "status": "production",
              "must_never": [
                "Lose activation state",
                "Allow activation failures to go undetected",
                "Skip activation warnings",
                "Create inconsistent activation data"
              ],
              "perf_budget_ms": 10,
              "security_level": "medium"
            },
            {
              "id": "categoryRecognizer",
              "kind": "analysis.component",
              "responsibility": "Detects how tasks get classified and validates against actual requirements",
              "status": "production",
              "must_never": [
                "Miss category errors",
                "Allow wrong categorization",
                "Skip category validation",
                "Lose category reasoning"
              ],
              "perf_budget_ms": 15,
              "security_level": "medium"
            },
            {
              "id": "attentionMonitor",
              "kind": "monitoring.component",
              "responsibility": "Monitors cognitive load and attention narrowing",
              "status": "production",
              "must_never": [
                "Miss attention narrowing",
                "Allow overload to go undetected",
                "Skip attention warnings",
                "Lose attention metrics"
              ],
              "perf_budget_ms": 8,
              "security_level": "low"
            },
            {
              "id": "failureModeDetector",
              "kind": "analysis.component",
              "responsibility": "Detects cognitive failure modes and patterns",
              "status": "production",
              "must_never": [
                "Miss failure patterns",
                "Skip failure analysis",
                "Lose failure context",
                "Allow failures to repeat"
              ],
              "perf_budget_ms": 20,
              "security_level": "high"
            },
            {
              "id": "learningExtractor",
              "kind": "extraction.component",
              "responsibility": "Extracts learnings from decisions and outcomes",
              "status": "production",
              "must_never": [
                "Lose learning opportunities",
                "Skip learning extraction",
                "Create false learnings",
                "Lose learning provenance"
              ],
              "perf_budget_ms": 25,
              "security_level": "medium"
            },
            {
              "id": "introspectionEngine",
              "kind": "introspection.component",
              "responsibility": "Performs hourly cognitive introspection and validation",
              "status": "production",
              "must_never": [
                "Skip introspection cycles",
                "Lose introspection data",
                "Allow drift to go undetected",
                "Create inconsistent introspection"
              ],
              "perf_budget_ms": 30,
              "security_level": "high"
            },
            {
              "id": "decisionLogger",
              "kind": "logging.component",
