  map_type: "system_topology",
  internal_topology: {
    core_components: [
      {
        component_id: "governance_engine",
        name: "Governance Engine",
        type: "governance_engine",
        tier: 2,
        description: "Core governance engine that enforces policies and manages governance workflows",
        ports: {
          input: [
            "governance_requests",
            "policy_rules",
          ],
          output: [
            "governance_decisions",
            "policy_enforcement",
          ],
        },
        dependencies: [
          "policy_engine",
          "decision_engine",
        ],
        blast_radius: "platform",
        must_never: [
          "Enforce policies without validation",
          "Skip governance workflows",
          "Ignore policy rules",
          "Bypass governance validation",
        ],
      },
      {
        component_id: "policy_engine",
        name: "Policy Engine",
        type: "policy_engine",
        tier: 2,
        description: "Manages and enforces governance policies across the system",
        ports: {
          input: [
            "policy_requests",
            "policy_definitions",
          ],
          output: [
            "policy_enforcement",
            "policy_status",
          ],
        },
        dependencies: [
          "policy_definitions",
          "enforcement_rules",
        ],
        blast_radius: "platform",
        must_never: [
          "Enforce policies without validation",
          "Skip policy definitions",
          "Ignore enforcement rules",
          "Bypass policy validation",
        ],
      },
      {
        component_id: "decision_engine",
        name: "Decision Engine",
        type: "decision_engine",
        tier: 2,
        description: "Makes governance decisions based on policies and context",
        ports: {
          input: [
            "decision_requests",
            "decision_rules",
          ],
          output: [
            "governance_decisions",
            "decision_rationale",
          ],
        },
        dependencies: [
          "decision_rules",
          "context_analyzer",
        ],
        blast_radius: "platform",
        must_never: [
          "Make decisions without validation",
          "Skip decision rules",
          "Ignore context analysis",
          "Bypass decision validation",
        ],
      },
      {
        component_id: "approval_workflow",
        name: "Approval Workflow",
        type: "workflow_engine",
        tier: 2,
        description: "Manages approval workflows for governance decisions",
        ports: {
          input: [
            "approval_requests",
            "workflow_rules",
          ],
          output: [
            "approval_status",
            "workflow_events",
          ],
        },
        dependencies: [
          "workflow_rules",
          "approval_rules",
        ],
        blast_radius: "platform",
        must_never: [
          "Process approvals without validation",
          "Skip workflow rules",
          "Ignore approval requirements",
          "Bypass workflow validation",
        ],
      },
      {
        component_id: "compliance_monitor",
        name: "Compliance Monitor",
        type: "monitoring_engine",
        tier: 2,
        description: "Monitors compliance with governance policies and regulations",
        ports: {
          input: [
            "compliance_requests",
            "compliance_rules",
          ],
          output: [
            "compliance_status",
            "compliance_reports",
          ],
