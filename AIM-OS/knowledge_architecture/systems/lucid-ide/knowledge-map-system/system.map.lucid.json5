{
  systemId: "lucid-ide.knowledgeMapSystem",
  systemName: "Lucid IDE Knowledge Map System",
  version: "v1.0.0",
  status: "production",
  layer: 3,
  description: "Vector database and semantic relationship system providing knowledge map visualization, component analysis, and AI-powered context retrieval",
  purpose: "Provides vector database operations, semantic relationship mapping, knowledge map visualization, and AI-powered context analysis for system understanding",
  dependencies: ["lucid-ide.backendApiSystem", "lucid-ide.aiStudioSystem"],
  internalNodes: [
    {
      id: "knowledgeMapApi",
      kind: "core.component",
      responsibility: "Knowledge map API route providing GET/POST endpoints for knowledge map operations",
      status: "production",
      must_never: [
        "Expose sensitive data",
        "Break query filtering",
        "Allow unauthorized access",
      ],
      perf_budget_ms: 200,
      security_level: "high",
    },
    {
      id: "knowledgeMapIntegration",
      kind: "service.component",
      responsibility: "AIKnowledgeMapIntegration singleton managing knowledge map data and operations",
      status: "production",
      must_never: [
        "Lose integration state",
        "Break data retrieval",
        "Expose embeddings",
      ],
      perf_budget_ms: 200,
      security_level: "high",
    },
    {
      id: "knowledgeMapPanel",
      kind: "interface.component",
      responsibility: "Knowledge map panel UI (3700+ lines ⚠️ CRITICAL) with 3D visualization",
      status: "production",
      must_never: [
        "Lose visualization state",
        "Break 3D rendering",
        "Exceed memory limits",
      ],
      perf_budget_ms: 16,
      security_level: "medium",
    },
    {
      id: "vectorDatabase",
      kind: "data.component",
      responsibility: "Vector database operations for embeddings and semantic search",
      status: "production",
      must_never: [
        "Lose vector data",
        "Break similarity search",
        "Expose embeddings",
      ],
      perf_budget_ms: 200,
      security_level: "high",
    },
  ],
  ports: [
    {
      id: "backendApi",
      portName: "Backend API Integration",
      type: "bidirectional",
      protocol: "REST",
      security: "high",
      description: "Knowledge map API route",
      rateLimit: "unlimited",
      authentication: "session-based",
      authorization: "user-based",
      dataFormat: "JSON",
      versioning: "v1",
    },
    {
      id: "aiProviders",
      portName: "AI Provider Integration",
      type: "outbound",
      protocol: "HTTP",
      security: "critical",
      description: "Calls AI providers for embeddings",
      rateLimit: "provider-specific",
      authentication: "api-key",
      authorization: "n/a",
      dataFormat: "JSON",
      versioning: "provider-specific",
    },
    {
      id: "vectorStore",
      portName: "Vector Store",
      type: "bidirectional",
      protocol: "vector-db",
      security: "high",
      description: "Vector database for embeddings storage",
      rateLimit: "unlimited",
      authentication: "connection-string",
      authorization: "database-level",
      dataFormat: "vectors",
      versioning: "n/a",
    },
  ],
  internalEdges: [
    {
      from: "knowledgeMapApi",
      to: "knowledgeMapIntegration",
      type: "data_flow",
      description: "API calls integration singleton",
      protocol: "internal",
      performance: "0ms",
      security: "high",
      dataFlow: "bidirectional",
      frequency: "on-demand",
    },
    {
      from: "knowledgeMapIntegration",
      to: "vectorDatabase",
      type: "data_flow",
      description: "Integration uses vector database",
      protocol: "internal",
      performance: "200ms",
      security: "high",
      dataFlow: "bidirectional",
      frequency: "on-demand",
    },
    {
      from: "knowledgeMapPanel",
      to: "backendApi",
      type: "data_flow",
      description: "Panel calls knowledge map API",
      protocol: "REST",
      performance: "200ms",
      security: "high",
      dataFlow: "bidirectional",
      frequency: "on-demand",
    },
    {
      from: "knowledgeMapIntegration",
      to: "aiProviders",
      type: "data_flow",
      description: "Integration calls AI providers for embeddings",
      protocol: "HTTP",
      performance: "1000ms",
      security: "critical",
      dataFlow: "unidirectional",
      frequency: "on-demand",
    },
  ],
  externalEdges: [
    {
      from: "lucid-ide.knowledgeMapSystem.backendApi",
      to: "lucid-ide.backendApiSystem.restApi",
      type: "data_flow",
      protocol: "REST",
      description: "Knowledge map API is part of backend API system",
      rateLimit: "unlimited",
      security: "high",
      authentication: "session-based",
      dataFormat: "JSON",
    },
    {
      from: "lucid-ide.knowledgeMapSystem.aiProviders",
      to: "external.openai",
      type: "data_flow",
      protocol: "HTTP",
      description: "Calls OpenAI for embeddings",
      rateLimit: "provider-specific",
      security: "critical",
      authentication: "api-key",
      dataFormat: "JSON",
    },
  ],
  riskOverlay: {
    performance: {
      hotspots: ["knowledgeMapPanel", "vectorDatabase"],
      bottlenecks: ["aiProviders", "vectorStore"],
      optimization: "Caching, batch operations, vector indexing",
      scalability: "horizontal (vector database scaling)",
      monitoring: ["api_latency", "vector_search_time", "embedding_generation_time"],
    },
    security: {
      sensitive: ["vectorDatabase", "aiProviders"],
      critical: ["backendApi"],
      encryption: "TLS",
      vulnerabilities: ["api_key_exposure", "embedding_leakage"],
      mitigations: ["secure_storage", "input_validation", "rate_limiting"],
    },
    governance: {
      touchpoints: ["knowledgeMapApi", "knowledgeMapIntegration"],
      compliance: [],
      audit_trail: "required",
      approval_required: ["security_changes", "vector_schema_changes"],
      review_cycle: "monthly",
    },
  },
  metadata: {
    created: "2025-11-09T00:00:00Z",
    updated: "2025-11-09T00:00:00Z",
    author: "sev",
    tags: ["knowledge-map", "vector-db", "semantic-search"],
    maintainer: "sev",
    license: "MIT",
    documentation: {
      L0: "L0_executive.md",
      L1: "L1_overview.md",
      L2: "L2_architecture.md",
      L3: "L3_detailed.md",
      L4: "L4_complete.md",
    },
  },
}

