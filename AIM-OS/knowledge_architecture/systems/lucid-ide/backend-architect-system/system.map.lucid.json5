  purpose: "Provides visual interface for designing, generating, and managing backend architectures with AI-powered suggestions, 21 AI Studio sections integration, and real-time context preview",
  dependencies: ["lucid-ide.backendApiSystem", "lucid-ide.aiStudioSystem", "lucid-ide.frontendSystem"],
  internalNodes: [
