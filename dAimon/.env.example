# ION Continuity Bridge local/sample configuration
ION_MODE=sample
ION_MONGODB_ENABLED=false

# Durable MongoDB writes are fail-closed unless both ION_MONGODB_ENABLED=true
# and MONGODB_URI are provided in the deployment environment.
MONGODB_URI=
MONGODB_DB=ion_continuity_bridge
MONGODB_COLLECTION_PREFIX=
MONGODB_VECTOR_INDEX=ion_continuity_vector_index

# Gemini/Agent Builder deployment placeholders.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
ION_CLOUD_RUN_URL=
DAIMON_CLOUD_RUN_SERVICE_ACCOUNT=
# Comma-separated tester principals for the read-only user access gate.
# Values may be plain emails or full IAM principals such as user:name@example.com.
DAIMON_TEST_USER_EMAILS=

# Arize Phoenix observability placeholders.
# Phoenix Cloud uses PHOENIX_API_KEY and PHOENIX_COLLECTOR_ENDPOINT.
PHOENIX_API_KEY=
PHOENIX_COLLECTOR_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
PHOENIX_PROJECT_NAME=daimon
PHOENIX_CLIENT_HEADERS=

# Arize AX placeholders, only if using AX instead of Phoenix.
ARIZE_API_KEY=
ARIZE_SPACE_ID=
ARIZE_MODEL_ID=daimon

# GitLab connector placeholders for the planned read-only SDLC governance lane.
GITLAB_BASE_URL=https://gitlab.com
GITLAB_PROJECT_ID=
GITLAB_TOKEN=

# Optional future connector placeholders.
ELASTIC_ENDPOINT=
ELASTIC_API_KEY=
ELASTIC_INDEX_PREFIX=daimon
FIVETRAN_API_KEY=
FIVETRAN_API_SECRET=
FIVETRAN_CONNECTOR_ID=

# Optional Azure / Azure OpenAI carrier placeholders.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=
