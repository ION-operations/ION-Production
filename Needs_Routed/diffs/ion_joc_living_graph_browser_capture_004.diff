+def build_living_graph_browser_capture(
+    root: str | Path = ".",
+    *,
+    write: bool = False,
+    build: bool = True,
+    chromium_path: str = "/usr/bin/chromium",
+) -> dict[str, Any]:
+    root_path = Path(root).resolve()
+    output_dir = root_path / OUTPUT_DIR
+    output_dir.mkdir(parents=True, exist_ok=True)
+
+    try:
+        fixture_html, build_results = _build_inline_fixture(root_path, build=build)
+    except Exception as exc:
+        result = {
+            "schema_id": "ion.living_graph.browser_capture.v1",
+            "generated_at": utc_now(),
+            "status": "candidate_browser_capture_blocked",
+            "blocked_reason": "inline_fixture_build_failed",
+            "error": str(exc),
+            "authority": {
+                "production_authority": False,
+                "live_telemetry_authority": False,
+                "accepted_state": False,
+            },
+        }
+    else:
+        if write:
+            (root_path / INLINE_FIXTURE_OUTPUT).parent.mkdir(parents=True, exist_ok=True)
+            (root_path / INLINE_FIXTURE_OUTPUT).write_text(fixture_html, encoding="utf-8")
+        capture = asyncio.run(_run_playwright_capture(root_path, fixture_html, output_dir, chromium_path=chromium_path))
+        result = {
+            "schema_id": "ion.living_graph.browser_capture.v1",
+            "generated_at": utc_now(),
+            "build_results": build_results,
+            "capture": capture,
+            "status": capture.get("status", "candidate_browser_capture_unknown"),
+            "source_paths": {
+                "ui_root": str(UI_ROOT),
+                "inline_fixture": str(INLINE_FIXTURE_OUTPUT),
+                "result": str(RESULT_OUTPUT),
+            },
+            "authority": {
+                "production_authority": False,
+                "live_telemetry_authority": False,
+                "accepted_state": False,
+            },
+            "non_claims": [
+                "not_accepted_state",
+                "not_live_telemetry",
+                "not_production_deployment",
+                "not_live_action_mcp_mutation",
+            ],
+        }
+
+    if write:
+        result_path = root_path / RESULT_OUTPUT
+        result_path.parent.mkdir(parents=True, exist_ok=True)
+        result_path.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    return result
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="Capture local candidate browser proof for the ION Living Graph JOC route.")
+    parser.add_argument("--root", default=".")
+    parser.add_argument("--write", action="store_true")
+    parser.add_argument("--no-build", action="store_true", help="Use existing dist assets instead of running Vite build first.")
+    parser.add_argument("--chromium-path", default="/usr/bin/chromium")
+    parser.add_argument("--json", action="store_true")
+    args = parser.parse_args(argv)
+
+    result = build_living_graph_browser_capture(
+        args.root,
+        write=args.write,
+        build=not args.no_build,
+        chromium_path=args.chromium_path,
+    )
+    if args.json:
+        print(json.dumps(result, indent=2, sort_keys=True))
+    else:
+        print(result["status"])
+    return 0 if str(result.get("status", "")).endswith("_pass") else 1
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
