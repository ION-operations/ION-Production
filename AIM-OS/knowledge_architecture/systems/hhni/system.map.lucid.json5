  ports: [
    {
      portId: "cmcIntegration",
      direction: "bidirectional",
      connectsToSystem: "cmc.contextMemoryCore",
      protocol: "internal_api",
      whatIsExchanged: [
        "atoms_for_indexing",
        "hierarchical_paths",
        "retrieval_queries",
        "indexed_content",
      ],
      security_level: "high",
    },
    {
      portId: "apoeIntegration",
      direction: "bidirectional",
      connectsToSystem: "apoe.aiPoweredOrchestration",
      protocol: "internal_api",
      whatIsExchanged: [
        "context_retrieval_requests",
        "optimized_context",
        "multi_step_queries",
        "budget_aware_results",
      ],
      security_level: "high",
    },
    {
      portId: "vifIntegration",
      direction: "bidirectional",
      connectsToSystem: "vif.verifiableIntelligence",
      protocol: "internal_api",
      whatIsExchanged: [
        "retrieval_operations",
        "rs_lift_metrics",
        "witness_data",
        "replay_snapshots",
      ],
      security_level: "high",
    },
    {
      portId: "vectorStore",
      direction: "outbound",
      connectsToSystem: "vector.faiss",
      protocol: "faiss_api",
      whatIsExchanged: [
        "embedding_vectors",
        "similarity_queries",
        "index_updates",
        "search_results",
      ],
      security_level: "medium",
    },
    {
      portId: "embeddingService",
      direction: "outbound",
      connectsToSystem: "embedding.sentenceTransformers",
      protocol: "local_api",
      whatIsExchanged: [
        "text_content",
        "embedding_requests",
        "vector_embeddings",
        "model_updates",
      ],
      security_level: "low",
    },
    {
      portId: "segIntegration",
      direction: "bidirectional",
      connectsToSystem: "seg.sharedEvidenceGraph",
      protocol: "internal_api",
      whatIsExchanged: [
        "morphological_entities",
        "cross_document_relations",
        "semantic_block_relations",
        "evidence_indexing",
      ],
      security_level: "high",
    },
  ],
  internalEdges: [
    {
      from: "queryProcessor",
      to: "coarseRetrieval",
      type: "initiates_retrieval",
      data_flow: "query \u2192 semantic_search",
    },
    {
      from: "coarseRetrieval",
      to: "physicsRefinement",
      type: "provides_candidates",
      data_flow: "candidates \u2192 physics_optimization",
    },
    {
      from: "physicsRefinement",
      to: "deduplicationEngine",
      type: "provides_optimized_results",
      data_flow: "optimized_results \u2192 deduplication",
    },
    {
      from: "deduplicationEngine",
      to: "conflictResolver",
      type: "provides_deduplicated_content",
      data_flow: "deduplicated_content \u2192 conflict_resolution",
    },
    {
      from: "conflictResolver",
      to: "strategicCompressor",
      type: "provides_resolved_content",
      data_flow: "resolved_content \u2192 compression",
    },
    {
      from: "strategicCompressor",
      to: "budgetFitter",
      type: "provides_compressed_content",
      data_flow: "compressed_content \u2192 budget_fitting",
    },
    {
      from: "hierarchicalIndex",
      to: "coarseRetrieval",
      type: "provides_index_data",
      data_flow: "index_data \u2192 retrieval_queries",
    },
    {
      from: "dvnsPhysicsEngine",
      to: "physicsRefinement",
      type: "applies_physics_forces",
      data_flow: "physics_forces \u2192 spatial_optimization",
    },
    {
      from: "embeddingManager",
      to: "coarseRetrieval",
      type: "provides_embeddings",
      data_flow: "embeddings \u2192 similarity_search",
    },
    {
      from: "embeddingManager",
      to: "hierarchicalIndex",
      type: "provides_vector_data",
      data_flow: "vector_data \u2192 hierarchical_indexing",
    },
    {
      from: "morphologicalAnalysis",
      to: "hierarchicalIndex",
      type: "provides_morphological_data",
      data_flow: "morphological_decomposition \u2192 subword_level_indexing",
    },
    {
      from: "semanticBlockOrganizer",
      to: "hierarchicalIndex",
      type: "organizes_content_blocks",
      data_flow: "semantic_blocks \u2192 pre_organized_indexing",
    },
    {
      from: "crossDocumentRelationshipDetector",
      to: "hierarchicalIndex",
      type: "adds_cross_doc_relations",
      data_flow: "cross_doc_relationships \u2192 hierarchical_indexing",
    },
    {
      from: "morphologicalAnalysis",
      to: "hierarchicalIndex",
      type: "enhances_subword_indexing",
      data_flow: "morphological_data \u2192 subword_level",
    },
  ],
  externalEdges: [
    {
      fromPort: "cmcIntegration",
      toSystem: "cmc.contextMemoryCore",
      type: "indexes_atoms",
