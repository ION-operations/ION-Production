{
  systemId: "lucid_document_editor.lucidDocumentEditor",
  systemName: "LUCID Document Editor - Revolutionary Document Intelligence System",
  version: "v1.0.0",
  status: "design",
  layer: 6,
  description: "Revolutionary document intelligence system combining LaTeX math rendering, rich text editing, AI-powered management, advanced tagging/organization, section-based editing, and visual diff tracking. Built on AIM-OS infrastructure for complete document intelligence.",
  internalNodes: [
    {
      id: "editorCore",
      kind: "core.component",
      responsibility: "Core editing functionality with multiple modes (WYSIWYG, code, split, AI)",
      status: "design",
      must_never: [
        "Lose content synchronization between modes",
        "Allow invalid content states",
        "Break editor invariants",
      ],
      perf_budget_ms: 50,
      security_level: "medium",
    },
    {
      id: "mathRenderer",
      kind: "math.component",
      responsibility: "LaTeX math rendering with hybrid KaTeX/MathJax",
      status: "design",
      must_never: [
        "Render math incorrectly",
        "Lose math rendering consistency",
        "Break LaTeX syntax",
      ],
      perf_budget_ms: 100,
      security_level: "low",
    },
    {
      id: "aiIntelligence",
      kind: "ai.component",
      responsibility: "AI-powered document analysis, tagging, suggestions, citations",
      status: "design",
      must_never: [
        "Make changes without user approval",
        "Lose semantic analysis accuracy",
        "Break AI invariants",
      ],
      perf_budget_ms: 500,
      security_level: "medium",
    },
    {
      id: "organizationSystem",
      kind: "organization.component",
      responsibility: "Multi-dimensional tagging, hierarchical organization, semantic search",
      status: "design",
      must_never: [
        "Lose tag relationships",
        "Break tag hierarchy",
        "Allow invalid tag queries",
      ],
      perf_budget_ms: 200,
      security_level: "low",
    },
    {
      id: "sectionManager",
      kind: "section.component",
      responsibility: "Section-based document architecture, locking, versioning",
      status: "design",
      must_never: [
        "Allow concurrent edits to locked sections",
        "Lose section version history",
        "Break section dependencies",
      ],
      perf_budget_ms: 150,
      security_level: "high",
    },
    {
      id: "changeTracker",
      kind: "change.component",
      responsibility: "Visual diff, change tracking, history, rollback",
      status: "design",
      must_never: [
        "Lose change history",
        "Break diff visualization",
        "Allow invalid rollbacks",
      ],
      perf_budget_ms: 200,
      security_level: "medium",
    },
    {
      id: "collaborationEngine",
      kind: "collaboration.component",
      responsibility: "Real-time multi-user collaboration via Yjs CRDT",
      status: "design",
      must_never: [
        "Lose sync consistency",
        "Break conflict resolution",
        "Expose user data incorrectly",
      ],
      perf_budget_ms: 50,
      security_level: "high",
    },
    {
      id: "storageManager",
      kind: "storage.component",
      responsibility: "Document storage, persistence, AIM-OS integration",
      status: "design",
      must_never: [
        "Lose documents",
        "Break bitemporal tracking",
        "Lose AIM-OS integration",
      ],
      perf_budget_ms: 500,
      security_level: "critical",
    },
    {
      id: "cmcIntegration",
      kind: "integration.component",
      responsibility: "CMC integration for document storage with bitemporal tracking",
      status: "design",
      must_never: [
        "Lose bitemporal tracking",
        "Store documents without witnesses",
        "Break CMC invariants",
      ],
      perf_budget_ms: 200,
      security_level: "high",
    },
    {
      id: "hhniIntegration",
      kind: "integration.component",
      responsibility: "HHNI integration for semantic indexing and search",
      status: "design",
      must_never: [
        "Index without proper metadata",
        "Lose semantic relationships",
        "Break HHNI invariants",
      ],
      perf_budget_ms: 150,
      security_level: "medium",
    },
    {
      id: "vifIntegration",
      kind: "integration.component",
      responsibility: "VIF integration for witnesses and confidence tracking",
      status: "design",
      must_never: [
        "Create operations without witnesses",
        "Skip confidence tracking",
        "Break VIF invariants",
      ],
      perf_budget_ms: 100,
      security_level: "high",
    },
    {
      id: "segIntegration",
      kind: "integration.component",
      responsibility: "SEG integration for document relationships and knowledge graph",
      status: "design",
      must_never: [
        "Lose document relationships",
        "Break SEG invariants",
        "Create circular dependencies",
      ],
      perf_budget_ms: 200,
      security_level: "medium",
    },
    {
      id: "apoeIntegration",
      kind: "integration.component",
      responsibility: "APOE integration for document management workflows",
      status: "design",
      must_never: [
        "Execute workflows without validation",
        "Break APOE invariants",
        "Exceed budgets",
      ],
      perf_budget_ms: 300,
      security_level: "medium",
    },
  ],
  externalPorts: [
    {
      id: "cmc.documentStorage",
      direction: "outbound",
      protocol: "CMC API",
      responsibility: "Store documents, sections, changes with bitemporal tracking",
      status: "design",
    },
    {
      id: "hhni.semanticIndexing",
      direction: "outbound",
      protocol: "HHNI API",
      responsibility: "Index documents, sections, content semantically",
      status: "design",
    },
    {
      id: "vif.witnessCreation",
      direction: "outbound",
      protocol: "VIF API",
      responsibility: "Create witnesses for document operations",
      status: "design",
    },
    {
      id: "seg.knowledgeGraph",
      direction: "outbound",
      protocol: "SEG API",
      responsibility: "Map document relationships, synthesize knowledge",
      status: "design",
    },
    {
      id: "apoe.workflows",
      direction: "outbound",
      protocol: "APOE API",
      responsibility: "Execute document management workflows",
      status: "design",
    },
    {
      id: "yjs.collaboration",
      direction: "outbound",
      protocol: "Yjs CRDT",
      responsibility: "Real-time document synchronization",
      status: "design",
    },
  ],
  crossSystemArms: [
    {
      target: "cmc.contextMemoryCore",
      relationship: "uses",
      description: "Stores documents, sections, changes with bitemporal tracking",
    },
    {
      target: "hhni.hierarchicalIndex",
      relationship: "uses",
      description: "Indexes documents semantically for intelligent search and organization",
    },
    {
      target: "vif.verifiableIntelligence",
      relationship: "uses",
      description: "Creates witnesses for all document operations, tracks confidence",
    },
    {
      target: "seg.sharedEvidenceGraph",
      relationship: "uses",
      description: "Maps document relationships, synthesizes knowledge from content",
    },
    {
      target: "apoe.aiOrchestration",
      relationship: "uses",
      description: "Executes document management workflows, AI-assisted editing",
    },
  ],
}

