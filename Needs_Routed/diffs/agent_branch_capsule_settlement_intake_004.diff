+    preflight = material_work_preflight(
+        tmp_path,
+        branch_record_path=record_path,
+        requested_write_scope=["ION/04_packages/kernel/allowed.py"],
+    )
+    assert preflight["ok"] is True
+
+    packet = build_task_return_settlement_packet(
+        created["record"],
+        preflight_result=preflight,
+        touched_paths=["ION/04_packages/kernel/allowed.py"],
+        diff_refs=[created["record"]["branch_path"] + "/TASK_RETURNS/latest.diff"],
+        validation_refs=[created["record"]["branch_path"] + "/TASK_RETURNS/validation.json"],
+    )
+    result = settlement_intake_preflight(
+        tmp_path,
+        packet=packet,
+        branch_record_path=record_path,
+    )
+
+    assert result["ok"] is True
+    assert result["verdict"] == READY_VERDICT
+    assert result["material_settlement"] is True
+    assert result["required_action"] == "context_settler_review_admissible_packet"
