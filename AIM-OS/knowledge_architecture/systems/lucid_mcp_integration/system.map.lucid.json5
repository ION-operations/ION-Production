{
  system_id: "lucid_mcp_integration",
  system_name: "LUCID-MCP Integration",
  version: "1.0.0",
  last_updated: "2025-01-27T20:50:00Z",
  map_type: "system_topology",
  internal_topology: {
    core_components: [
      {
        component_id: "mcp_router",
        name: "MCP Router",
        type: "routing_engine",
        tier: 2,
        description: "Routes MCP tool calls to appropriate servers and tools",
        ports: {
          input: [
            "mcp_requests",
            "routing_rules",
          ],
          output: [
            "routed_calls",
            "routing_status",
          ],
        },
        dependencies: [
          "routing_rules",
          "server_manager",
        ],
        blast_radius: "platform",
        must_never: [
          "Route without validation",
          "Skip routing rules",
          "Ignore server requirements",
          "Bypass routing validation",
        ],
      },
      {
        component_id: "tool_selector",
        name: "Tool Selector",
        type: "selection_engine",
        tier: 2,
        description: "Selects optimal MCP tools based on context and requirements",
        ports: {
          input: [
            "selection_requests",
            "selection_rules",
          ],
          output: [
            "selected_tools",
            "selection_reasoning",
          ],
        },
        dependencies: [
          "selection_rules",
          "context_analyzer",
        ],
        blast_radius: "platform",
        must_never: [
          "Select without validation",
          "Skip selection rules",
          "Ignore context requirements",
          "Bypass selection validation",
        ],
      },
      {
        component_id: "server_manager",
        name: "Server Manager",
        type: "management_engine",
        tier: 2,
        description: "Manages MCP servers and their lifecycle",
        ports: {
          input: [
            "server_requests",
            "management_rules",
          ],
          output: [
            "server_status",
            "management_events",
          ],
        },
        dependencies: [
          "management_rules",
          "lifecycle_manager",
        ],
        blast_radius: "platform",
        must_never: [
          "Manage without validation",
          "Skip management rules",
          "Ignore lifecycle requirements",
          "Bypass management validation",
        ],
      },
      {
        component_id: "context_analyzer",
        name: "Context Analyzer",
        type: "analysis_engine",
        tier: 2,
        description: "Analyzes context to determine optimal MCP tool usage",
        ports: {
          input: [
            "context_data",
            "analysis_rules",
          ],
          output: [
            "context_insights",
            "tool_recommendations",
          ],
        },
        dependencies: [
          "analysis_rules",
          "context_processor",
        ],
        blast_radius: "platform",
        must_never: [
          "Analyze without validation",
          "Skip analysis rules",
          "Ignore context requirements",
          "Bypass analysis validation",
        ],
      },
      {
        component_id: "integration_monitor",
        name: "Integration Monitor",
        type: "monitoring_engine",
        tier: 2,
        description: "Monitors MCP integration performance and effectiveness",
        ports: {
          input: [
            "monitoring_requests",
            "monitoring_rules",
          ],
          output: [
            "monitoring_reports",
            "integration_metrics",
          ],
        },
        dependencies: [
          "monitoring_rules",
          "metrics_collector",
        ],
        blast_radius: "platform",
        must_never: [
          "Monitor without validation",
          "Skip monitoring rules",
          "Ignore integration requirements",
          "Bypass monitoring validation",
        ],
      },
    ],
    supporting_components: [
      {
        component_id: "routing_rules",
        name: "Routing Rules",
        type: "rules_engine",
        tier: 1,
