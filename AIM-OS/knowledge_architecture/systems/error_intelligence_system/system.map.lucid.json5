{
  system_id: "error_intelligence_system",
  system_name: "Error Intelligence System",
  version: "1.0.0",
  last_updated: "2025-01-27T20:50:00Z",
  map_type: "system_topology",
  internal_topology: {
    core_components: [
      {
        component_id: "error_capture_engine",
        name: "Error Capture Engine",
        type: "capture_engine",
        tier: 2,
        description: "Captures and processes errors from various system components",
        ports: {
          input: [
            "error_data",
            "capture_rules",
          ],
          output: [
            "captured_errors",
            "capture_status",
          ],
        },
        dependencies: [
          "error_parser",
          "error_validator",
        ],
        blast_radius: "platform",
        must_never: [
          "Capture errors without validation",
          "Skip capture rules",
          "Ignore error data",
          "Bypass capture validation",
        ],
      },
      {
        component_id: "error_analyzer",
        name: "Error Analyzer",
        type: "analysis_engine",
        tier: 2,
        description: "Analyzes errors to identify patterns, root causes, and impact",
        ports: {
          input: [
            "error_data",
            "analysis_rules",
          ],
          output: [
            "error_analysis",
            "pattern_reports",
          ],
        },
        dependencies: [
          "analysis_rules",
          "pattern_detector",
        ],
        blast_radius: "platform",
        must_never: [
          "Analyze errors without validation",
          "Skip analysis rules",
          "Ignore error patterns",
          "Bypass analysis validation",
        ],
      },
      {
        component_id: "error_classifier",
        name: "Error Classifier",
        type: "classification_engine",
        tier: 2,
        description: "Classifies errors by type, severity, and impact",
        ports: {
          input: [
            "error_data",
            "classification_rules",
          ],
          output: [
            "error_classification",
            "severity_assessment",
          ],
        },
        dependencies: [
          "classification_rules",
          "severity_analyzer",
        ],
        blast_radius: "platform",
        must_never: [
          "Classify errors without validation",
          "Skip classification rules",
          "Ignore error severity",
          "Bypass classification validation",
        ],
      },
      {
        component_id: "error_clusterer",
        name: "Error Clusterer",
        type: "clustering_engine",
        tier: 2,
        description: "Clusters similar errors together for analysis and resolution",
        ports: {
          input: [
            "error_data",
            "clustering_rules",
          ],
          output: [
            "error_clusters",
            "cluster_analysis",
          ],
        },
        dependencies: [
          "clustering_rules",
          "similarity_analyzer",
        ],
        blast_radius: "platform",
        must_never: [
          "Cluster errors without validation",
          "Skip clustering rules",
          "Ignore error similarity",
          "Bypass clustering validation",
        ],
      },
      {
        component_id: "error_intelligence_engine",
        name: "Error Intelligence Engine",
        type: "intelligence_engine",
        tier: 2,
        description: "Provides intelligent insights and recommendations for error resolution",
        ports: {
          input: [
            "error_analysis",
            "intelligence_rules",
          ],
          output: [
            "error_insights",
            "resolution_recommendations",
          ],
        },
        dependencies: [
          "intelligence_rules",
          "recommendation_engine",
        ],
        blast_radius: "platform",
        must_never: [
          "Provide intelligence without validation",
          "Skip intelligence rules",
          "Ignore error insights",
          "Bypass intelligence validation",
        ],
      },
    ],
    supporting_components: [
      {
        component_id: "error_parser",
        name: "Error Parser",
        type: "parsing_engine",
        tier: 1,
        description: "Parses error data from various sources",
        ports: {
          input: [
            "raw_error_data",
            "parsing_rules",
          ],
          output: [
            "parsed_errors",
            "parsing_errors",
          ],
        },
        dependencies: [
          "parsing_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Parse errors without validation",
          "Skip parsing rules",
          "Ignore parsing errors",
          "Bypass parsing validation",
        ],
      },
      {
        component_id: "error_validator",
        name: "Error Validator",
        type: "validation_engine",
        tier: 1,
        description: "Validates error data for completeness and accuracy",
        ports: {
          input: [
            "error_data",
            "validation_rules",
          ],
          output: [
            "validation_result",
            "validation_errors",
          ],
        },
        dependencies: [
          "validation_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Validate errors without rules",
          "Skip validation checks",
          "Ignore validation errors",
          "Bypass validation requirements",
        ],
      },
      {
        component_id: "pattern_detector",
        name: "Pattern Detector",
        type: "detection_engine",
        tier: 1,
        description: "Detects patterns in error data",
        ports: {
          input: [
            "error_data",
            "pattern_rules",
          ],
          output: [
            "detected_patterns",
            "pattern_confidence",
          ],
        },
        dependencies: [
          "pattern_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Detect patterns without validation",
          "Skip pattern rules",
          "Ignore pattern confidence",
          "Bypass pattern validation",
        ],
      },
      {
        component_id: "severity_analyzer",
        name: "Severity Analyzer",
        type: "analysis_engine",
        tier: 1,
        description: "Analyzes error severity and impact",
        ports: {
          input: [
            "error_data",
            "severity_rules",
          ],
          output: [
            "severity_analysis",
            "impact_assessment",
          ],
        },
        dependencies: [
          "severity_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Analyze severity without validation",
          "Skip severity rules",
          "Ignore impact assessment",
          "Bypass severity validation",
        ],
      },
      {
        component_id: "similarity_analyzer",
        name: "Similarity Analyzer",
        type: "analysis_engine",
        tier: 1,
        description: "Analyzes error similarity for clustering",
        ports: {
          input: [
            "error_data",
            "similarity_rules",
          ],
          output: [
            "similarity_analysis",
            "similarity_scores",
          ],
        },
        dependencies: [
          "similarity_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Analyze similarity without validation",
          "Skip similarity rules",
          "Ignore similarity scores",
          "Bypass similarity validation",
        ],
      },
    ],
  },
