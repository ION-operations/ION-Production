          lastValidated: "2025-01-27",
        },
        {
          system: "sdfcvf",
          tag: "[SDFCVF-PHYSICS]",
          purpose: "SDF-CVF validates physics simulation quartet parity",
          type: "required",
          bidirectional: true,
          reverseTag: "[HHNI-DVNS]",
          codeStatus: "not_implemented", // ❌ No code found
