{
  "systemId": "cas.cognitiveAnalysis",
  "humanName": "Cognitive Analysis System - Meta-Cognition Monitoring and Improvement",
  "version": "v2.2.0",
  "status": "production",
  
  "intent": {
    "purpose": "Provide meta-layer system that observes and analyzes cognitive processes across all AIM-OS systems. Monitors activation state (hot vs cold), category recognition accuracy, attention load, and failure modes. Creates transparent, debuggable cognition by analyzing HOW the AI thinks during operation.",
    "must_not_regress": [
      "Must not lose activation state",
      "Must not miss category errors",
      "Must not miss attention narrowing",
      "Must not skip introspection cycles",
      "Must not lose decision logs"
    ],
    "why_it_exists": "Enables meta-cognitive awareness and self-monitoring for AI consciousness. Provides transparency, debugging, and continuous improvement through cognitive analysis."
  },
  
  "classification": {
    "security_level": "high",
    "perf_sensitivity": "medium",
    "ownership": "core",
    "sideEffects": [
      "Monitors all AI cognitive operations",
      "Tracks activation and attention state",
      "Detects cognitive failure modes",
      "Performs hourly introspection",
      "Logs all decisions with reasoning"
    ]
  },
  
  "internalNodes": [
    {
      "id": "activationTracker",
      "responsibility": "Tracks what's 'hot' (actively used) vs 'cold' (available but inactive) in AI attention",
      "must_never": [
        "Lose activation state",
        "Allow activation failures to go undetected",
        "Skip activation warnings",
        "Create inconsistent activation data"
      ],
      "perf_budget_ms": 10,
      "status": "production"
    },
    {
      "id": "categoryRecognizer",
      "responsibility": "Detects how tasks get classified and validates against actual requirements",
      "must_never": [
        "Miss category errors",
        "Allow wrong categorization",
        "Skip category validation",
        "Lose category reasoning"
      ],
      "perf_budget_ms": 15,
      "status": "production"
    },
    {
      "id": "attentionMonitor",
      "responsibility": "Monitors cognitive load and attention narrowing",
      "must_never": [
        "Miss attention narrowing",
        "Allow overload to go undetected",
        "Skip attention warnings",
        "Lose attention metrics"
      ],
      "perf_budget_ms": 8,
      "status": "production"
    },
    {
      "id": "failureModeDetector",
      "responsibility": "Detects cognitive failure modes and patterns",
      "must_never": [
        "Miss failure patterns",
        "Skip failure analysis",
        "Lose failure context",
        "Allow failures to repeat"
      ],
      "perf_budget_ms": 20,
      "status": "production"
    },
    {
      "id": "learningExtractor",
      "responsibility": "Extracts learnings from decisions and outcomes",
      "must_never": [
        "Lose learning opportunities",
        "Skip learning extraction",
        "Create false learnings",
        "Lose learning provenance"
      ],
      "perf_budget_ms": 25,
      "status": "production"
    },
    {
      "id": "introspectionEngine",
      "responsibility": "Performs hourly cognitive introspection and validation",
      "must_never": [
        "Skip introspection cycles",
        "Lose introspection data",
        "Allow drift to go undetected",
        "Create inconsistent introspection"
      ],
      "perf_budget_ms": 30,
      "status": "production"
    },
    {
      "id": "decisionLogger",
      "responsibility": "Logs all decisions with full context and reasoning",
      "must_never": [
        "Lose decision logs",
        "Skip decision logging",
        "Create incomplete logs",
        "Allow log tampering"
      ],
      "perf_budget_ms": 5,
      "status": "production"
    }
  ],
  
  "systemMap": {
    "mapFile": "./system.map.lucid.json5"
  },
  
  "foresight": {
    "predictedRisks": [
      {
        "risk_id": "activation_state_loss",
        "description": "Activation state could be lost or corrupted",
        "likelihood": "low",
        "blast_radius_if_real": "cognitive_monitoring_unreliable",
        "mitigation": "Implement redundant activation tracking and validation",
        "watchpoint": "if activation_state_loss_detected, halt monitoring and alert"
      },
      {
        "risk_id": "category_recognition_failure",
        "description": "Category recognition could fail or misclassify",
        "likelihood": "medium",
        "blast_radius_if_real": "task_misclassification",
        "mitigation": "Implement category validation and fallback mechanisms",
        "watchpoint": "if category_error_detected, trigger manual review"
      },
      {
        "risk_id": "introspection_skip",
        "description": "Introspection cycles could be skipped",
        "likelihood": "low",
        "blast_radius_if_real": "cognitive_drift_undetected",
        "mitigation": "Implement mandatory introspection scheduling and validation",
        "watchpoint": "if introspection_skipped, trigger immediate introspection"
      }
    ],
    "killSwitch": "cas.monitoring.enabled=false",
    "emergencyProcedures": [
      "Disable all monitoring immediately",
      "Create emergency cognitive snapshot",
      "Switch to safe mode",
      "Notify all dependent systems"
    ]
  },
  
