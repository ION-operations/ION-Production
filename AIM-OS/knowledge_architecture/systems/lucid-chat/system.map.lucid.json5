      ],
      perf_budget_ms: 5,
      security_level: "medium",
    },
    {
      id: "rateLimiter",
      kind: "optimization.component",
      responsibility: "Rate limiting using token bucket algorithm",
      status: "production",
      must_never: [
        "Skip rate limiting",
        "Allow unlimited requests",
