{
  systemId: "agent_genome.agentGenomeSystem",
  systemName: "Agent Genome System - Persistent, Specialized, Cloneable Agents",
  version: "v1.0.0",
  status: "design",
  layer: 2,
  description: "Enables persistent, specialized, cloneable agents that grow dynamically within AIM-OS. Each agent is a versioned, bitemporal bundle (genome) containing identity, policies, competence, context, metrics, and experience.",
  internalNodes: [
    {
      id: "agentRegistry",
      kind: "core.component",
      responsibility: "Central registry for all agents, versions, and aliases",
      status: "design",
      must_never: [
        "Allow duplicate agent names",
        "Modify registry without validation",
        "Lose registry consistency",
      ],
      perf_budget_ms: 50,
      security_level: "high",
    },
    {
      id: "genomeManager",
      kind: "core.component",
      responsibility: "Genome lifecycle management (create, snapshot, clone, promote)",
      status: "design",
      must_never: [
        "Modify genomes after creation",
        "Create genomes without bitemporal tracking",
        "Promote without quality gates",
      ],
      perf_budget_ms: 200,
      security_level: "high",
    },
    {
      id: "evolutionEngine",
      kind: "evolution.component",
      responsibility: "Agent evolution through tournaments and learning",
      status: "design",
      must_never: [
        "Promote without tournament",
        "Skip quality gates",
        "Lose episode data",
      ],
      perf_budget_ms: 500,
      security_level: "medium",
    },
    {
      id: "memoryIsolationManager",
      kind: "memory.component",
      responsibility: "Isolated memory channels per agent/clone",
      status: "design",
      must_never: [
        "Allow cross-agent memory access",
        "Lose memory isolation",
        "Expose shared knowledge incorrectly",
      ],
      perf_budget_ms: 100,
      security_level: "critical",
    },
    {
      id: "qualityGateEnforcer",
      kind: "quality.component",
      responsibility: "Enforce quality gates for promotion and operations",
      status: "design",
      must_never: [
        "Skip quality gates",
        "Allow promotion without gates",
        "Lose gate validation history",
      ],
      perf_budget_ms: 150,
      security_level: "critical",
    },
    {
      id: "cmcIntegration",
      kind: "integration.component",
      responsibility: "CMC integration for genome storage, episodes, channels",
      status: "design",
      must_never: [
        "Lose bitemporal tracking",
        "Store genomes without witnesses",
        "Break CMC invariants",
      ],
      perf_budget_ms: 200,
      security_level: "high",
    },
    {
      id: "hhniIntegration",
      kind: "integration.component",
      responsibility: "HHNI integration for semantic indexing",
      status: "design",
      must_never: [
        "Index without proper metadata",
        "Lose semantic relationships",
        "Break HHNI invariants",
      ],
      perf_budget_ms: 150,
      security_level: "medium",
    },
    {
      id: "vifIntegration",
      kind: "integration.component",
      responsibility: "VIF integration for witnesses and confidence tracking",
      status: "design",
      must_never: [
        "Create operations without witnesses",
        "Skip confidence tracking",
        "Break VIF invariants",
      ],
      perf_budget_ms: 100,
      security_level: "high",
    },
    {
      id: "segIntegration",
      kind: "integration.component",
      responsibility: "SEG integration for knowledge synthesis and evidence links",
      status: "design",
      must_never: [
        "Lose evidence links",
        "Break SEG invariants",
        "Create circular dependencies",
      ],
      perf_budget_ms: 200,
      security_level: "medium",
    },
    {
      id: "apoeIntegration",
      kind: "integration.component",
      responsibility: "APOE integration for playbook execution",
      status: "design",
      must_never: [
        "Execute playbooks without validation",
        "Break APOE invariants",
        "Exceed budgets",
      ],
      perf_budget_ms: 300,
      security_level: "medium",
    },
    {
      id: "sdfcvfIntegration",
      kind: "integration.component",
      responsibility: "SDF-CVF integration for quartet parity validation",
      status: "design",
      must_never: [
        "Skip quartet parity validation",
        "Allow parity < 0.90",
        "Break SDF-CVF invariants",
      ],
      perf_budget_ms: 250,
      security_level: "critical",
    },
  ],
  externalPorts: [
    {
      id: "cmc.genomeStorage",
      direction: "outbound",
      protocol: "CMC API",
      responsibility: "Store genomes, episodes, memory channels in CMC",
      status: "design",
    },
    {
      id: "hhni.semanticIndexing",
      direction: "outbound",
      protocol: "HHNI API",
      responsibility: "Index genomes, skills, tools, playbooks semantically",
      status: "design",
    },
    {
      id: "vif.witnessCreation",
      direction: "outbound",
      protocol: "VIF API",
      responsibility: "Create witnesses for genome operations",
      status: "design",
    },
    {
      id: "seg.knowledgeSynthesis",
      direction: "outbound",
      protocol: "SEG API",
      responsibility: "Synthesize knowledge from episodes, link evidence",
      status: "design",
    },
    {
      id: "apoe.playbookExecution",
      direction: "outbound",
      protocol: "APOE API",
      responsibility: "Execute agent playbooks via APOE",
      status: "design",
    },
    {
      id: "sdfcvf.parityValidation",
      direction: "outbound",
      protocol: "SDF-CVF API",
      responsibility: "Validate quartet parity for genome changes",
      status: "design",
    },
  ],
  crossSystemArms: [
    {
      target: "cmc.contextMemoryCore",
      relationship: "uses",
      description: "Stores genomes, episodes, memory channels with bitemporal tracking",
    },
    {
      target: "hhni.hierarchicalIndex",
      relationship: "uses",
      description: "Indexes genomes, skills, tools, playbooks semantically",
    },
    {
      target: "vif.verifiableIntelligence",
      relationship: "uses",
      description: "Creates witnesses, tracks confidence, enforces gates",
    },
    {
      target: "seg.sharedEvidenceGraph",
      relationship: "uses",
      description: "Synthesizes knowledge, links evidence, detects contradictions",
    },
    {
      target: "apoe.aiOrchestration",
      relationship: "uses",
      description: "Executes playbooks, orchestrates tasks, manages budgets",
    },
    {
      target: "sdfcvf.atomicEvolution",
      relationship: "uses",
      description: "Validates quartet parity, tracks changes, enforces gates",
    },
  ],
}

