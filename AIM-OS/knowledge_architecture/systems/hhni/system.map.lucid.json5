          codeStatus: "implemented", // ✅ Indirect via CMC poller (tcs_timeline atoms), test_cmc_poller.py
          lastValidated: "2025-01-28",
        },
      ],
    },
    {
      id: "dvns",
      name: "DVNS Physics Subsystem",
      type: "subsystem",
      parent: "hhni.hierarchicalHypergraph",
      status: "production",
      description: "Dynamic Vector Network Simulation - Physics-guided context optimization using 4 forces (gravity, repulsion, elastic, damping) to solve 'lost in the middle' problem",
      meetsCriteria: ["complexity", "independence", "relationship", "evolution"],
      documentation: {
        L0: "components/dvns/README.md",
        L1: "components/dvns/L1_overview.md",
        L2: "components/dvns/L2_physics.md",
        README: "components/dvns/README.md",
      },
      relationships: {
