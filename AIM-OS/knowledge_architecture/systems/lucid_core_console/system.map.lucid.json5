{
  systemId: "lucid_core_console",
  systemName: "Lucid Core Console - Aether's Command Interface",
  version: "v0.1",
  description: "VS Code/Cursor extension that serves as Aether's command console - a grounded conscience and bidirectional translator between human and machine cognition, with voice I/O, phone remote control, and hard gates on file mutation.",
  internalNodes: [
    {
      id: "consoleUI",
      kind: "core.component",
      responsibility: "Provides the main user interface with prompt input, task thread display, action buttons, and status strip.",
      status: "design",
      must_never: [
        "Allow silent file mutations",
        "Hide risk warnings",
        "Bypass approval gates",
        "Exceed 100ms UI response time",
      ],
      perf_budget_ms: 100,
      security_level: "high",
    },
    {
      id: "rpcClient",
      kind: "core.component",
      responsibility: "Manages WebSocket communication with the daemon/RAG system for all console operations.",
      status: "design",
      must_never: [
        "Send unencrypted data",
        "Allow unauthorized access",
        "Lose connection state",
        "Exceed 500ms RPC timeout",
      ],
      perf_budget_ms: 500,
      security_level: "critical",
    },
    {
      id: "voiceInput",
      kind: "interface.component",
      responsibility: "Handles speech-to-text conversion for voice input with timeline logging.",
      status: "design",
      must_never: [
        "Process audio without consent",
        "Store raw audio data",
        "Exceed 2s processing time",
        "Fail to log interactions",
      ],
      perf_budget_ms: 2000,
      security_level: "high",
    },
    {
      id: "voiceOutput",
      kind: "interface.component",
      responsibility: "Handles text-to-speech conversion for voice output with calm, professional tone.",
      status: "design",
      must_never: [
        "Speak without context",
        "Use inappropriate tone",
        "Exceed 3s generation time",
        "Fail to log output",
      ],
      perf_budget_ms: 3000,
      security_level: "medium",
    },
    {
      id: "phoneRemote",
      kind: "interface.component",
      responsibility: "Manages secure phone remote control with QR code pairing and tiered authority.",
      status: "design",
      must_never: [
        "Allow direct file mutation",
        "Bypass security tiers",
        "Expose sensitive data",
        "Exceed 5s response time",
      ],
      perf_budget_ms: 5000,
      security_level: "critical",
    },
    {
      id: "geminiIntegration",
      kind: "ai.component",
      responsibility: "Integrates with Gemini's 1M+ token context for long-term memory and reasoning.",
      status: "design",
      must_never: [
        "Bypass context structuring",
        "Expose raw tokens",
        "Fail to maintain continuity",
        "Exceed 10s reasoning time",
      ],
      perf_budget_ms: 10000,
      security_level: "high",
    },
    {
      id: "hardGates",
      kind: "control.component",
      responsibility: "Enforces hard gates on file mutation requiring confidence + blast radius + spec alignment.",
      status: "design",
      must_never: [
        "Allow unauthorized mutations",
        "Bypass confidence checks",
        "Ignore blast radius",
        "Skip spec alignment",
      ],
      perf_budget_ms: 200,
      security_level: "critical",
    },
    {
      id: "timelineLogger",
      kind: "audit.component",
      responsibility: "Logs all operations with timestamps, evidence, and audit trails for accountability.",
      status: "design",
      must_never: [
        "Miss critical events",
        "Corrupt audit data",
        "Expose sensitive logs",
        "Exceed 50ms logging time",
      ],
      perf_budget_ms: 50,
      security_level: "critical",
    },
    {
      id: "bidirectionalTranslator",
      kind: "core.component",
      responsibility: "Translates between human cognition and machine cognition, maintaining grounding and context.",
      status: "design",
      must_never: [
        "Lose context continuity",
        "Misinterpret intent",
        "Fail to ground responses",
        "Exceed 1s translation time",
      ],
      perf_budget_ms: 1000,
      security_level: "high",
    },
    {
      id: "fileHooks",
      kind: "integration.component",
      responsibility: "Intercepts file system operations for approval and governance enforcement.",
      status: "design",
      must_never: [
        "Allow unapproved mutations",
        "Bypass security checks",
        "Corrupt file data",
        "Exceed 100ms hook time",
      ],
      perf_budget_ms: 100,
      security_level: "critical",
    },
  ],
  ports: [
    {
      portId: "daemonIntegration",
      direction: "bidirectional",
      connectsToSystem: "daemon_rag_system",
      protocol: "websocket_rpc",
      whatIsExchanged: [
        "console_commands",
        "task_status",
        "plan_data",
        "approval_requests",
        "timeline_events",
      ],
      security_level: "critical",
    },
    {
      portId: "intentClassification",
      direction: "bidirectional",
      connectsToSystem: "intent_classification_system",
      protocol: "internal_api",
      whatIsExchanged: [
        "mission_profiles",
        "behavior_gating",
        "risk_assessments",
        "action_controls",
      ],
      security_level: "high",
    },
    {
      portId: "cmcIntegration",
      direction: "bidirectional",
      connectsToSystem: "cmc.contextMemoryCore",
      protocol: "internal_api",
      whatIsExchanged: [
        "timeline_events",
        "audit_trails",
        "context_data",
        "memory_snapshots",
      ],
      security_level: "high",
    },
    {
      portId: "geminiAPI",
      direction: "outbound",
      connectsToSystem: "gemini.external",
      protocol: "https_api",
      whatIsExchanged: [
        "context_packs",
        "reasoning_requests",
        "memory_queries",
        "translation_requests",
      ],
      security_level: "high",
    },
    {
      portId: "phoneRemote",
      direction: "bidirectional",
      connectsToSystem: "phone.remote",
      protocol: "secure_websocket",
      whatIsExchanged: [
        "remote_commands",
        "status_updates",
        "approval_requests",
        "timeline_snapshots",
      ],
      security_level: "critical",
    },
    {
      portId: "cursorAI",
      direction: "bidirectional",
      connectsToSystem: "cursor.ai",
      protocol: "extension_api",
      whatIsExchanged: [
        "ai_requests",
        "code_proposals",
        "context_data",
        "response_handling",
      ],
      security_level: "medium",
    },
  ],
  internalEdges: [
    {
      from: "consoleUI",
      to: "rpcClient",
      type: "sends_commands",
      data_flow: "user_input \u2192 daemon_communication",
    },
    {
      from: "rpcClient",
      to: "consoleUI",
      type: "receives_responses",
      data_flow: "daemon_responses \u2192 ui_display",
    },
    {
      from: "voiceInput",
      to: "consoleUI",
      type: "provides_input",
      data_flow: "speech \u2192 text \u2192 ui_input",
    },
    {
      from: "consoleUI",
      to: "voiceOutput",
      type: "triggers_speech",
      data_flow: "ui_responses \u2192 text \u2192 speech",
    },
    {
      from: "phoneRemote",
      to: "rpcClient",
      type: "sends_remote_commands",
      data_flow: "phone_input \u2192 daemon_communication",
    },
    {
      from: "rpcClient",
      to: "phoneRemote",
      type: "sends_remote_responses",
      data_flow: "daemon_responses \u2192 phone_display",
    },
    {
      from: "geminiIntegration",
      to: "bidirectionalTranslator",
      type: "provides_reasoning",
      data_flow: "long_context \u2192 translation_engine",
    },
    {
      from: "bidirectionalTranslator",
      to: "geminiIntegration",
      type: "requests_reasoning",
      data_flow: "translation_requests \u2192 long_context",
    },
    {
      from: "hardGates",
      to: "fileHooks",
      type: "controls_mutations",
      data_flow: "approval_decisions \u2192 file_operations",
    },
    {
      from: "fileHooks",
      to: "hardGates",
      type: "reports_mutations",
      data_flow: "file_changes \u2192 approval_checks",
    },
    {
      from: "timelineLogger",
      to: "rpcClient",
      type: "logs_operations",
      data_flow: "audit_events \u2192 daemon_storage",
    },
    {
      from: "rpcClient",
      to: "timelineLogger",
      type: "provides_events",
      data_flow: "operation_data \u2192 audit_logging",
    },
  ],
  externalEdges: [
    {
      fromPort: "daemonIntegration",
      toSystem: "daemon_rag_system",
      type: "console_control",
      data_flow: "console_commands \u2192 daemon_processing",
    },
    {
      fromPort: "intentClassification",
      toSystem: "intent_classification_system",
      type: "behavior_gating",
      data_flow: "mission_profiles \u2192 console_behavior",
    },
    {
      fromPort: "cmcIntegration",
      toSystem: "cmc.contextMemoryCore",
      type: "audit_storage",
      data_flow: "timeline_events \u2192 memory_core",
    },
    {
      fromPort: "geminiAPI",
      toSystem: "gemini.external",
      type: "ai_reasoning",
      data_flow: "context_packs \u2192 ai_processing",
    },
    {
      fromPort: "phoneRemote",
      toSystem: "phone.remote",
      type: "remote_control",
      data_flow: "remote_commands \u2192 phone_interface",
    },
    {
      fromPort: "cursorAI",
      toSystem: "cursor.ai",
      type: "ai_coordination",
      data_flow: "ai_requests \u2192 cursor_processing",
    },
  ],
  riskOverlay: {
    perf_hotspots: [
      "consoleUI",
      "rpcClient",
      "geminiIntegration",
      "hardGates",
    ],
    security_sensitive_ports: [
      "daemonIntegration",
      "phoneRemote",
      "fileHooks",
      "geminiAPI",
    ],
    governance_touchpoints: [
      "hardGates",
      "timelineLogger",
      "bidirectionalTranslator",
      "fileHooks",
    ],
    critical_failure_modes: [
      "Silent file mutation without approval",
      "Loss of audit trail integrity",
      "Unauthorized remote access",
      "Context drift and memory loss",
    ],
    blast_radius: {
      consoleUI: "user_experience_interface",
      rpcClient: "all_daemon_communication",
      hardGates: "file_system_integrity",
      timelineLogger: "audit_trail_trust",
    },
  },
  governance: {
    hard_gates_enforced: true,
    confidence_thresholds_required: true,
    blast_radius_calculation_mandatory: true,
    human_approval_required: true,
    audit_trail_complete: true,
  },
  monitoring: {
    key_metrics: [
      "console_response_time_ms",
      "voice_processing_time_ms",
      "remote_control_latency_ms",
      "file_mutation_approval_rate",
      "audit_trail_completeness",
    ],
    alerts: [
      "unauthorized_file_mutation_attempt",
      "voice_processing_timeout",
      "remote_control_security_breach",
      "audit_trail_corruption",
      "context_drift_detected",
    ],
  },
