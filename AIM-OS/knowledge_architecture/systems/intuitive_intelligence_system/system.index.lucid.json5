{
  "systemId": "iis.intuitiveIntelligence",
  "humanName": "Intuitive Intelligence System - AI Intuition and Learning",
  "version": "v0.1",
  "status": "production",
  
  "intent": {
    "purpose": "Provide operational definition and learning loop for AI intuition. Computes IntuitionScore for candidate actions using calibrated confidence (VIF), retrieval quality (HHNI), meta-pattern similarity (CAS/timeline), emotional salience (TCS), and 4D evolution alignment. Learns online from outcomes and maintains auditability through CAS.",
    "must_not_regress": [
      "Must not skip intuition calculation",
      "Must not use uncalibrated confidence",
      "Must not lose learning data",
      "Must not skip trace generation",
      "Must not allow calibration drift"
    ],
    "why_it_exists": "Enables intuitive decision-making for AI consciousness. Provides learned intuition scores based on multiple cognitive dimensions and maintains continuous learning from outcomes."
  },
  
  "classification": {
    "security_level": "high",
    "perf_sensitivity": "medium",
    "ownership": "core",
    "sideEffects": [
      "Computes intuition scores for all decisions",
      "Learns from outcomes continuously",
      "Tracks calibration metrics",
      "Generates intuition traces",
      "Predicts evolution alignment"
    ]
  },
  
  "internalNodes": [
    {
      "id": "intuitionCalculator",
