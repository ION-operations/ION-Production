{
  "systemId": "lucid-chat.advancedAIChat",
  "humanName": "Lucid Chat Advanced AI System",
  "version": "v0.9.2",
  "status": "production_ready",
  
  "intent": {
    "purpose": "Enable sophisticated AI chat beyond simple Q&A by orchestrating 8 APOE roles, performing multi-source search, enabling branch reasoning, and coordinating specialized AI agents with full consciousness substrate integration",
    "must_not_regress": [
      "Must not expose API keys",
      "Must not allow unauthorized access",
      "Must not skip input validation",
      "Must not bypass quality gates",
      "Must not exceed budget without warning",
      "Must not return unvalidated output",
      "Must not lose chat history",
      "Must not skip error recovery"
    ],
    "why_it_exists": "Transforms simple AI chat into sophisticated cognitive orchestration, enabling humans to collaborate with AI that can orchestrate complex workflows, research autonomously, and improve itself over time with full consciousness substrate integration."
  },
  
  "classification": {
    "security_level": "critical",
    "perf_sensitivity": "high",
    "ownership": "lucid-ide",
    "sideEffects": [
      "Calls external LLM providers",
      "Performs web crawling and search",
      "Stores chat history in CMC",
      "Indexes context in HHNI",
      "Creates VIF witnesses",
      "Synthesizes knowledge via SEG",
      "Executes APOE workflows",
      "Coordinates multiple AI agents"
    ]
  },
  
  "internalNodes": [
    {
      "id": "advancedLLMService",
      "responsibility": "Advanced LLM service with thinking modes, prompt building, and output configuration",
      "must_never": [
        "Expose API keys",
        "Allow unauthorized access",
        "Skip input validation",
        "Return unvalidated output"
      ],
      "perf_budget_ms": 30000,
      "status": "production"
    },
    {
      "id": "workflowExecutor",
      "responsibility": "APOE workflow execution with DAG parallel processing",
      "must_never": [
        "Skip dependency validation",
        "Allow circular dependencies",
        "Exceed budget without warning",
        "Bypass quality gates"
      ],
      "perf_budget_ms": 60000,
      "status": "production"
    },
    {
      "id": "searchOrchestrator",
      "responsibility": "Orchestrates multi-provider search (DEEPSEARCH, ICIP, Perplexity, Tavily, Web)",
      "must_never": [
        "Expose API keys",
        "Skip result validation",
        "Allow unauthorized search"
      ],
      "perf_budget_ms": 5000,
      "status": "production"
    },
    {
      "id": "branchReasoningService",
      "responsibility": "Multi-path branch reasoning with parallel hypothesis exploration",
      "must_never": [
        "Skip hypothesis validation",
        "Allow infinite recursion",
        "Return unvalidated solutions"
      ],
      "perf_budget_ms": 30000,
      "status": "production"
    },
    {
      "id": "ardService",
      "responsibility": "Autonomous Research Dream with multi-source gathering and recursive research",
      "must_never": [
        "Skip research validation",
        "Allow infinite recursion",
        "Return unvalidated findings"
      ],
      "perf_budget_ms": 120000,
      "status": "production"
    },
    {
      "id": "multiAgentOrchestrator",
      "responsibility": "Coordinates 4 specialized agents with multiple orchestration strategies",
      "must_never": [
        "Allow agent conflicts",
        "Skip agent validation",
        "Expose agent internals"
      ],
      "perf_budget_ms": 60000,
      "status": "production"
    },
    {
      "id": "contextManager",
      "responsibility": "Context window management with 4 strategies and HHNI integration",
      "must_never": [
        "Exceed context budget",
        "Skip context validation",
        "Return inconsistent context"
      ],
      "perf_budget_ms": 500,
      "status": "production"
    },
    {
      "id": "qualityGates",
      "responsibility": "Enforces quality gates (κ-gating, VIF validation, SEG consistency)",
      "must_never": [
        "Skip quality validation",
        "Allow low-quality output",
        "Bypass gate thresholds"
      ],
      "perf_budget_ms": 50,
      "status": "production"
    }
  ],
  
  "systemMap": {
    "mapFile": "./system.map.lucid.json5"
  },
  
  "foresight": {
    "predictedRisks": [
      {
        "risk_id": "api_key_exposure",
        "description": "API keys could be exposed in error messages or logs",
        "likelihood": "medium",
        "blast_radius_if_real": "provider_account_compromise",
        "mitigation": "Sanitize error messages, secure logging, use environment variables",
        "watchpoint": "if api_key_in_log detected, alert immediately"
      },
      {
        "risk_id": "budget_exhaustion",
        "description": "Unlimited budget could exhaust API quotas or exceed cost limits",
        "likelihood": "medium",
        "blast_radius_if_real": "api_quota_exhausted_or_cost_overrun",
        "mitigation": "Enforce budget limits, track usage, alert on thresholds",
        "watchpoint": "if budget > 80% for 1 hour, alert and throttle"
      },
      {
        "risk_id": "recursive_research_infinite_loop",
        "description": "ARD recursive research could enter infinite loop",
        "likelihood": "low",
        "blast_radius_if_real": "system_hang_or_resource_exhaustion",
        "mitigation": "Enforce recursion depth limits, timeout protection",
        "watchpoint": "if recursion_depth > 5, halt and alert"
      },
      {
        "risk_id": "context_window_exceeded",
        "description": "Context window could exceed LLM provider limits",
        "likelihood": "medium",
        "blast_radius_if_real": "api_errors_or_truncated_responses",
        "mitigation": "Validate context size, truncate if needed, summarize old context",
        "watchpoint": "if context_tokens > provider_limit, alert and truncate"
      }
    ],
    "killSwitch": "lucid-chat.enabled=false",
    "emergencyProcedures": [
      "Disable all LLM provider calls immediately",
      "Switch to read-only mode",
      "Preserve chat history",
      "Notify all dependent systems",
      "Log emergency state for analysis"
    ]
  },
  
