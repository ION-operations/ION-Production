      status: "complete",
    },
    {
      portId: "tcsIntegration",
      direction: "bidirectional",
      connectsToSystem: "tcs.timelineContext",
      protocol: "internal_api",
      whatIsExchanged: [
        "timeline_entries",
        "context_snapshots",
        "evidence_transformation",
        "gate_evidence",
      ],
      security_level: "high",
      implementation: "packages/seg/tcs_integration.py",
      status: "complete",
    },
    {
      portId: "graphDatabase",
      direction: "outbound",
      connectsToSystem: "graph.neo4j",
      protocol: "cypher_api",
      whatIsExchanged: [
        "graph_queries",
        "node_updates",
        "relationship_changes",
        "index_updates",
      ],
      security_level: "medium",
    },
  ],
  internalEdges: [
    {
      from: "graphBuilder",
      to: "contradictionDetector",
      type: "provides_graph_structure",
      data_flow: "graph_structure \u2192 contradiction_analysis",
    },
    {
      from: "contradictionDetector",
      to: "conflictResolver",
      type: "provides_conflicts",
      data_flow: "detected_conflicts \u2192 resolution_processing",
    },
    {
      from: "conflictResolver",
      to: "knowledgeSynthesizer",
      type: "provides_resolved_evidence",
      data_flow: "resolved_evidence \u2192 synthesis_processing",
    },
    {
      from: "evidenceValidator",
      to: "graphBuilder",
      type: "validates_evidence",
      data_flow: "validated_evidence \u2192 graph_construction",
    },
    {
      from: "relationshipMapper",
      to: "graphBuilder",
      type: "provides_relationships",
      data_flow: "relationship_mappings \u2192 graph_structure",
    },
    {
      from: "consistencyChecker",
      to: "all_components",
      type: "ensures_consistency",
      data_flow: "consistency_checks \u2192 all_operations",
    },
    {
      from: "knowledgeSynthesizer",
      to: "insightExtractor",
      type: "provides_synthesis",
      data_flow: "synthesized_knowledge \u2192 insight_extraction",
    },
    {
      from: "graphOptimizer",
      to: "graphBuilder",
      type: "optimizes_structure",
      data_flow: "optimization_suggestions \u2192 graph_improvements",
    },
  ],
  externalEdges: [
    {
      fromPort: "cmcIntegration",
      toSystem: "cmc.contextMemoryCore",
