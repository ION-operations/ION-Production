    low: "Read T0 + T1 + T2 + T3 detailed (10k words)",
    veryLow: "Read T0 + T1 + T2 + T3 + T4 complete (15k+ words) or ask for help",
  },
  relatedSystems: [
    {
      system: "lucid_mcp_integration",
      relationship: "Daemon/RAG manages MCP tool selection and server lifecycle",
      whenToUse: "When implementing tool management or understanding MCP integration",
      docs: [
        "systems/lucid_mcp_integration/T2_architecture.md#daemon-integration",
      ],
      priority: "required",
    },
    {
      system: "mcp_tools",
      relationship: "Daemon/RAG uses MCP Tools registry for tool metadata",
      whenToUse: "When implementing tool registry or understanding tool metadata",
      docs: [
        "systems/mcp_tools/T2_architecture.md#daemon-integration",
      ],
      priority: "required",
    },
    {
      system: "intent_classification_system",
      relationship: "Daemon/RAG uses Intent Classification for context analysis",
      whenToUse: "When implementing context analysis or understanding intent classification",
      docs: [
        "systems/intent_classification_system/T2_architecture.md#daemon-integration",
      ],
      priority: "optional",
