+        "domain_id": _text(district.get("domain_id"), ""),
+        "label": _text(district.get("label"), _text((domain_card or {}).get("label"), "")),
+        "color_token": district.get("color_token") or (domain_card or {}).get("color_token"),
+        "risk_heat": district.get("risk_heat", (domain_card or {}).get("risk_heat", 0)),
+        "centroid": centroid,
