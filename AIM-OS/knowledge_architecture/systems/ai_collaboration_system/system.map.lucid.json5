{
  system_id: "ai_collaboration_system",
  system_name: "AI Collaboration System",
  version: "1.0.0",
  last_updated: "2025-01-27T20:50:00Z",
  map_type: "system_topology",
  internal_topology: {
    core_components: [
      {
        component_id: "ai_communication_engine",
        name: "AI Communication Engine",
        type: "communication_engine",
        tier: 2,
        description: "Manages communication between AI systems and agents",
        ports: {
          input: [
            "communication_requests",
            "communication_rules",
          ],
          output: [
            "communication_responses",
            "communication_status",
          ],
        },
        dependencies: [
          "message_router",
          "protocol_handler",
        ],
        blast_radius: "platform",
        must_never: [
          "Communicate without validation",
          "Skip communication rules",
          "Ignore protocol requirements",
          "Bypass communication validation",
        ],
      },
      {
        component_id: "collaboration_coordinator",
        name: "Collaboration Coordinator",
        type: "coordination_engine",
        tier: 2,
        description: "Coordinates collaboration between AI systems and agents",
        ports: {
          input: [
            "collaboration_requests",
            "coordination_rules",
          ],
          output: [
            "collaboration_status",
            "coordination_events",
          ],
        },
        dependencies: [
          "coordination_rules",
          "workflow_manager",
        ],
        blast_radius: "platform",
        must_never: [
          "Coordinate without validation",
          "Skip coordination rules",
          "Ignore workflow requirements",
          "Bypass coordination validation",
        ],
      },
      {
        component_id: "task_distributor",
        name: "Task Distributor",
        type: "distribution_engine",
        tier: 2,
        description: "Distributes tasks among AI systems and agents",
        ports: {
          input: [
            "task_requests",
            "distribution_rules",
          ],
          output: [
            "task_assignments",
            "distribution_status",
          ],
        },
        dependencies: [
          "distribution_rules",
          "load_balancer",
        ],
        blast_radius: "platform",
        must_never: [
          "Distribute tasks without validation",
          "Skip distribution rules",
          "Ignore load balancing requirements",
          "Bypass distribution validation",
        ],
      },
      {
        component_id: "knowledge_sharer",
        name: "Knowledge Sharer",
        type: "sharing_engine",
        tier: 2,
        description: "Shares knowledge and insights between AI systems",
        ports: {
          input: [
            "knowledge_requests",
            "sharing_rules",
          ],
          output: [
            "shared_knowledge",
            "sharing_status",
          ],
        },
        dependencies: [
          "sharing_rules",
          "knowledge_processor",
        ],
        blast_radius: "platform",
        must_never: [
          "Share knowledge without validation",
          "Skip sharing rules",
          "Ignore knowledge requirements",
          "Bypass sharing validation",
        ],
      },
      {
        component_id: "collaboration_monitor",
        name: "Collaboration Monitor",
        type: "monitoring_engine",
        tier: 2,
        description: "Monitors collaboration performance and effectiveness",
        ports: {
          input: [
            "monitoring_requests",
            "monitoring_rules",
          ],
          output: [
            "monitoring_reports",
            "performance_metrics",
          ],
        },
        dependencies: [
          "monitoring_rules",
          "metrics_collector",
        ],
        blast_radius: "platform",
        must_never: [
          "Monitor without validation",
          "Skip monitoring rules",
          "Ignore performance requirements",
          "Bypass monitoring validation",
        ],
      },
    ],
    supporting_components: [
      {
        component_id: "message_router",
        name: "Message Router",
        type: "routing_engine",
        tier: 1,
        description: "Routes messages between AI systems",
        ports: {
          input: [
            "message_requests",
            "routing_rules",
          ],
          output: [
            "routed_messages",
            "routing_status",
          ],
        },
        dependencies: [
          "routing_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Route messages without validation",
          "Skip routing rules",
          "Ignore routing requirements",
          "Bypass routing validation",
        ],
      },
      {
        component_id: "protocol_handler",
        name: "Protocol Handler",
        type: "protocol_engine",
        tier: 1,
        description: "Handles communication protocols between AI systems",
        ports: {
          input: [
            "protocol_requests",
            "protocol_rules",
          ],
          output: [
            "protocol_responses",
            "protocol_status",
          ],
        },
        dependencies: [
          "protocol_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Handle protocols without validation",
          "Skip protocol rules",
          "Ignore protocol requirements",
          "Bypass protocol validation",
        ],
      },
      {
        component_id: "workflow_manager",
        name: "Workflow Manager",
        type: "workflow_engine",
        tier: 1,
        description: "Manages collaboration workflows",
        ports: {
          input: [
            "workflow_requests",
            "workflow_rules",
          ],
          output: [
            "workflow_status",
            "workflow_events",
          ],
        },
        dependencies: [
          "workflow_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Manage workflows without validation",
          "Skip workflow rules",
          "Ignore workflow requirements",
          "Bypass workflow validation",
        ],
      },
      {
        component_id: "load_balancer",
        name: "Load Balancer",
        type: "balancing_engine",
        tier: 1,
        description: "Balances load across AI systems",
        ports: {
          input: [
            "load_requests",
            "balancing_rules",
          ],
          output: [
            "load_balance",
            "balancing_status",
          ],
        },
        dependencies: [
          "balancing_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Balance load without validation",
          "Skip balancing rules",
          "Ignore load requirements",
          "Bypass balancing validation",
        ],
      },
      {
        component_id: "knowledge_processor",
        name: "Knowledge Processor",
        type: "processing_engine",
        tier: 1,
        description: "Processes knowledge for sharing between AI systems",
        ports: {
          input: [
            "knowledge_data",
            "processing_rules",
          ],
          output: [
            "processed_knowledge",
            "processing_status",
          ],
        },
        dependencies: [
          "processing_rules",
        ],
        blast_radius: "local",
        must_never: [
          "Process knowledge without validation",
          "Skip processing rules",
          "Ignore knowledge requirements",
          "Bypass processing validation",
        ],
      },
    ],
  },
  boundary_tendrils: {
    input_ports: [
      {
        port_id: "communication_requests_input",
        name: "Communication Requests Input",
        type: "data_input",
        protocol: "json",
        description: "Receives communication requests between AI systems",
        required: true,
        validation: "communication_requests_schema",
