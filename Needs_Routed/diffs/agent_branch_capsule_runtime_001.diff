+    render_identity_card,
+    validate_branch_record,
+)
+
+
+def _seed_root(root: Path) -> None:
+    (root / "pyproject.toml").write_text("[project]\nname = \"ion-test\"\n", encoding="utf-8")
+    (root / "ION/REPO_AUTHORITY.md").parent.mkdir(parents=True, exist_ok=True)
+    (root / "ION/REPO_AUTHORITY.md").write_text("# authority\n", encoding="utf-8")
+
+
+def test_branch_record_normalizes_tags_and_renders_identity_card(tmp_path: Path):
+    _seed_root(tmp_path)
+    record = build_branch_capsule_record(
+        tmp_path,
+        conversation_tag="Helixion JOC Recovery",
+        agent_tag="Codex UI Recovery",
+        task_tag="Anchored Pages Drawer Canon",
+        emitted_at="2026-05-11T15:02:10+00:00",
+    )
+
+    assert record.context_instance_id == "ctx_20260511T150210Z_anchored_pages_drawer_canon"
+    assert record.branch_id == "branch_20260511T150210Z_anchored_pages_drawer_canon"
+    assert record.conversation_tag == "helixion_joc_recovery"
+    assert record.agent_tag == "codex_ui_recovery"
+    assert record.task_tag == "anchored_pages_drawer_canon"
+    assert record.shared_context_write is False
+    assert record.settlement_required is True
+
+    card = render_identity_card(record)
+    assert "AGENT_TAG: codex_ui_recovery" in card
+    assert "CONTEXT_INSTANCE: ctx_20260511T150210Z_anchored_pages_drawer_canon" in card
+    assert "SHARED_CONTEXT_WRITE: false" in card
+
+
+def test_validate_branch_record_blocks_shared_context_and_overlaps(tmp_path: Path):
+    _seed_root(tmp_path)
+    record = build_branch_capsule_record(
+        tmp_path,
+        conversation_tag="demo",
+        agent_tag="agent",
+        task_tag="task",
+        write_scope=[SHARED_CONTEXT_SURFACES[0], "ION/04_packages/kernel/example.py"],
+        emitted_at="2026-05-11T15:02:10+00:00",
+    )
+
+    result = validate_branch_record(
+        tmp_path,
+        record,
+        active_claims=[
+            {
+                "claim_id": "other_claim",
+                "branch_id": "branch_other",
+                "write_scope": ["ION/04_packages/kernel/example.py"],
+            }
+        ],
+    )
+
+    assert result["ok"] is False
+    assert result["verdict"] == BLOCKED_VERDICT
+    assert f"shared_context_write_scope_forbidden:{SHARED_CONTEXT_SURFACES[0]}" in result["findings"]
+    assert "write_scope_overlap:ION/04_packages/kernel/example.py:with:other_claim" in result["findings"]
+
+
+def test_create_branch_capsule_writes_only_branch_lane_and_settlement_packet(tmp_path: Path):
+    _seed_root(tmp_path)
+
+    result = create_branch_capsule(
+        tmp_path,
+        conversation_tag="Helixion JOC Recovery",
+        agent_tag="Codex UI Recovery",
+        task_tag="Anchored Pages Drawer Canon",
+        write_scope=["ION/04_packages/kernel/ion_codex_chat_shell_ui.py"],
+        emitted_at="2026-05-11T15:02:10+00:00",
+        settlement_request=True,
+    )
+
+    assert result["ok"] is True
+    assert result["verdict"] == READY_VERDICT
+    branch_path = tmp_path / result["record"]["branch_path"]
+    assert (branch_path / "CAPSULE.md").exists()
+    assert (branch_path / "MINI.md").exists()
+    assert (branch_path / "STATUS.json").exists()
+    assert (branch_path / "LOADED_REFS.json").exists()
+    assert (branch_path / "BRANCH_RECORD.json").exists()
+    assert (branch_path / "RECEIPTS").is_dir()
+    assert (branch_path / "TASK_RETURNS").is_dir()
+    assert (branch_path / "SETTLEMENT_REQUESTS").is_dir()
+
+    status = json.loads((branch_path / "STATUS.json").read_text(encoding="utf-8"))
+    assert status["status"] == "ACTIVE_PROVISIONAL"
+    assert status["shared_context_write"] is False
+    assert status["settlement_required"] is True
+
+    registry = json.loads((tmp_path / BRANCH_REGISTRY_PATH).read_text(encoding="utf-8"))
+    assert registry["active_branches"][0]["branch_id"] == result["record"]["branch_id"]
+    assert registry["active_branches"][0]["shared_context_write"] is False
+
+    inbox_files = list((tmp_path / SETTLEMENT_INBOX).glob("SETTLE_BRANCH_*.json"))
+    assert len(inbox_files) == 1
+    inbox_packet = json.loads(inbox_files[0].read_text(encoding="utf-8"))
+    assert inbox_packet["status"] == "CANDIDATE_PENDING_SETTLEMENT"
+    assert inbox_packet["branch_identity"]["branch_id"] == result["record"]["branch_id"]
+    assert "This packet does not update shared Capsule/Mini/HOT_CONTEXT." in inbox_packet["non_claims"]
+
+    for rel in SHARED_CONTEXT_SURFACES:
+        assert not (tmp_path / rel).exists()

