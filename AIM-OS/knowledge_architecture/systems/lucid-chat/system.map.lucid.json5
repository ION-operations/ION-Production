      status: "production",
      must_never: [
        "Exceed context budget",
        "Skip context validation",
        "Return inconsistent context",
      ],
      perf_budget_ms: 500,
      security_level: "high",
    },
    {
      id: "userProfileService",
      kind: "memory.component",
      responsibility: "User profiling with preferences, personalization, and long-term memory extraction",
      status: "production",
      must_never: [
        "Expose user data without authorization",
        "Skip profile validation",
        "Allow unauthorized profile access",
      ],
      perf_budget_ms: 100,
      security_level: "critical",
    },
    {
      id: "inputValidator",
