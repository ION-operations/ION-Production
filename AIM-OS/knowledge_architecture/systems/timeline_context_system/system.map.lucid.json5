      must_never: [
        "Lose prompt context",
        "Skip prompt tracking",
        "Create inconsistent prompts",
        "Allow prompt corruption",
      ],
      perf_budget_ms: 10,
      security_level: "high",
    },
    {
      id: "emotionalStateTracker",
