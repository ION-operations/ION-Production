  ],
  
  "exceptions": [],
  
  "apiEndpoints": [
    {
      "name": "get_atom",
      "path": "packages/cmc_service/memory_store.py#get_atom",
      "purpose": "Retrieve a single atom by ID (supports SEG, test workflows)",
      "stability": "stable"
    },
    {
      "name": "store_timeline_entry_for_seg",
      "path": "packages/cmc_service/tcs_seg_integration_helper.py#store_timeline_entry_for_seg",
      "purpose": "TCS→CMC helper to store timeline entry and return atom_id for SEG ingest",
      "stability": "stable"
    }
  ],
  
  "keyFlows": [
    {
      "id": "tcs_cmc_seg_gate",
      "name": "TCS→CMC→SEG Gate Evidence Flow",
      "steps": [
        "TCS creates timeline entry",
        "CMC stores entry as modality 'tcs_timeline' (helper) → returns atom_id",
        "SEG ingests by atom_id → returns evidence_id",
        "Capture tuple (prompt_id, atom_id, evidence_id)"
      ]
    },
    {
      "id": "apoe_plan_execution_atoms",
      "name": "APOE plan_execution Atom Schema",
      "summary": "APOE stores execution state as atoms with modality 'plan_execution' tagged apoe/plan/status:*; includes metadata (plan_name, execution_id, steps, timings)"
    }
  ],
  
