  map_type: "system_topology",
  internal_topology: {
    core_components: [
      {
        component_id: "context_archive_manager",
        name: "Context Archive Manager",
        type: "archive_engine",
        tier: 2,
        description: "Manages deep context appendices as large, optional, lazy-loaded historical mind",
        ports: {
          input: [
            "context_data",
            "archive_rules",
          ],
          output: [
            "context_archives",
            "archive_status",
          ],
        },
        dependencies: [
          "context_parser",
          "archive_builder",
        ],
        blast_radius: "system",
        must_never: [
          "Archive context without validation",
          "Skip archive rules",
          "Ignore context requirements",
          "Bypass archive validation",
        ],
      },
      {
        component_id: "context_parser",
        name: "Context Parser",
        type: "parsing_engine",
        tier: 2,
        description: "Parses and processes context data for deep appendices",
        ports: {
          input: [
            "context_data",
            "parsing_rules",
          ],
          output: [
            "parsed_context",
            "parsing_errors",
          ],
        },
        dependencies: [
          "parsing_rules",
          "context_validator",
        ],
        blast_radius: "local",
        must_never: [
          "Parse context without validation",
          "Skip parsing rules",
          "Ignore context requirements",
          "Bypass parsing validation",
        ],
      },
      {
        component_id: "archive_builder",
        name: "Archive Builder",
        type: "building_engine",
        tier: 2,
        description: "Builds deep context appendices from parsed context data",
        ports: {
          input: [
            "parsed_context",
            "archive_rules",
          ],
          output: [
            "context_archives",
            "building_status",
          ],
        },
        dependencies: [
          "archive_templates",
          "validation_engine",
        ],
        blast_radius: "local",
        must_never: [
          "Build archives without validation",
          "Skip archive rules",
          "Ignore archive requirements",
          "Bypass building validation",
        ],
      },
      {
        component_id: "lazy_loader",
        name: "Lazy Loader",
        type: "loading_engine",
        tier: 2,
        description: "Provides lazy loading of deep context appendices based on mutation type",
        ports: {
          input: [
            "load_requests",
            "loading_rules",
          ],
          output: [
            "loaded_context",
            "loading_status",
          ],
        },
        dependencies: [
          "loading_rules",
          "cache_manager",
