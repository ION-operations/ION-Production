        "Generate 1024x1024 blue noise texture (currently random, not true blue noise)",
        "Provide dithering source for shaders",
        "Create R8 texture for single-channel sampling",
      ],
      interfaces: {
        inputs: ["Random seed (currently Math.random())"],
        outputs: ["Blue noise texture (sampler2D iChannel2)"],
      },
      performance: {
