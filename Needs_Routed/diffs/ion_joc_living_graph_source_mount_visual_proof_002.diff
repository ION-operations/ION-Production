@@ -0,0 +1,248 @@
+"Static proof harness for the ION Living Operational Graph JOC surface."
+
+from __future__ import annotations
+
+import argparse
+import json
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+from .ion_living_graph_view_model import OUTPUT, build_living_graph_view_model
+
+VISUAL_PROOF_OUTPUT = Path("ION/05_context/current/ACTIVE_LIVING_GRAPH_VISUAL_PROOF.json")
+STATIC_SVG_OUTPUT = Path("ION/05_context/current/living_graph/ACTIVE_LIVING_GRAPH_STATIC_PROOF.svg")
+PANEL_PATH = Path("ION/08_ui/joc_cockpit_shell/LivingGraphWorkbenchPanel.tsx")
+CSS_PATH = Path("ION/08_ui/joc_cockpit_shell/ion-runtime-cockpit.css")
+
+REQUIRED_TSX_MARKERS = {
+    "workbench": "ion-living-graph-workbench",
+    "top": "ion-living-graph-top",
+    "left_drawer": "ion-living-graph-left",
+    "viewport": "ion-living-graph-viewport",
+    "right_inspector": "ion-living-graph-inspector",
+    "bottom_timeline": "ion-living-graph-timeline",
+    "svg_viewport": "<svg",
+    "node_selection": "setActiveNodeId",
+    "layer_controls": "hiddenLayers",
+}
+
+REQUIRED_CSS_MARKERS = {
+    "grid_shell": "grid-template-areas",
+    "top_area": "graphTop",
+    "left_area": "graphLeft",
+    "viewport_area": "graphViewport",
+    "inspector_area": "graphInspector",
+    "timeline_area": "graphTimeline",
+    "no_page_monolith": "overflow: hidden",
+    "internal_scroll_drawer": ".ion-living-graph-left",
+    "internal_scroll_inspector": ".ion-living-graph-inspector",
+}
+
+FORBIDDEN_PRIMARY_PATTERNS = {
+    "emoji_icon_hint": "🚀",
+    "generic_blue_hsl": "hsl(210",
+    "generic_material_purple": "#6200ee",
+    "generic_bootstrap_primary": "#0d6efd",
+}
+
+
+def utc_now() -> str:
+    return datetime.now(timezone.utc).replace(microsecond=0).isoformat()
+
+
+def _read_text(path: Path) -> str:
+    try:
+        return path.read_text(encoding="utf-8")
+    except FileNotFoundError:
+        return ""
+
+
+def _present(text: str, marker: str) -> bool:
+    return marker in text
+
+
+def _static_shell_checks(root: Path) -> dict[str, Any]:
+    panel_text = _read_text(root / PANEL_PATH)
+    css_text = _read_text(root / CSS_PATH)
+    tsx_checks = {key: _present(panel_text, marker) for key, marker in REQUIRED_TSX_MARKERS.items()}
+    css_checks = {key: _present(css_text, marker) for key, marker in REQUIRED_CSS_MARKERS.items()}
+    forbidden = {key: _present(panel_text + "\n" + css_text, pattern) for key, pattern in FORBIDDEN_PRIMARY_PATTERNS.items()}
+    grid_area_count = (
+        css_text.count("graphTop")
+        + css_text.count("graphLeft")
+        + css_text.count("graphViewport")
+        + css_text.count("graphInspector")
+        + css_text.count("graphTimeline")
+    )
+    return {
+        "panel_path": str(PANEL_PATH),
+        "css_path": str(CSS_PATH),
+        "tsx_marker_checks": tsx_checks,
+        "css_marker_checks": css_checks,
+        "forbidden_pattern_hits": {key: value for key, value in forbidden.items() if value},
+        "grid_area_marker_count": grid_area_count,
+        "all_required_markers_present": all(tsx_checks.values()) and all(css_checks.values()),
+        "forbidden_patterns_absent": not any(forbidden.values()),
+    }
+
+
+def _model_checks(model: dict[str, Any]) -> dict[str, Any]:
+    kpis = model.get("kpis", {}) if isinstance(model.get("kpis"), dict) else {}
+    proof_gates = model.get("proof_gates", {}) if isinstance(model.get("proof_gates"), dict) else {}
+    honesty = model.get("honesty", {}) if isinstance(model.get("honesty"), dict) else {}
+    return {
+        "status_ready": model.get("status") == "ready",
+        "sample_not_live": bool(honesty.get("live_telemetry_connected") is False),
+        "node_count": kpis.get("node_count", 0),
+        "edge_count": kpis.get("edge_count", 0),
+        "event_count": kpis.get("event_count", 0),
+        "domain_count": kpis.get("domain_count", 0),
+        "visible_node_count": kpis.get("visible_node_count", 0),
+        "visible_edge_count": kpis.get("visible_edge_count", 0),
+        "visible_nodes_project_all_nodes": bool(proof_gates.get("visible_nodes_project_all_nodes")),
+        "visible_edges_project_all_edges": bool(proof_gates.get("visible_edges_project_all_edges")),
+        "required_zones_present": bool(proof_gates.get("required_zones_present")),
+        "references_resolve": bool(proof_gates.get("references_resolve")),
+        "honesty_badges_required": bool(proof_gates.get("honesty_badges_required")),
+    }
+
+
+def _build_static_svg(model: dict[str, Any]) -> str:
+    nodes = [node for node in model.get("visible_nodes", []) if isinstance(node, dict)]
+    edges = [edge for edge in model.get("visible_edges", []) if isinstance(edge, dict)]
+
+    def screen_point(node: dict[str, Any], index: int) -> tuple[float, float]:
+        pos = node.get("position", {}) if isinstance(node.get("position"), dict) else {}
+        x = pos.get("x")
+        z = pos.get("z")
+        if isinstance(x, (int, float)) and isinstance(z, (int, float)):
+            return 480 + (float(x) * 32), 300 + (float(z) * 27)
+        return 480 + ((index % 12) - 6) * 60, 300 + ((index // 12) - 2) * 52
+
+    point_by_id = {node.get("id"): screen_point(node, i) for i, node in enumerate(nodes)}
+    edge_lines: list[str] = []
+    for edge in edges[:96]:
+        a = point_by_id.get(edge.get("source"))
+        b = point_by_id.get(edge.get("target"))
+        if not a or not b:
+            continue
+        dash = "4 6" if edge.get("type") != "routes_to" else "none"
+        edge_lines.append(
+            f'<line x1="{a[0]:.1f}" y1="{a[1]:.1f}" x2="{b[0]:.1f}" y2="{b[1]:.1f}" '
+            f'stroke="#5d5d5d" stroke-width="1" stroke-dasharray="{dash}" opacity="0.58" />'
+        )
+
+    node_shapes: list[str] = []
+    for i, node in enumerate(nodes[:96]):
+        x, y = point_by_id.get(node.get("id"), screen_point(node, i))
+        is_core = node.get("type") == "core"
+        w = 104 if is_core else 76
+        h = 44 if is_core else 34
+        label = str(node.get("label") or node.get("id") or "node").replace("&", "&amp;").replace("<", "&lt;")
+        node_shapes.append(
+            f'<g><rect x="{x - w / 2:.1f}" y="{y - h / 2:.1f}" width="{w}" height="{h}" '
+            f'rx="2" fill="#111" stroke="#9a9a9a" stroke-width="1" />'
+            f'<text x="{x:.1f}" y="{y - 2:.1f}" fill="#e6e6e6" font-family="monospace" '
+            f'font-size="8" text-anchor="middle">{label[:22]}</text>'
+            f'<text x="{x:.1f}" y="{y + 10:.1f}" fill="#8b8b8b" font-family="monospace" '
+            f'font-size="7" text-anchor="middle">{node.get("type", "node")}</text></g>'
+        )
+
+    title = f"{model.get('source_package_id') or 'ION Living Graph'} / {model.get('status')}"
+    return (
+        '<svg xmlns="http://www.w3.org/2000/svg" width="960" height="600" viewBox="0 0 960 600" '
+        'role="img" aria-label="ION Living Operational Graph static proof">'
+        '<rect x="0" y="0" width="960" height="600" fill="#050505"/>'
+        '<rect x="18" y="18" width="924" height="564" rx="2" fill="#080808" stroke="#2a2a2a"/>'
+        f'<text x="32" y="44" fill="#e6e6e6" font-family="monospace" font-size="13">{title}</text>'
+        '<text x="32" y="64" fill="#9a9a9a" font-family="monospace" font-size="9">'
+        'static candidate proof only / not live telemetry / not accepted state</text>'
+        f'<g opacity="0.42">{"".join(edge_lines)}</g>'
+        f'<g>{"".join(node_shapes)}</g>'
+        '</svg>\n'
+    )
+
+
+def build_living_graph_visual_proof(root: str | Path = ".", *, write: bool = False) -> dict[str, Any]:
+    root_path = Path(root)
+    model = build_living_graph_view_model(root_path)
+    shell = _static_shell_checks(root_path)
+    model_check = _model_checks(model)
+
+    gates = {
+        "model_ready": model_check["status_ready"],
+        "sample_honesty_visible": model_check["sample_not_live"],
+        "full_sample_node_count": int(model_check["node_count"] or 0) >= 64,
+        "full_sample_edge_count": int(model_check["edge_count"] or 0) >= 72,
+        "full_sample_event_count": int(model_check["event_count"] or 0) >= 66,
+        "all_nodes_projected": bool(model_check["visible_nodes_project_all_nodes"]),
+        "all_edges_projected": bool(model_check["visible_edges_project_all_edges"]),
+        "required_shell_markers_present": bool(shell["all_required_markers_present"]),
+        "forbidden_primary_patterns_absent": bool(shell["forbidden_patterns_absent"]),
+        "references_resolve": bool(model_check["references_resolve"]),
+        "no_live_telemetry_claim": bool(model_check["sample_not_live"]),
+    }
+    proof = {
+        "schema_id": "ion.living_graph.visual_proof_static.v1",
+        "generated_at": utc_now(),
+        "status": "candidate_visual_static_pass" if all(gates.values()) else "candidate_visual_static_watch",
+        "model": model_check,
+        "shell": shell,
+        "gates": gates,
+        "source_paths": model.get("source_paths"),
+        "output_paths": {
+            "active_view_model": str(OUTPUT),
+            "visual_proof": str(VISUAL_PROOF_OUTPUT),
+            "static_svg": str(STATIC_SVG_OUTPUT),
+        },
+        "authority": {
+            "accepted_state": False,
+            "production_authority": False,
+            "live_telemetry": False,
+            "browser_screenshot_proof": False,
+            "settlement_required_for_inheritance": True,
+        },
+        "non_claims": [
+            "not_browser_screenshot_proof",
+            "not_accepted_ion_state",
+            "not_live_telemetry",
+            "not_production_ui",
+            "not_runtime_mutation",
+        ],
+        "next_required_proof": [
+            "local_browser_screenshot",
+            "keyboard_focus_smoke",
+            "shell_zone_no_monolith_visual_check",
+            "operator_review_against_ui_canon",
+        ],
+    }
+
+    if write:
+        out = root_path / VISUAL_PROOF_OUTPUT
+        out.parent.mkdir(parents=True, exist_ok=True)
+        out.write_text(json.dumps(proof, indent=2, sort_keys=True), encoding="utf-8")
+
+        model_out = root_path / OUTPUT
+        model_out.parent.mkdir(parents=True, exist_ok=True)
+        model_out.write_text(json.dumps(model, indent=2, sort_keys=True), encoding="utf-8")
+
+        svg_out = root_path / STATIC_SVG_OUTPUT
+        svg_out.parent.mkdir(parents=True, exist_ok=True)
+        svg_out.write_text(_build_static_svg(model), encoding="utf-8")
+
+    return proof
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="Build static proof for the ION Living Operational Graph JOC surface.")
+    parser.add_argument("--root", default=".", help="ION repository root")
+    parser.add_argument("--write", action="store_true", help="Write ACTIVE_LIVING_GRAPH_VISUAL_PROOF.json and static SVG")
+    args = parser.parse_args(argv)
+    proof = build_living_graph_visual_proof(args.root, write=args.write)
+    print(json.dumps(proof, indent=2, sort_keys=True))
+    return 0 if proof["status"] == "candidate_visual_static_pass" else 1
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
