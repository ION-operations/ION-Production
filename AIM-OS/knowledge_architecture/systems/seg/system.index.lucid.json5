{
  "systemId": "seg.sharedEvidenceGraph",
  "humanName": "Shared Evidence Graph - Knowledge Synthesis and Contradiction Detection",
  "version": "v2.2.0",
  "status": "production",
  
  "intent": {
    "purpose": "Provide knowledge synthesis system that builds a shared evidence graph to detect contradictions, resolve conflicts, and synthesize insights across all AIM-OS systems. Think 'AI's reasoning engine' - connects all knowledge, finds patterns, and maintains logical consistency.",
    "must_not_regress": [
      "Must not create circular dependencies in graph",
      "Must not miss critical contradictions",
      "Must not resolve conflicts without evidence",
      "Must not synthesize without sufficient evidence",
      "Must not allow logical inconsistencies"
    ],
    "why_it_exists": "Enables knowledge synthesis across all AIM-OS systems. Detects contradictions, resolves conflicts, and maintains logical consistency. Provides reasoning engine for AI consciousness."
  },
  
  "classification": {
    "security_level": "critical",
    "perf_sensitivity": "high",
    "ownership": "core",
    "sideEffects": [
      "Builds shared evidence graph across all systems",
      "Detects contradictions and conflicts",
      "Resolves conflicts using evidence strength",
      "Synthesizes insights and patterns",
      "Maintains logical consistency"
    ]
  },
  
  "internalNodes": [
    {
      "id": "graphBuilder",
      "responsibility": "Builds and maintains the shared evidence graph structure",
      "must_never": [
        "Create circular dependencies in graph",
        "Lose graph connectivity",
        "Allow inconsistent graph state"
      ],
      "perf_budget_ms": 50,
      "status": "production"
    },
    {
      "id": "contradictionDetector",
      "responsibility": "Detects contradictions and conflicts in the evidence graph",
      "must_never": [
        "Miss critical contradictions",
        "Create false positive conflicts",
        "Lose contradiction context"
      ],
      "perf_budget_ms": 30,
      "status": "production"
    },
    {
      "id": "conflictResolver",
      "responsibility": "Resolves conflicts using evidence strength and provenance",
      "must_never": [
        "Resolve conflicts without evidence",
        "Lose conflict resolution reasoning",
        "Create inconsistent resolutions"
      ],
      "perf_budget_ms": 40,
      "status": "production"
    },
    {
      "id": "knowledgeSynthesizer",
      "responsibility": "Synthesizes insights and patterns from the evidence graph",
      "must_never": [
        "Synthesize without sufficient evidence",
        "Create false synthesis patterns",
        "Lose synthesis provenance"
      ],
      "perf_budget_ms": 60,
      "status": "production"
    },
    {
      "id": "evidenceValidator",
      "responsibility": "Validates evidence quality and reliability",
      "must_never": [
        "Accept invalid evidence",
        "Skip evidence validation",
        "Lose validation reasoning"
      ],
      "perf_budget_ms": 25,
      "status": "production"
    },
    {
      "id": "relationshipMapper",
      "responsibility": "Maps relationships and dependencies between evidence nodes",
      "must_never": [
        "Create incorrect relationships",
        "Lose relationship context",
        "Allow relationship cycles"
      ],
      "perf_budget_ms": 35,
      "status": "production"
    },
    {
      "id": "consistencyChecker",
      "responsibility": "Maintains logical consistency across the entire graph",
      "must_never": [
        "Allow logical inconsistencies",
        "Skip consistency checks",
        "Lose consistency reasoning"
      ],
      "perf_budget_ms": 45,
      "status": "production"
    },
    {
      "id": "insightExtractor",
      "responsibility": "Extracts actionable insights from graph patterns",
      "must_never": [
        "Extract insights without evidence",
        "Create misleading insights",
        "Lose insight provenance"
      ],
      "perf_budget_ms": 20,
      "status": "production"
    },
    {
      "id": "graphOptimizer",
      "responsibility": "Optimizes graph structure for performance and clarity",
      "must_never": [
        "Lose graph information during optimization",
        "Create optimization artifacts",
        "Break graph connectivity"
      ],
      "perf_budget_ms": 70,
      "status": "production"
    }
