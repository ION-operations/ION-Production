+def build_task_return_settlement_packet(
+    record: BranchCapsuleRecord | dict[str, Any],
+    *,
+    preflight_result: dict[str, Any],
+    task_return_id: str | None = None,
+    touched_paths: Iterable[str] | None = None,
+    diff_refs: Iterable[str] | None = None,
+    validation_refs: Iterable[str] | None = None,
+    result_summary: str = "branch material work candidate ready for settlement intake",
+    requested_outcome: str = "MERGE_PROPOSAL_REQUIRED",
+) -> dict[str, Any]:
+    """Build a material-work settlement candidate with guard evidence.
+
+    This helper does not accept or merge the branch output. It creates the
+    packet shape the context settler can intake and review.
+    """
+
+    data = asdict(record) if isinstance(record, BranchCapsuleRecord) else dict(record)
+    branch_identity = _branch_identity(data)
+    requested_scope = tuple(_rel_path(p) for p in (preflight_result.get("requested_write_scope") or ()))
+    touched = tuple(_rel_path(p) for p in (touched_paths or requested_scope))
+    diffs = tuple(_rel_path(p) for p in (diff_refs or ()))
+    validations = tuple(_rel_path(p) for p in (validation_refs or ()))
+    packet_id = task_return_id or f"SETTLE_TASK_RETURN_{data['branch_id']}"
+    source_refs = [
+        data["branch_path"] + "/BRANCH_RECORD.json",
+        data["branch_path"] + "/STATUS.json",
+        data["branch_path"] + "/LOADED_REFS.json",
+    ]
+    source_refs.extend(diffs)
+    source_refs.extend(validations)
+
+    return {
+        "schema_id": "ion.context_settlement.inbox_packet.v1",
+        "packet_id": packet_id,
+        "created_at": _now(),
+        "status": "CANDIDATE_PENDING_SETTLEMENT",
+        "source_type": "agent_branch_task_return",
+        "domain": "context_settlement",
+        "risk_class": "branch_material_work_candidate",
+        "source_refs": source_refs,
+        "requested_outcome": requested_outcome,
+        "reason": result_summary,
+        "branch_identity": branch_identity,
+        "requested_write_scope": list(requested_scope),
+        "material_work_guard": {
+            "schema_id": preflight_result.get("schema_id"),
+            "ok": preflight_result.get("ok"),
+            "verdict": preflight_result.get("verdict"),
+            "branch_record_path": preflight_result.get("branch_record_path"),
+            "branch_identity": preflight_result.get("branch_identity"),
+            "requested_write_scope": preflight_result.get("requested_write_scope") or [],
+            "findings": preflight_result.get("findings") or [],
+        },
+        "workload_diff": {
+            "present": bool(diffs or touched),
+            "touched_paths": list(touched),
+            "diff_refs": list(diffs),
+            "validation_refs": list(validations),
+        },
+        "acceptance_gates": [
+            "branch identity fields are complete",
+            "material-work preflight guard evidence is present and accepted",
+            "requested write scope is declared in the branch",
+            "workload diff is present",
+            "no shared context surfaces are written directly",
+            "no agent-assigned C-number is present",
+            "context settler performs final merge/promotion decision",
+        ],
+        "non_claims": [
+            "This packet does not update shared Capsule/Mini/HOT_CONTEXT/STATUS/ROUTE.",
+            "This packet does not assign a C-number.",
+            "This packet does not promote branch output to accepted state.",
+            "This packet does not grant production or live execution authority.",
+        ],
+        "authority": {
+            "production_authority": False,
+            "live_execution_authority": False,
+            "secrets_authority": False,
+            "browser_control_authority": False,
+        },
+    }
+
+
+def _settlement_packet_material(packet: dict[str, Any]) -> bool:
+    source_type = packet.get("source_type")
+    return (
+        source_type in MATERIAL_SETTLEMENT_SOURCE_TYPES
+        or bool(packet.get("requested_write_scope"))
+        or bool(packet.get("workload_diff"))
+    )
