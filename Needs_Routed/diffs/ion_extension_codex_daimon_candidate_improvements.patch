+  if (!selected) {
+    setBridgeStatus("Selected request start cancelled", "No request id or path was provided.", "idle");
+    return;
+  }
+  const payload = selected.includes("/") || selected.endsWith(".json")
+    ? { request_path: selected, selected_request: selected }
+    : { request_id: selected, selected_request: selected };
+  setBridgeStatus("Agent start selected", `Requesting approval to start selected request: ${selected}`, "working");
+  chrome.runtime.sendMessage({ type: "ion_chatops_agent_start_selected", payload }, async (response) => {
+    const detail = response?.ok ? compactJson(response.result) : blockedDetail(response);
+    setBridgeAgentDetail(detail);
+    setBridgeStatus(response?.ok ? "Selected request start submitted" : "Selected request start blocked", detail.split("\n")[0] ?? "", response?.ok ? "success" : "error");
+    if (response?.ok) await copyBridgeResult("Agent start selected", detail);
+  });
