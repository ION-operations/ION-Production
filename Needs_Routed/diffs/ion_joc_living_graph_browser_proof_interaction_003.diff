+def _maybe_float(value: Any) -> float | None:
+    if isinstance(value, bool):
+        return None
+    if isinstance(value, (int, float)):
+        return float(value)
+    return None
+
+
+def _screen_point_from_position(position: dict[str, Any], *, index: int = 0, count: int = 1) -> dict[str, float]:
+    """Project abstract x/z world coordinates into the current SVG cockpit viewport.
+
+    The projection intentionally mirrors the React workbench's first-pass map math,
+    so static proof, keyboard fixture plans, and browser screenshots can compare the
+    same spatial contract without claiming a live R3F render yet.
+    """
+
+    x = _maybe_float(position.get("x"))
+    z = _maybe_float(position.get("z"))
+    if x is not None and z is not None:
+        return {"x": 430 + x * 34, "y": 260 + z * 28}
+    angle = (6.283185307179586 * index / max(count, 1)) - 1.5707963267948966
+    # Keep the fallback deterministic without importing math just for a rare path.
+    # Cos/sin approximations are not needed for source-backed graph fixtures because
+    # every mounted node has a position; fallback keeps empty/custom packets stable.
+    fallback_x = 430 + ((index % 12) - 6) * 58
+    fallback_y = 260 + ((index // 12) - 2) * 44
+    return {"x": float(fallback_x), "y": float(fallback_y)}
+
+
+def _screen_polygon(points: list[Any]) -> list[dict[str, float]]:
+    projected: list[dict[str, float]] = []
+    for index, point in enumerate(points):
+        if isinstance(point, dict):
+            projected.append(_screen_point_from_position(point, index=index, count=len(points)))
+    return projected
+
