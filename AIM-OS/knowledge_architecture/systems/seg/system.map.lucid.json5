        "conflict_resolutions",
        "evidence_recommendations",
        "knowledge_patterns",
      ],
      security_level: "high",
      implementation: "packages/seg/apoe_integration.py",
      status: "complete",
    },
    {
      portId: "sdfcvfIntegration",
      direction: "bidirectional",
      connectsToSystem: "sdfcvf.atomicEvolution",
      protocol: "internal_api",
      whatIsExchanged: [
        "evolution_evidence",
        "consistency_validation",
        "change_impact_analysis",
        "synthesis_updates",
      ],
      security_level: "high",
      implementation: "packages/seg/sdfcvf_integration.py",
      status: "complete",
    },
    {
      portId: "casIntegration",
      direction: "bidirectional",
      connectsToSystem: "cas.cognitiveAnalysis",
      protocol: "internal_api",
      whatIsExchanged: [
        "failure_patterns",
        "cognitive_errors",
        "pattern_analysis",
        "evidence_validation",
      ],
      security_level: "high",
