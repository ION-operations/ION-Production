  data_flow: {
    primary_flow: [
      {
        step: 1,
        component: "policy_engine",
        action: "Enforce policies",
        input: [
          "governance_requests",
          "policy_rules",
        ],
        output: [
          "policy_enforcement",
          "policy_status",
        ],
      },
      {
        step: 2,
        component: "decision_engine",
        action: "Make governance decisions",
        input: [
          "governance_requests",
          "decision_rules",
        ],
        output: [
          "governance_decisions",
          "decision_rationale",
        ],
      },
      {
        step: 3,
        component: "approval_workflow",
        action: "Process approval workflows",
        input: [
          "governance_decisions",
          "workflow_rules",
        ],
        output: [
          "approval_status",
          "workflow_events",
        ],
      },
      {
        step: 4,
        component: "compliance_monitor",
        action: "Monitor compliance",
        input: [
          "governance_decisions",
          "compliance_rules",
        ],
        output: [
          "compliance_status",
          "compliance_reports",
        ],
      },
      {
        step: 5,
        component: "governance_engine",
        action: "Coordinate governance",
        input: [
          "policy_enforcement",
          "governance_decisions",
        ],
        output: [
          "governance_decisions",
          "policy_enforcement",
        ],
      },
    ],
    secondary_flows: [
      {
        flow_name: "policy_enforcement",
