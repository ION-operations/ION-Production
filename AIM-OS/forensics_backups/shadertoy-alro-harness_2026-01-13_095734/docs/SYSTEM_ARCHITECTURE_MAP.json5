{
  // Shadertoy al-ro Clouds Harness (WebGL2) — System Architecture Map (S.A.M.)
  // Generated: 2026-01-13
  // Enhanced: 2026-01-13 (Complete detail mapping)
  // Purpose: Unambiguous architecture + dataflow map for the multi-buffer Shadertoy harness.
  // Status: Production-ready reference implementation

  systemId: "shadertoy-alro-harness",
  systemName: "Shadertoy al-ro Clouds Harness (WebGL2)",
  version: "0.1.0",
  status: "development",
  layer: 4, // Application example / reference harness

  description:
    "A no-deps WebGL2 harness that runs the original multi-buffer Shadertoy shader pipeline (BufferA + BufferB + Image) plus optional post passes (TAA accumulation + God Rays).",

  purpose: [
    "Keep a Shadertoy-quality correctness reference runnable locally.",
    "Provide a developer sandbox for tuning: render scale, fast mode while dragging, temporal accumulation, lighting day/night, god rays.",
    "Serve as a bridge from reference shader -> production volumetrics plan (engine architecture + settings ergonomics).",
  ],

  entrypoints: [
    { file: "index.html", role: "ui_shell", notes: "Canvas + right-side tab overlay (icon bar + panels)." },
    { file: "main.js", role: "orchestrator", notes: "WebGL init, shader compilation, render loop, settings, camera model." },
  ],

  dependencies: [
    { name: "WebGL2", type: "browser_api", required: true, purpose: "All rendering + feedback buffers." },
    {
      name: "EXT_color_buffer_float",
      type: "webgl_extension",
      required: true,
      purpose: "HDR render targets for accumulation and high quality sampling.",
    },
    { name: "Fetch API", type: "browser_api", required: true, purpose: "Load `shaders/*.glsl` at runtime." },
    { name: "requestAnimationFrame", type: "browser_api", required: true, purpose: "Frame loop scheduling." },
    { name: "Clipboard API", type: "browser_api", required: false, purpose: "Copy share URL from Settings." },
  ],

  internalNodes: [
    {
      nodeId: "ui_tabs",
      name: "Right-side Tabs UI",
      type: "ui_shell",
      file: "index.html",
      responsibilities: [
        "Render overlay shell",
        "Provide icon tab bar + scrollable panel container",
        "Collapse/expand panel body",
        "Display settings readout and error messages",
